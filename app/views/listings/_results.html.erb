<% frame_id = local_assigns.fetch(:frame_id, "listing_results") %>
<% compact = local_assigns.fetch(:compact, false) %>

<turbo-frame id="<%= frame_id %>">
  <div class="grid gap-6 lg:grid-cols-[17rem_minmax(0,1fr)]" data-controller="filters">
    <aside class="hidden lg:block" aria-label="<%= t("search.filters.title") %>">
      <div class="sticky top-28 max-h-[calc(100dvh-8rem)] overflow-y-auto pb-4 pr-1 scrollbar-hide">
        <%= render "listings/filters", search: @search, result: @result, prefix: "desktop",
                   frame_id: frame_id, compact: compact %>
      </div>
    </aside>

    <section class="min-w-0" data-controller="modal view_toggle">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <button type="button" data-action="modal#open"
                  class="<%= ui_button_classes(variant: :outline, size: :sm, extra: "lg:hidden") %>">
            <%= icon "sliders-horizontal", class: "size-4" %>
            <%= t("search.filters.mobile_button", count: @result.active_filters.size) %>
          </button>
          <p class="text-sm font-semibold text-slate-700 dark:text-zinc-200" aria-live="polite">
            <%= listing_results_count(@result) %>
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-2">
          <%= form_with url: request.path, method: :get,
                        data: { turbo_frame: frame_id, turbo_action: "advance" },
                        class: "flex min-w-0 items-center gap-2" do %>
            <%= hidden_search_fields(@search.query_params, except: :sort) %>
            <label for="<%= frame_id %>-sort" class="hidden text-xs font-medium text-slate-500 sm:inline dark:text-zinc-400">
              <%= t("search.sort.label") %>
            </label>
            <%= select_tag :sort, options_for_select(sort_options, @search.sort),
                           id: "#{frame_id}-sort",
                           class: ui_input_classes("!min-h-9 !w-auto !rounded-full !py-1 text-xs"),
                           data: { action: "change->filters#submit" } %>
          <% end %>

          <% if user_signed_in? %>
            <%= form_with url: saved_searches_path, method: :post, data: { turbo: false },
                          class: "block" do %>
              <% saved_search_link_params(@search).each do |key, value| %>
                <%= hidden_field_tag key, value, id: nil if value.present? %>
              <% end %>
              <%= submit_tag t("search.save_search"),
                             class: ui_button_classes(variant: :outline, size: :sm) %>
            <% end %>
          <% else %>
            <%= link_to t("search.save_search"), new_user_session_path,
                        data: { turbo_frame: "auth-modal" },
                        class: ui_button_classes(variant: :outline, size: :sm) %>
          <% end %>

          <div class="hidden items-center gap-1 rounded-full border border-slate-200 p-1 sm:flex dark:border-zinc-700">
            <button type="button" data-action="view_toggle#grid" data-view-toggle-target="gridButton"
                    class="inline-flex size-8 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800"
                    aria-label="<%= t("search.view.grid") %>">
              <%= icon "layout-grid", class: "size-4" %>
            </button>
            <button type="button" data-action="view_toggle#list" data-view-toggle-target="listButton"
                    class="inline-flex size-8 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800"
                    aria-label="<%= t("search.view.list") %>">
              <%= icon "menu", class: "size-4" %>
            </button>
          </div>
        </div>
      </div>

      <% if @result.active_filters.any? %>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <% @result.active_filters.each do |filter| %>
            <%= link_to search_path_with(filter.remove_params),
                        class: ui_chip_classes(extra: "!bg-slate-50 dark:!bg-zinc-900") do %>
              <span class="max-w-56 truncate"><%= filter.label %></span>
              <%= icon "x", class: "size-3.5" %>
            <% end %>
          <% end %>
          <%= link_to t("search.filters.clear_all"), request.path,
                      class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
        </div>
      <% end %>

      <div class="mt-4 hidden" data-filters-target="skeleton" aria-hidden="true">
        <div class="grid grid-cols-1 gap-3 min-[360px]:grid-cols-2 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
          <% 8.times do %>
            <div class="surface overflow-hidden">
              <div class="skeleton aspect-[4/3] rounded-none"></div>
              <div class="space-y-3 p-4">
                <div class="skeleton h-4 w-3/4"></div>
                <div class="skeleton h-4 w-1/2"></div>
                <div class="skeleton h-6 w-1/3"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <% if @listings.any? %>
        <div id="listing-grid" data-view-toggle-target="container"
             class="mt-4 grid grid-cols-1 gap-3 min-[360px]:grid-cols-2 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
          <% @listings.each do |listing| %>
            <%= render "listings/card", listing: listing,
                       favorited: @favorited_listing_ids.include?(listing.id),
                       favorite_id: @favorite_ids_by_listing&.[](listing.id) %>
          <% end %>
        </div>

        <%= render "shared/pagination", pagy: @pagy, frame: frame_id %>
      <% else %>
        <div class="surface mt-4">
          <%= render "shared/empty_state",
                     title: t("search.results.empty_title"),
                     body: t("search.results.empty_body"),
                     cta_label: t("search.results.clear_filters"),
                     cta_path: request.path %>
          <div class="border-t border-slate-200 px-6 py-5 dark:border-zinc-800">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500">
              <%= t("search.results.try_title") %>
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <% Category.roots_ordered.active.limit(6).each do |category| %>
                <%= link_to category.name, category_path(path: category.path_slugs),
                            class: ui_chip_classes %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <dialog id="<%= frame_id %>-filters-sheet" data-controller="modal"
              data-action="click->modal#backdropClose"
              class="m-0 h-[92dvh] w-full max-w-none self-end rounded-t-2xl border-0 bg-white p-0 text-slate-900 shadow-[var(--shadow-panel)] sm:m-auto sm:h-[85dvh] sm:max-w-lg sm:rounded-2xl dark:bg-zinc-950 dark:text-zinc-100">
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-zinc-800">
            <h2 class="font-heading text-lg font-semibold"><%= t("search.filters.title") %></h2>
            <button type="button" data-action="modal#close"
                    class="inline-flex size-10 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
                    aria-label="<%= t("search.filters.close") %>">
              <%= icon "x", class: "size-5" %>
            </button>
          </div>
          <div class="flex-1 overflow-y-auto px-5 py-4">
            <%= render "listings/filters", search: @search, result: @result, prefix: "mobile",
                       frame_id: frame_id, compact: compact, submit_label: t("search.filters.show_results", count: @result.total_count) %>
          </div>
        </div>
      </dialog>
    </section>
  </div>
</turbo-frame>
