<% cache [listing, I18n.locale, "card"] do %>
  <article class="card relative flex flex-col overflow-hidden transition-shadow hover:shadow-md">
    <%= link_to listing_path(listing), class: "relative block aspect-square overflow-hidden bg-cream-100 dark:bg-cream-surface", tabindex: "-1" do %>
      <%= listing_picture(listing) %>
      <% if (label = listing.product_labels.to_a.first) %>
        <span class="absolute left-2 top-2 max-w-[70%] truncate rounded-full bg-primary-600 px-2.5 py-1 text-xs font-bold text-white shadow-sm"><%= label.name %></span>
      <% end %>
      <% if (discount = listing.discount_percent) %>
        <span class="absolute bottom-2 left-2 rounded-full bg-cream-500 px-2.5 py-1 text-xs font-extrabold text-primary-950 shadow-sm" title="<%= t(".save_badge", count: discount) %>">-<%= discount %>%</span>
      <% end %>
    <% end %>

    <%# Placeholder until the wishlist phase wires this up. %>
    <button type="button" class="absolute right-2 top-2 rounded-full bg-surface/90 p-2 text-muted shadow-sm backdrop-blur transition-colors hover:text-primary-600 dark:bg-surface/80"
            data-controller="wishlist" data-action="wishlist#toggle" aria-pressed="false"
            aria-label="<%= t(".add_to_wishlist") %>">
      <%= icon "heart", class: "h-4 w-4" %>
    </button>

    <div class="flex flex-1 flex-col gap-1 p-3">
      <%= link_to listing.title, listing_path(listing),
            class: "line-clamp-2 text-sm font-semibold leading-snug hover:text-primary-700 dark:hover:text-primary-300" %>
      <div class="flex flex-wrap items-baseline gap-x-2">
        <span class="text-lg font-bold tracking-tight"><%= listing.display_price %></span>
        <% if (original = listing.display_original_price) %>
          <span class="text-xs text-muted line-through"><%= original %></span>
        <% end %>
      </div>
      <p class="flex items-center gap-1 text-xs text-muted">
        <span class="truncate"><%= listing.store.display_name %></span>
        <% if listing.store.verified? %>
          <span class="shrink-0 text-primary-600 dark:text-primary-400" title="<%= t(".verified_seller") %>"><%= icon "verified", class: "h-3.5 w-3.5" %></span>
        <% end %>
      </p>
      <% if (chips = spec_chip_labels(listing)).any? %>
        <div class="mt-1 flex flex-wrap gap-1">
          <% chips.each do |chip| %>
            <span class="rounded-full border border-line bg-cream-100 px-2 py-0.5 text-[11px] font-medium text-muted dark:bg-cream-surface"><%= chip %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </article>
<% end %>
