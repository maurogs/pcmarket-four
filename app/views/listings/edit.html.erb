<div class="page-container py-6 sm:py-10">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300"><%= t("listings.form.sell_label") %></p>
      <h1 class="mt-1 font-heading text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl dark:text-white"><%= t("listings.form.edit_title") %></h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-zinc-400"><%= t("listings.form.edit_subtitle") %></p>
    </div>
    <%= link_to listing_path(@listing), class: ui_button_classes(variant: :outline, size: :sm) do %>
      <%= icon "eye", class: "size-4" %><%= t("listings.form.view_listing") %>
    <% end %>
  </div>

  <%= render "form", listing: @listing %>
</div>
