<% content_for :title, t("pages.listings.index_title") %>

<div class="page-container py-8 sm:py-10">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("pages.listings.index_title") %></h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-zinc-400"><%= t("pages.listings.index_body") %></p>
      <% if params[:q].present? %>
        <p class="mt-2 text-sm font-medium text-brand-700 dark:text-brand-300">
          <%= icon "search", class: "mr-1 inline size-4" %><%= params[:q] %>
        </p>
      <% end %>
    </div>
    <%= link_to new_listing_path, class: ui_button_classes(variant: :primary, size: :md) do %>
      <%= icon "plus", class: "size-4" %><%= t("layout.header.list_item") %>
    <% end %>
  </div>

  <% if @listings.any? %>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <% @listings.each do |listing| %>
        <%= render "listings/card", listing: listing %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state", title: t("home.empty.title"), body: t("home.empty.body"),
               cta_label: t("home.hero.empty_cta"), cta_path: root_path %>
  <% end %>
</div>
