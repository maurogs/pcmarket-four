<% content_for :head do %>
  <% Array(@pagination_links).each do |link| %>
    <%= link %>
  <% end %>
  <% if @search_json_ld.present? %>
    <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>"><%= @search_json_ld %></script>
  <% end %>
<% end %>

<div class="page-container py-6 sm:py-8">
  <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-zinc-400"
       aria-label="<%= t("search.breadcrumb_label") %>">
    <%= link_to t("layout.tab_bar.home"), root_path, class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <% if @category %>
      <% @search.category_ancestors[0...-1].each_with_index do |category, index| %>
        <span aria-hidden="true">/</span>
        <%= link_to category.name, category_path(path: @search.category_ancestors.first(index + 1).map(&:slug)),
                    class: "hover:text-brand-700 dark:hover:text-brand-300" %>
      <% end %>
      <span aria-hidden="true">/</span>
      <span class="truncate text-slate-700 dark:text-zinc-200"><%= @category.name %></span>
    <% else %>
      <span aria-hidden="true">/</span>
      <span class="truncate text-slate-700 dark:text-zinc-200">
        <%= @search.query.present? ? @search.query : t("search.meta.title") %>
      </span>
    <% end %>
  </nav>

  <% if @category %>
    <header class="surface relative overflow-hidden p-5 sm:p-7">
      <div class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-brand-100/70 blur-3xl dark:bg-brand-900/30"></div>
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2">
          <span class="<%= ui_badge_classes(tone: :brand) %>"><%= t("search.category.badge") %></span>
          <span class="text-xs font-medium text-slate-500 dark:text-zinc-400">
            <%= listing_results_count(@result) %>
          </span>
        </div>
        <h1 class="mt-3 font-heading text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
          <%= @category.name %>
        </h1>
        <% description = @category.seo_descriptions[I18n.locale.to_s].presence ||
                         @category.seo_descriptions["es"].presence ||
                         t("search.meta.category_description", category: @category.name) %>
        <p class="mt-2 max-w-3xl text-sm text-slate-600 dark:text-zinc-400"><%= description %></p>

        <% children = @search.child_categories %>
        <% if children.any? %>
          <nav class="mt-5 flex flex-wrap gap-2" aria-label="<%= t("search.category.browse_children") %>">
            <% children.each do |child| %>
              <%= link_to category_path(path: @search.category_ancestors.map(&:slug) + [ child.slug ]),
                          class: ui_chip_classes do %>
                <%= child.name %>
                <span class="text-xs text-slate-400 dark:text-zinc-500"><%= child.listings_count %></span>
              <% end %>
            <% end %>
          </nav>
        <% end %>

        <% if @search.category_ancestors.any? { |item| item.slug.in?(%w[gaming-pcs gpus]) } %>
          <nav class="mt-5 flex flex-wrap items-center gap-2" aria-label="<%= t("search.labels_tabs") %>">
            <%= link_to t("search.category.all_listings"),
                        search_path_with(@search.query_params.except("labels")),
                        class: ui_chip_classes(active: @result.labels.empty?) %>
            <% %w[value mid_range pro_gamer].each do |label| %>
              <%= link_to t("listings.labels.#{label}"),
                          search_path_with(@search.query_params.merge("labels" => [ label ])),
                          class: ui_chip_classes(active: @result.labels == [ label ]) %>
            <% end %>
          </nav>
        <% end %>
      </div>
    </header>
  <% else %>
    <header class="mb-2">
      <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white">
        <% if @search.query.present? %>
          <%= t("search.results.title_query", query: @search.query) %>
        <% else %>
          <%= t("search.results.title") %>
        <% end %>
      </h1>
      <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("search.results.subtitle") %></p>
    </header>
  <% end %>

  <div class="mt-6">
    <%= render "listings/results" %>
  </div>

  <% if @category %>
    <section class="mt-12 border-t border-slate-200 pt-8 dark:border-zinc-800">
      <h2 class="font-heading text-lg font-semibold text-slate-950 dark:text-white">
        <%= t("search.seo.footer_title", category: @category.name) %>
      </h2>
      <p class="mt-2 max-w-4xl text-sm leading-7 text-slate-600 dark:text-zinc-400">
        <%= t("search.seo.footer_body", category: @category.name) %>
      </p>
    </section>
  <% end %>
</div>
