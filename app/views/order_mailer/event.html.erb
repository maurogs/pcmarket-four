<h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#0f172a;"><%= @heading %></h1>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#334155;">
  <%= t("orders.mailer.greeting", name: @recipient_name) %>
</p>

<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#334155;"><%= @intro %></p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e2e8f0;border-radius:12px;border-collapse:separate;overflow:hidden;">
  <tr>
    <td style="padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;"><%= t("orders.mailer.order_number") %></td>
    <td style="padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;font-weight:600;color:#0f172a;text-align:right;"><%= @order.number %></td>
  </tr>
  <tr>
    <td style="padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;"><%= t("orders.mailer.store") %></td>
    <td style="padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;font-weight:600;color:#0f172a;text-align:right;"><%= @order.store&.name || @order.seller.display_name %></td>
  </tr>
  <% @order.order_items.each do |item| %>
    <tr>
      <td style="padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#334155;" colspan="2">
        <%= item.title_snapshot %> × <%= item.quantity %>
        <span style="float:right;font-weight:600;color:#0f172a;"><%= format_price(item.subtotal_cents) %></span>
      </td>
    </tr>
  <% end %>
  <tr>
    <td style="padding:14px 16px;font-size:14px;font-weight:700;color:#0f172a;"><%= t("orders.mailer.total") %></td>
    <td style="padding:14px 16px;font-size:14px;font-weight:700;color:#0f172a;text-align:right;"><%= format_price(@order.total_cents) %></td>
  </tr>
</table>

<% if @order.tracking_number.present? %>
  <p style="margin:0 0 8px;font-size:13px;color:#64748b;"><%= t("orders.mailer.tracking_label") %></p>
  <p style="margin:0 0 20px;font-size:15px;color:#0f172a;">
    <strong><%= @order.carrier.presence && t("orders.carriers.#{@order.carrier}", default: @order.carrier) %>:</strong>
    <% if @tracking_url.present? %>
      <a href="<%= @tracking_url %>" style="color:#0f766e;"><%= @order.tracking_number %></a>
    <% else %>
      <%= @order.tracking_number %>
    <% end %>
  </p>
<% end %>

<% if @cta_url.present? && @cta_label.present? %>
  <p style="margin:0 0 20px;">
    <a href="<%= @cta_url %>" style="display:inline-block;border-radius:9999px;background:#0f766e;padding:12px 22px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;"><%= @cta_label %></a>
  </p>
<% end %>

<p style="margin:0;font-size:13px;line-height:1.6;color:#64748b;"><%= t("orders.mailer.signature", site: site_name) %></p>
