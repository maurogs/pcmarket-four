<% content_for :title, t("sell_to_us.offer.title", item: @offer.item_name) %>

<%= render "sell_offers/preview_banner" if @preview_mode %>

<div class="page-container py-10 sm:py-14">
  <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-zinc-400">
    <%= link_to t("sell_to_us.quote.breadcrumb"), sell_to_us_path, class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <span aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-zinc-200"><%= @offer.item_name %></span>
  </nav>

  <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start">
    <div class="surface p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="<%= ui_badge_classes(tone: @offer.status.in?(%w[paid received accepted]) ? :success : (@offer.status.in?(%w[rejected declined expired]) ? :danger : :brand)) %>">
            <%= t("sell_to_us.statuses.#{@offer.status}") %>
          </span>
          <h1 class="mt-3 font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= @offer.item_name %></h1>
          <p class="mt-1 text-sm text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.kinds.#{@offer.item_kind}") %> · <%= t("sell_to_us.conditions.#{@offer.condition_label_key}") %></p>
        </div>
        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.your_price") %></p>
          <p class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white"><%= format_price(@offer.offered_price_cents) %></p>
        </div>
      </div>

      <dl class="mt-6 grid gap-3 border-t border-slate-200 pt-5 text-sm sm:grid-cols-2 dark:border-zinc-800">
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.requested_on") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= l(@offer.created_at, format: :long) %></dd>
        </div>
        <% if @offer.offer_expires_at.present? && @offer.offered? %>
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.expires_on") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= l(@offer.offer_expires_at, format: :long) %></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.form.original_box") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @offer.original_box? ? t("common.yes") : t("common.no") %></dd>
        </div>
        <% if @offer.accessories.present? %>
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.form.accessories") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @offer.accessories %></dd>
          </div>
        <% end %>
        <% if @offer.payout_iban.present? %>
          <div class="sm:col-span-2">
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.payout_account") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @offer.payout_account_name %> · IBAN ••••<%= @offer.payout_iban.last(4) %></dd>
          </div>
        <% end %>
      </dl>

      <% if @offer.admin_notes.present? && @offer.status.in?(%w[received paid rejected]) %>
        <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700 dark:border-zinc-800 dark:bg-zinc-800/40 dark:text-zinc-300">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.notes") %></p>
          <p class="mt-1"><%= @offer.admin_notes %></p>
        </div>
      <% end %>

      <% if @offer.accepted? || @offer.received? %>
        <div class="mt-5 rounded-xl border border-brand-200 bg-brand-50/60 p-4 dark:border-brand-800 dark:bg-brand-950/30">
          <h2 class="text-sm font-semibold text-brand-900 dark:text-brand-200"><%= t("sell_to_us.offer.shipping_title") %></h2>
          <p class="mt-1 text-sm leading-6 text-brand-800 dark:text-brand-300"><%= t("sell_to_us.offer.shipping_body") %></p>
        </div>
      <% end %>

      <% if @offer.paid? %>
        <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-200">
          <%= t("sell_to_us.offer.paid_body") %>
        </div>
      <% end %>
    </div>

    <aside class="space-y-4">
      <% if @offer.acceptable? %>
        <div class="surface p-5">
          <h2 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("sell_to_us.offer.accept_title") %></h2>
          <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.accept_body") %></p>

          <%= form_with url: sell_offer_acceptance_path(@offer), method: :post, class: "mt-4 space-y-3" do %>
            <div>
              <label for="payout_iban" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-200"><%= t("sell_to_us.offer.iban") %></label>
              <input type="text" id="payout_iban" name="payout_iban" required autocomplete="off"
                     placeholder="ES00 0000 0000 0000 0000 0000"
                     class="<%= ui_input_classes("font-mono uppercase") %>">
              <p class="mt-1 text-[11px] text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.iban_hint") %></p>
            </div>
            <div>
              <label for="payout_account_name" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-200"><%= t("sell_to_us.offer.account_name") %></label>
              <input type="text" id="payout_account_name" name="payout_account_name" required
                     value="<%= @offer.user.name %>"
                     class="<%= ui_input_classes %>">
            </div>
            <%= submit_tag t("sell_to_us.offer.accept_cta"), class: ui_button_classes(variant: :primary, size: :md, extra: "w-full") %>
          <% end %>

          <%= button_to t("sell_to_us.offer.decline_cta"), sell_offer_decline_path(@offer),
                        method: :post, class: ui_button_classes(variant: :ghost, size: :md, extra: "mt-2 w-full") %>
        </div>
      <% end %>

      <div class="surface p-5">
        <h2 class="font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("sell_to_us.offer.timeline_title") %></h2>
        <ol class="mt-3 space-y-3">
          <% %i[offered accepted received paid].each do |stage| %>
            <% reached = { "offered" => %w[offered accepted received paid], "accepted" => %w[accepted received paid],
                           "received" => %w[received paid], "paid" => %w[paid] }.fetch(stage.to_s).include?(@offer.status) %>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full <%= reached ? 'bg-brand-700 text-white' : 'bg-slate-100 text-slate-400 dark:bg-zinc-800 dark:text-zinc-500' %>">
                <%= icon "check", class: "size-3.5" %>
              </span>
              <span>
                <span class="block text-sm font-medium <%= reached ? 'text-slate-900 dark:text-white' : 'text-slate-500 dark:text-zinc-400' %>"><%= t("sell_to_us.offer.timeline.#{stage}") %></span>
              </span>
            </li>
          <% end %>
        </ol>
        <% if @offer.status.in?(%w[rejected declined expired]) %>
          <p class="mt-3 rounded-lg bg-slate-50 p-3 text-xs text-slate-600 dark:bg-zinc-800/50 dark:text-zinc-400"><%= t("sell_to_us.offer.closed_body") %></p>
        <% end %>
      </div>

      <%= link_to t("sell_to_us.offer.back"), sell_to_us_path, class: ui_button_classes(variant: :outline, size: :md, extra: "w-full") %>
    </aside>
  </div>
</div>
