<% content_for :title, @article.title %>
<% breadcrumbs = [
  { name: t("layout.tab_bar.home"), url: root_url(locale: I18n.locale) },
  { name: t("content.help.index.title"), url: help_articles_url(locale: I18n.locale) },
  { name: @article.title, url: help_article_url(@article.slug, locale: I18n.locale) }
] %>

<script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
  <%= {
    "@context" => "https://schema.org",
    "@type" => "Article",
    "headline" => @article.title,
    "description" => strip_tags(@article.body_html).squish.first(200),
    "inLanguage" => I18n.locale.to_s,
    "datePublished" => @article.created_at.iso8601,
    "dateModified" => @article.updated_at.iso8601,
    "author" => { "@type" => "Organization", "name" => site_name },
    "publisher" => { "@type" => "Organization", "name" => site_name },
    "mainEntityOfPage" => help_article_url(@article.slug, locale: I18n.locale)
  }.to_json.html_safe %>
</script>
<script type="application/ld+json" nonce="<%= content_security_policy_nonce %>"><%= breadcrumb_json_ld(breadcrumbs).to_json.html_safe %></script>

<div class="page-container py-8 sm:py-12">
  <nav class="mb-5 text-xs text-slate-500 dark:text-zinc-400" aria-label="<%= t("content.help.show.breadcrumb") %>">
    <%= link_to t("layout.tab_bar.home"), root_path, class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <span class="mx-1">/</span>
    <%= link_to t("content.help.index.title"), help_articles_path, class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <span class="mx-1">/</span>
    <%= link_to t("content.help.categories.#{@article.category}"), help_articles_path(category: @article.category), class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <span class="mx-1">/</span>
    <span class="text-slate-700 dark:text-zinc-300"><%= @article.title %></span>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <article class="surface p-6 sm:p-10">
      <span class="<%= ui_badge_classes(tone: :brand) %>"><%= t("content.help.categories.#{@article.category}") %></span>
      <h1 class="mt-4 font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white"><%= @article.title %></h1>
      <p class="mt-2 text-xs text-slate-500 dark:text-zinc-500"><%= t("content.help.show.updated", date: l(@article.updated_at.to_date, format: :long)) %></p>

      <div class="prose-pcm mt-8">
        <%= @article.body_html %>
      </div>

      <section id="feedback" class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-zinc-800 dark:bg-zinc-900/60" aria-labelledby="feedback-title">
        <h2 id="feedback-title" class="font-heading text-base font-semibold text-slate-900 dark:text-white"><%= t("content.help.feedback.title") %></h2>
        <% if @feedback %>
          <p class="mt-2 text-sm text-slate-600 dark:text-zinc-400">
            <%= @feedback.helpful? ? t("content.help.feedback.recorded_yes") : t("content.help.feedback.recorded_no") %>
          </p>
        <% else %>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= button_to t("content.help.feedback.yes"), help_article_feedback_path(help_article_slug: @article.slug),
                          params: { helpful: "yes" },
                          class: ui_button_classes(variant: :outline, size: :sm) %>
            <%= button_to t("content.help.feedback.no"), help_article_feedback_path(help_article_slug: @article.slug),
                          params: { helpful: "no" },
                          class: ui_button_classes(variant: :ghost, size: :sm) %>
          </div>
        <% end %>
      </section>
    </article>

    <aside class="space-y-6">
      <% if @related.any? %>
        <section class="surface p-5" aria-labelledby="related-title">
          <h2 id="related-title" class="font-heading text-base font-semibold text-slate-900 dark:text-white"><%= t("content.help.show.related_title") %></h2>
          <ul class="mt-3 space-y-2">
            <% @related.each do |article| %>
              <li>
                <%= link_to article.title, help_article_path(article.slug),
                            class: "text-sm font-medium text-brand-700 hover:underline dark:text-brand-300" %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="surface p-5" aria-labelledby="help-contact-title">
        <h2 id="help-contact-title" class="font-heading text-base font-semibold text-slate-900 dark:text-white"><%= t("content.help.show.contact_title") %></h2>
        <p class="mt-2 text-xs leading-6 text-slate-600 dark:text-zinc-400"><%= t("content.help.show.contact_body") %></p>
        <%= link_to t("content.help.index.title"), help_articles_path(anchor: "contact"),
                    class: ui_button_classes(variant: :outline, size: :sm, extra: "mt-3") %>
      </section>
    </aside>
  </div>
</div>
