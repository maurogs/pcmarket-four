<% content_for :title, t("content.help.index.title") %>

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 via-white to-white dark:border-zinc-800 dark:from-brand-950/40 dark:via-zinc-950 dark:to-zinc-950">
  <div class="page-container py-12 sm:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <span class="<%= ui_badge_classes(tone: :brand) %>"><%= icon "message-circle", class: "size-3.5" %><%= t("content.help.index.eyebrow") %></span>
      <h1 class="section-heading mt-4"><%= t("content.help.index.title") %></h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.help.index.body") %></p>

      <%= form_with url: help_articles_path, method: :get, class: "mx-auto mt-6 flex max-w-xl gap-2", role: "search" do |form| %>
        <div class="relative flex-1">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= icon "search", class: "size-4" %></span>
          <%= form.search_field :q, value: @query, placeholder: t("content.help.index.search_placeholder"),
                                "aria-label": t("content.help.index.search_placeholder"),
                                class: ui_input_classes("rounded-full !pl-9") %>
        </div>
        <%= form.submit t("content.help.index.search"), class: ui_button_classes(variant: :primary, size: :md) %>
      <% end %>

      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <% HelpArticle::CATEGORIES.each do |category| %>
          <%= link_to t("content.help.categories.#{category}"), help_articles_path(category: category),
                      class: ui_chip_classes(active: @category == category) %>
        <% end %>
        <% if @category.present? %>
          <%= link_to t("content.help.index.clear"), help_articles_path, class: ui_chip_classes %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="page-container py-10 sm:py-12" aria-labelledby="help-categories-title">
  <h2 id="help-categories-title" class="section-heading"><%= t("content.help.index.categories_title") %></h2>
  <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% HelpArticle::CATEGORIES.each do |category| %>
      <%= link_to help_articles_path(category: category), class: "surface group flex items-start gap-4 p-5 transition hover:border-brand-300 dark:hover:border-brand-700" do %>
        <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">
          <%= icon help_category_icon(category), class: "size-5" %>
        </span>
        <span class="min-w-0">
          <span class="flex items-center gap-2 text-sm font-semibold text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
            <%= t("content.help.categories.#{category}") %>
            <span class="<%= ui_badge_classes(tone: :neutral, extra: "!px-2 !py-0.5 !text-[10px]") %>"><%= @category_counts[category].to_i %></span>
          </span>
          <span class="mt-1 block text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("content.help.categories.#{category}_hint") %></span>
        </span>
      <% end %>
    <% end %>
  </div>
</section>

<% if @query.present? || @category.present? %>
  <section class="page-container pb-14" aria-labelledby="help-results-title">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="help-results-title" class="section-heading">
        <% if @query.present? %>
          <%= t("content.help.index.results_for", query: @query) %>
        <% else %>
          <%= t("content.help.categories.#{@category}") %>
        <% end %>
      </h2>
      <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("content.help.index.results_count", count: @articles.size) %></p>
    </div>
    <% if @articles.any? %>
      <ul class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
        <% @articles.each do |article| %>
          <li>
            <%= link_to help_article_path(article.slug), class: "block p-5 transition hover:bg-slate-50 dark:hover:bg-zinc-800/50" do %>
              <div class="flex flex-wrap items-center gap-2">
                <span class="<%= ui_badge_classes(tone: :brand, extra: "!px-2 !py-0.5 !text-[10px]") %>"><%= t("content.help.categories.#{article.category}") %></span>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white"><%= article.title %></h3>
              </div>
              <p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500 dark:text-zinc-400">
                <%= strip_tags(article.body_html).squish.truncate(170) %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="surface mt-5 p-8 text-center">
        <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.help.index.no_results_title") %></h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-zinc-400"><%= t("content.help.index.no_results_body") %></p>
        <%= link_to t("content.help.index.clear"), help_articles_path, class: ui_button_classes(variant: :outline, size: :sm, extra: "mt-4") %>
      </div>
    <% end %>
  </section>
<% else %>
  <section class="page-container pb-14" aria-labelledby="help-popular-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div>
        <h2 id="help-popular-title" class="section-heading"><%= t("content.help.index.popular_title") %></h2>
        <ol class="mt-5 space-y-2">
          <% @popular.each_with_index do |article, index| %>
            <li>
              <%= link_to help_article_path(article.slug), class: "surface flex items-center gap-4 p-4 transition hover:border-brand-300 dark:hover:border-brand-700" do %>
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-100 font-heading text-sm font-bold text-slate-600 dark:bg-zinc-800 dark:text-zinc-300"><%= index + 1 %></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white"><%= article.title %></span>
                  <span class="mt-0.5 block text-xs text-slate-500 dark:text-zinc-400"><%= t("content.help.categories.#{article.category}") %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
      <div class="surface p-6" id="contact">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "headset", class: "size-6" %></span>
        <h2 class="mt-3 font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.help.index.contact_title") %></h2>
        <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.help.index.contact_body") %></p>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("content.help.index.contact_email") %></dt>
            <dd class="mt-0.5"><%= mail_to Setting.get("support_email"), class: "font-medium text-brand-700 dark:text-brand-300" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("content.help.index.contact_phone") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= Setting.get("support_phone") %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("content.help.index.contact_hours") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= Setting.get("support_hours") %></dd>
          </div>
        </dl>
        <%= link_to t("content.help.index.contact_cta"), trust_path, class: ui_button_classes(variant: :outline, size: :sm, extra: "mt-5") %>
      </div>
    </div>
  </section>
<% end %>
