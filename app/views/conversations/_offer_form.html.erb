<details class="mb-3 rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-zinc-800 dark:bg-zinc-900/40">
  <summary class="cursor-pointer list-none text-sm font-semibold text-brand-700 dark:text-brand-300 [&::-webkit-details-marker]:hidden">
    <%= t("messaging.offers.make_offer", price: format_price(listing.price_cents)) %>
  </summary>
  <%= form_with url: conversation_offers_path(conversation), method: :post, class: "mt-3 flex flex-wrap items-end gap-2" do %>
    <div class="min-w-0 flex-1">
      <%= label_tag :offer_amount, t("messaging.offers.amount"), class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
      <%= number_field_tag "offer[amount]", nil, step: "0.01", min: "0.01", required: true,
                           class: ui_input_classes("!min-h-9 !py-1.5"),
                           placeholder: t("messaging.offers.amount_placeholder") %>
    </div>
    <%= submit_tag t("messaging.offers.submit"), class: ui_button_classes(variant: :primary, size: :sm) %>
  <% end %>
  <p class="mt-2 text-[11px] text-slate-500 dark:text-zinc-400">
    <%= t("messaging.offers.rules", min: format_price((listing.price_cents * Message::MIN_OFFER_RATIO).ceil)) %>
  </p>
</details>
