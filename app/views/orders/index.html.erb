<% content_for :title, t("orders.index.title") %>

<div class="page-container py-8 sm:py-10">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("orders.index.title") %></h1>
      <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("orders.index.subtitle") %></p>
    </div>
    <%= link_to t("orders.index.keep_shopping"), listings_path,
                class: "text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2" role="tablist" aria-label="<%= t("orders.index.filters_label") %>">
    <% filters = {
      "all" => t("orders.filters.all"),
      "to_pay" => t("orders.filters.to_pay"),
      "in_progress" => t("orders.filters.in_progress"),
      "completed" => t("orders.filters.completed"),
      "cancelled" => t("orders.filters.cancelled")
    } %>
    <% filters.each do |key, label| %>
      <%= link_to orders_path(filter: key, q: @query.presence),
                  class: ui_chip_classes(active: @filter == key), role: "tab",
                  aria: { selected: @filter == key } do %>
        <span><%= label %></span>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: orders_path, method: :get, class: "mt-4 flex flex-wrap gap-2" do %>
    <%= hidden_field_tag :filter, @filter if @filter != "all" %>
    <label for="orders-search" class="sr-only"><%= t("orders.index.search_label") %></label>
    <input id="orders-search" type="search" name="q" value="<%= @query %>"
           placeholder="<%= t("orders.index.search_placeholder") %>"
           class="<%= ui_input_classes("max-w-md") %>">
    <%= submit_tag t("orders.index.search"), class: ui_button_classes(variant: :outline, size: :md) %>
  <% end %>

  <% if @orders.any? %>
    <div class="mt-6 space-y-4">
      <% @orders.each do |order| %>
        <article class="surface p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-heading text-lg font-semibold text-slate-950 dark:text-white">
                  <%= link_to order.number, order_path(order), class: "hover:text-brand-700 dark:hover:text-brand-300" %>
                </h2>
                <span class="<%= ui_badge_classes(tone: order_status_tone(order)) %>"><%= t("orders.statuses.#{order.status}") %></span>
              </div>
              <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400">
                <%= order.store&.name || order.seller.display_name %> ·
                <%= l(order.created_at.to_date, format: :long) %>
              </p>
            </div>
            <div class="text-right">
              <p class="font-heading text-lg font-bold text-slate-950 dark:text-white"><%= format_price(order.total_cents) %></p>
              <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("orders.index.items_count", count: order.order_items.sum(&:quantity)) %></p>
            </div>
          </div>

          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-700 dark:text-zinc-300">
            <% order.order_items.first(3).each do |item| %>
              <li class="max-w-full truncate"><%= item.title_snapshot %> × <%= item.quantity %></li>
            <% end %>
            <% if order.order_items.size > 3 %>
              <li class="text-slate-500 dark:text-zinc-400"><%= t("orders.index.more_items", count: order.order_items.size - 3) %></li>
            <% end %>
          </ul>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <%= link_to t("orders.index.view"), order_path(order),
                        class: ui_button_classes(variant: :outline, size: :sm) %>
            <% if order.cancellable? %>
              <%= button_to t("orders.cancel"), order_cancellation_path(order), method: :post,
                            class: ui_button_classes(variant: :ghost, size: :sm, extra: "!text-rose-600 dark:!text-rose-400"),
                            form: { data: { turbo_confirm: t("orders.cancel_confirm") } } %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="surface mt-6">
      <%= render "shared/empty_state", title: t("orders.index.empty_title"), body: t("orders.index.empty_body"),
                 cta_label: t("orders.index.keep_shopping"), cta_path: listings_path %>
    </div>
  <% end %>
</div>
