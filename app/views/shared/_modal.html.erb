<dialog id="<%= id %>" data-controller="modal"
        data-action="click->modal#backdropClose"
        class="w-[min(92vw,34rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-[var(--shadow-panel)] dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100"
        aria-labelledby="<%= id %>-title">
  <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-4 dark:border-zinc-800">
    <h2 id="<%= id %>-title" class="font-heading text-lg font-semibold"><%= title %></h2>
    <button type="button" data-action="modal#close"
            class="-m-1 rounded-full p-1 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
            aria-label="<%= t("layout.cookies.close") %>">
      <%= icon "x", class: "size-5" %>
    </button>
  </div>
  <div class="px-6 py-5">
    <%= yield %>
  </div>
</dialog>
