<div data-controller="back-to-top" class="fixed bottom-20 right-4 z-30 md:bottom-6 md:right-6">
  <button type="button" data-back-to-top-target="button" data-action="back-to-top#top" hidden
          class="inline-flex size-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-[var(--shadow-card)] transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300"
          aria-label="<%= t("layout.footer.back_to_top") %>">
    <%= icon "arrow-up", class: "size-5" %>
  </button>
</div>
