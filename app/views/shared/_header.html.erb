<header class="sticky top-0 z-40" data-controller="header">
  <div class="border-b border-slate-200 bg-white/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/90"
       data-header-target="bar">
    <div class="page-container flex items-center gap-3 py-3 lg:gap-5">
      <button type="button" data-action="drawer#open"
              class="inline-flex size-11 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 lg:hidden dark:text-zinc-200 dark:hover:bg-zinc-800"
              aria-label="<%= t("layout.header.menu_open") %>">
        <%= icon "menu", class: "size-6" %>
      </button>

      <div class="min-w-0 shrink-0"><%= render "shared/logo" %></div>

      <div class="hidden min-w-0 flex-1 justify-center px-2 md:flex">
        <%= render "shared/search_box", input_id: "site-search" %>
      </div>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        <%= link_to new_listing_path,
                    class: ui_button_classes(variant: :primary, size: :sm, extra: "!hidden xl:!inline-flex") do %>
          <%= icon "plus", class: "size-4" %>
          <span><%= t("layout.header.list_item") %></span>
        <% end %>

        <% if Setting.enabled?("sell_to_us_enabled") %>
          <%= link_to sell_to_us_path,
                      class: ui_button_classes(variant: :outline, size: :sm, extra: "!hidden xl:!inline-flex") do %>
            <span><%= t("layout.header.sell_to_us") %></span>
          <% end %>
        <% end %>

        <button type="button" data-action="theme#toggle" data-theme-target="toggle"
                data-label-light="<%= t("layout.header.theme_light") %>"
                data-label-dark="<%= t("layout.header.theme_dark") %>"
                aria-label="<%= t("layout.header.theme_dark") %>"
                aria-pressed="false"
                class="inline-flex size-11 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800">
          <span class="dark:hidden"><%= icon "moon", class: "size-5" %></span>
          <span class="hidden dark:block"><%= icon "sun", class: "size-5" %></span>
        </button>

        <%= link_to favorites_path,
                    class: "relative hidden size-11 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 md:inline-flex dark:text-zinc-200 dark:hover:bg-zinc-800",
                    aria: { label: t("layout.header.favourites") } do %>
          <%= icon "heart", class: "size-5" %>
        <% end %>

        <%= link_to conversations_path,
                    class: "relative hidden size-11 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 md:inline-flex dark:text-zinc-200 dark:hover:bg-zinc-800",
                    aria: { label: t("layout.header.notifications") } do %>
          <%= icon "bell", class: "size-5" %>
          <% unread = unread_notifications_count %>
          <% if unread.positive? %>
            <span class="absolute right-1 top-1 flex size-5 items-center justify-center rounded-full bg-accent-500 text-[10px] font-bold text-slate-950">
              <%= unread > 9 ? "9+" : unread %>
            </span>
          <% end %>
        <% end %>

        <%= link_to cart_path,
                    class: "relative inline-flex size-11 shrink-0 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800",
                    aria: { label: t("layout.header.cart") } do %>
          <%= icon "shopping-cart", class: "size-5" %>
          <%= render "shared/cart_badge" %>
        <% end %>

        <% if user_signed_in? %>
          <div class="relative" data-controller="dropdown">
            <button type="button" data-action="dropdown#toggle" data-dropdown-trigger
                    aria-expanded="false" aria-controls="account-menu" aria-haspopup="true"
                    aria-label="<%= t("layout.header.account") %>"
                    class="inline-flex min-h-11 items-center gap-2 rounded-full px-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800">
              <span class="flex size-8 items-center justify-center rounded-full bg-brand-100 font-heading text-sm font-bold text-brand-800 dark:bg-brand-900/50 dark:text-brand-200">
                <%= current_user.username.to_s.first.upcase %>
              </span>
              <span class="hidden max-w-28 truncate xl:inline"><%= current_user.username %></span>
              <span class="hidden text-slate-400 xl:inline"><%= icon "chevron-down", class: "size-3" %></span>
            </button>

            <div id="account-menu" data-dropdown-target="menu" hidden
                 class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-[var(--shadow-panel)] dark:border-zinc-800 dark:bg-zinc-900">
              <div class="px-3 py-2 text-xs text-slate-500 dark:text-zinc-400">
                <p class="truncate font-medium text-slate-800 dark:text-zinc-100"><%= current_user.username %></p>
                <p class="truncate"><%= current_user.email %></p>
              </div>
              <div class="my-1 border-t border-slate-200 dark:border-zinc-800"></div>
              <%= link_to orders_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "package", class: "size-4" %><%= t("layout.account_menu.my_orders") %>
              <% end %>
              <%= link_to conversations_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "message-circle", class: "size-4" %><%= t("layout.account_menu.inbox") %>
              <% end %>
              <%= link_to favorites_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "heart", class: "size-4" %><%= t("layout.account_menu.favourites") %>
              <% end %>
              <%= link_to account_path(anchor: "saved-searches"), class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "bookmark", class: "size-4" %><%= t("layout.account_menu.saved_searches") %>
              <% end %>
              <%= link_to account_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "user", class: "size-4" %><%= t("layout.account_menu.settings") %>
              <% end %>
              <%= link_to account_addresses_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "map-pin", class: "size-4" %><%= t("layout.account_menu.addresses") %>
              <% end %>
              <%= link_to edit_account_notification_preferences_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "bell", class: "size-4" %><%= t("layout.account_menu.notifications") %>
              <% end %>
              <%= link_to new_account_deletion_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                <%= icon "lock", class: "size-4" %><%= t("layout.account_menu.privacy") %>
              <% end %>

              <% if current_user.store.present? %>
                <div class="my-1 border-t border-slate-200 dark:border-zinc-800"></div>
                <p class="px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500">
                  <%= t("layout.account_menu.store_group") %>
                </p>
                <%= link_to store_path(current_user.store), class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "store", class: "size-4" %><%= t("layout.account_menu.public_profile") %>
                <% end %>
                <%= link_to seller_root_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "layout-grid", class: "size-4" %><%= t("layout.account_menu.seller_dashboard") %>
                <% end %>
                <%= link_to seller_listings_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "tag", class: "size-4" %><%= t("layout.account_menu.my_listings") %>
                <% end %>
                <%= link_to seller_orders_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "wallet", class: "size-4" %><%= t("layout.account_menu.my_sales") %>
                <% end %>
                <%= link_to edit_seller_store_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "settings", class: "size-4" %><%= t("layout.account_menu.store_settings") %>
                <% end %>
                <%= link_to edit_seller_store_policy_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "shield-check", class: "size-4" %><%= t("layout.account_menu.store_policies") %>
                <% end %>
                <%= link_to edit_seller_vacation_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "clock", class: "size-4" %><%= t("layout.account_menu.vacation_mode") %>
                <% end %>
                <%= link_to seller_payout_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "wallet", class: "size-4" %><%= t("layout.account_menu.payouts") %>
                <% end %>
              <% end %>

              <% if current_user.staff? %>
                <div class="my-1 border-t border-slate-200 dark:border-zinc-800"></div>
                <%= link_to admin_root_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-zinc-200 dark:hover:bg-zinc-800" do %>
                  <%= icon "shield-check", class: "size-4" %><%= t("layout.account_menu.admin") %>
                <% end %>
              <% end %>

              <div class="my-1 border-t border-slate-200 dark:border-zinc-800"></div>
              <%= button_to destroy_user_session_path, method: :delete,
                            class: "flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-500/10" do %>
                <%= icon "log-in", class: "size-4" %><%= t("layout.account_menu.logout") %>
              <% end %>
            </div>
          </div>
        <% else %>
          <%= link_to new_user_session_path(modal: 1),
                      data: { turbo_frame: "auth-modal" },
                      class: "inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full px-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 sm:px-3 dark:text-zinc-200 dark:hover:bg-zinc-800",
                      aria: { label: t("layout.header.login") } do %>
            <%= icon "user", class: "size-5" %>
            <span class="hidden xl:inline"><%= t("layout.header.login") %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="page-container pb-3 md:hidden">
      <form action="<%= search_path %>" method="get" role="search" class="relative">
        <label for="mobile-search" class="sr-only"><%= t("layout.header.search_label") %></label>
        <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-zinc-500">
          <%= icon "search", class: "size-4" %>
        </span>
        <input id="mobile-search" type="search" name="q" value="<%= params[:q] %>"
               placeholder="<%= t("layout.header.search_placeholder") %>"
               class="<%= ui_input_classes("rounded-full pl-10") %>">
      </form>
    </div>
  </div>

  <nav class="relative hidden border-b border-slate-200 bg-white lg:block dark:border-zinc-800 dark:bg-zinc-950"
       aria-label="<%= t("layout.tab_bar.label") %>"
       data-controller="mega-menu"
       data-action="mouseleave->mega-menu#scheduleClose keydown->mega-menu#escape">
    <div class="page-container flex items-center gap-1 overflow-x-auto pb-0.5 scrollbar-hide">
      <%= link_to listings_path, class: nav_link_classes(current_path_matches?(listings_path)) do %>
        <%= t("layout.nav.new") %>
      <% end %>

      <% primary_menu_categories.each do |item| %>
        <button type="button" data-action="mouseenter->mega-menu#intent click->mega-menu#toggle"
                data-mega-menu-target="trigger" data-panel-id="mega-<%= item["slug"] %>"
                aria-expanded="false" aria-controls="mega-<%= item["slug"] %>"
                class="<%= nav_link_classes(false) %>">
          <span><%= item["name"] %></span>
          <span class="text-slate-400 dark:text-zinc-500"><%= icon "chevron-down", class: "size-3" %></span>
        </button>
      <% end %>

      <%= link_to listings_path(deals: 1),
                  class: nav_link_classes(false) do %>
        <span class="text-accent-600 dark:text-accent-400"><%= icon "tag", class: "size-4" %></span>
        <%= t("layout.nav.deals") %>
      <% end %>

      <%= link_to t("layout.nav.pc_finder"), pc_finder_path,
                  class: "ml-auto hidden whitespace-nowrap px-3 text-xs font-medium text-slate-500 hover:text-brand-700 2xl:inline-flex dark:text-zinc-400 dark:hover:text-brand-300" %>

      <% if more_menu_categories.any? %>
        <button type="button" data-action="mouseenter->mega-menu#intent click->mega-menu#toggle"
                data-mega-menu-target="trigger" data-panel-id="mega-more"
                aria-expanded="false" aria-controls="mega-more"
                class="<%= nav_link_classes(false) %>">
          <span><%= t("layout.nav.more") %></span>
          <span class="text-slate-400 dark:text-zinc-500"><%= icon "chevron-down", class: "size-3" %></span>
        </button>
      <% end %>

    </div>

    <% primary_menu_categories.each do |item| %>
      <div id="mega-<%= item["slug"] %>" data-mega-menu-target="panel"
           data-panel-id="mega-<%= item["slug"] %>" hidden
           class="absolute inset-x-0 top-full z-50 border-b border-slate-200 bg-white shadow-[var(--shadow-panel)] dark:border-zinc-800 dark:bg-zinc-950">
        <div class="page-container grid gap-8 py-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div>
            <%= link_to item["path"], class: "inline-flex items-center gap-2 font-heading text-lg font-semibold text-brand-800 hover:text-brand-600 dark:text-brand-300" do %>
              <%= t("layout.nav.all_category", category: item["name"]) %>
              <%= icon "arrow-right", class: "size-4" %>
            <% end %>

            <% if item["children"].any? %>
              <div class="mt-5 grid grid-cols-2 gap-x-8 gap-y-2 sm:grid-cols-3">
                <% item["children"].each do |child| %>
                  <%= link_to child["name"], child["path"],
                              class: "rounded-lg px-2 py-1.5 text-sm text-slate-600 transition hover:bg-slate-50 hover:text-brand-700 dark:text-zinc-300 dark:hover:bg-zinc-900 dark:hover:text-brand-300" %>
                <% end %>
              </div>
            <% end %>

            <% if item["slug"].in?(%w[gaming-pcs gpus]) %>
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("layout.nav.quick_links") %></span>
                <% %w[value mid_range pro_gamer].each do |label| %>
                  <%= link_to t("listings.labels.#{label}"), "#{item["path"]}?labels=#{label}",
                              class: "rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300" %>
                <% end %>
                <%= link_to t("layout.nav.under_price", price: format_price(100_000)),
                            "#{item["path"]}?max_price=1000",
                            class: "rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300" %>
              </div>
            <% end %>
          </div>

          <div class="space-y-3">
            <% if item["slug"] == "gaming-pcs" %>
              <%= link_to pc_finder_path, class: "block rounded-xl bg-brand-900 p-5 text-brand-50 transition hover:bg-brand-800" do %>
                <span class="inline-flex size-10 items-center justify-center rounded-full bg-brand-700 text-brand-100"><%= icon "sparkles", class: "size-5" %></span>
                <p class="mt-3 font-heading text-base font-semibold"><%= t("layout.nav.promo.pc_finder_title") %></p>
                <p class="mt-1 text-xs text-brand-200"><%= t("layout.nav.promo.pc_finder_body") %></p>
                <p class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-accent-300">
                  <%= t("layout.nav.promo.pc_finder_cta") %><%= icon "arrow-right", class: "size-3" %>
                </p>
              <% end %>
            <% else %>
              <%= link_to sell_path, class: "block rounded-xl bg-slate-900 p-5 text-slate-50 transition hover:bg-slate-800 dark:bg-zinc-900 dark:hover:bg-zinc-800" do %>
                <span class="inline-flex size-10 items-center justify-center rounded-full bg-slate-800 text-accent-300 dark:bg-zinc-800"><%= icon "wallet", class: "size-5" %></span>
                <p class="mt-3 font-heading text-base font-semibold"><%= t("layout.nav.promo.sell_title") %></p>
                <p class="mt-1 text-xs text-slate-300"><%= t("layout.nav.promo.sell_body") %></p>
                <p class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-accent-300">
                  <%= t("layout.nav.promo.sell_cta") %><%= icon "arrow-right", class: "size-3" %>
                </p>
              <% end %>
            <% end %>

            <%= link_to listings_path(deals: 1), class: "block rounded-xl border border-slate-200 bg-slate-50 p-5 transition hover:border-brand-300 hover:bg-white dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-600" do %>
              <span class="inline-flex size-10 items-center justify-center rounded-full bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300"><%= icon "tag", class: "size-5" %></span>
              <p class="mt-3 font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("layout.nav.promo.deals_title") %></p>
              <p class="mt-1 text-xs text-slate-600 dark:text-zinc-400"><%= t("layout.nav.promo.deals_body") %></p>
              <p class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand-700 dark:text-brand-300">
                <%= t("layout.nav.promo.deals_cta") %><%= icon "arrow-right", class: "size-3" %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if more_menu_categories.any? %>
      <div id="mega-more" data-mega-menu-target="panel" data-panel-id="mega-more" hidden
           class="absolute inset-x-0 top-full z-50 border-b border-slate-200 bg-white shadow-[var(--shadow-panel)] dark:border-zinc-800 dark:bg-zinc-950">
        <div class="page-container py-8">
          <p class="font-heading text-lg font-semibold text-brand-800 dark:text-brand-300">
            <%= t("layout.nav.more") %>
          </p>
          <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% more_menu_categories.each do |item| %>
              <div>
                <%= link_to item["name"], item["path"],
                            class: "inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 hover:text-brand-700 dark:text-white dark:hover:text-brand-300" %>
                <% if item["children"].any? %>
                  <ul class="mt-2 space-y-1">
                    <% item["children"].first(6).each do |child| %>
                      <li>
                        <%= link_to child["name"], child["path"],
                                    class: "block rounded-lg px-1 py-1 text-sm text-slate-600 transition hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300" %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </nav>
</header>
