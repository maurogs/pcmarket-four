<div class="divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
  <% items.each do |item| %>
    <details class="group px-4 py-3">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-slate-900 dark:text-zinc-100">
        <%= item[:title] %>
        <span class="text-slate-400 transition group-open:rotate-180 dark:text-zinc-500">
          <%= icon "chevron-down", class: "size-4" %>
        </span>
      </summary>
      <div class="pt-3 text-sm text-slate-600 dark:text-zinc-400">
        <%= item[:content] %>
      </div>
    </details>
  <% end %>
</div>
