<footer class="mt-16 border-t border-line bg-cream-100 dark:bg-cream-surface">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <span class="font-display text-2xl font-bold">
          <span class="text-primary-600 dark:text-primary-400">PC</span><span class="text-body">Market</span>
        </span>
        <p class="mt-3 max-w-sm text-sm text-muted"><%= t("footer.tagline") %></p>

        <form action="<%= newsletter_subscribers_path %>" method="post" class="mt-6">
          <label for="newsletter-email" class="text-sm font-semibold"><%= t("newsletter.title") %></label>
          <p class="mt-1 text-sm text-muted"><%= t("newsletter.description") %></p>
          <div class="mt-3 flex gap-2">
            <input id="newsletter-email" type="email" name="email" required
                   placeholder="<%= t("newsletter.placeholder") %>" class="input-field max-w-xs">
            <%= submit_tag t("newsletter.submit"), class: "btn-primary shrink-0 cursor-pointer" %>
          </div>
        </form>

        <div class="mt-6 flex gap-1">
          <% %w[x instagram youtube discord].each do |network| %>
            <%= link_to "#", class: "btn-ghost p-2", aria: { label: t("footer.social.#{network}") } do %>
              <%= social_icon network %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% [%w[about footer.links.about], %w[help footer.links.help],
          %w[buying-selling footer.links.buying], %w[seller-academy footer.links.academy]].each do |page, key| %>
        <nav class="flex flex-col gap-2" aria-label="<%= t(key) %>">
          <h2 class="text-sm font-bold uppercase tracking-wide text-muted"><%= t(key) %></h2>
          <%= link_to t(key), page_path(id: page), class: "text-sm text-body hover:text-primary-700 dark:hover:text-primary-300" %>
          <% if page == "buying-selling" %>
            <%= link_to t("footer.links.selling"), page_path(id: "selling"),
                  class: "text-sm text-body hover:text-primary-700 dark:hover:text-primary-300" %>
          <% end %>
        </nav>
      <% end %>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; <%= Date.current.year %> <%= AppSettings.get(:site_name, "PCMarket") %>. <%= t("footer.rights") %></p>
      <div class="flex flex-wrap gap-4">
        <%= link_to t("footer.links.terms"), page_path(id: "terms"), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
        <%= link_to t("footer.links.privacy"), page_path(id: "privacy"), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
        <%= link_to t("footer.links.cookies"), page_path(id: "cookies"), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
      </div>
    </div>
  </div>
</footer>

<%= link_to "#main", class: "fixed bottom-4 left-4 z-40 btn-secondary p-3 shadow-lg", aria: { label: t("accessibility.back_to_top") } do %>
  <%= icon "arrow-up" %>
<% end %>
