<% content_for :title, t("seller.orders.show.title", number: @order.number) %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to t("seller.orders.show.back"), seller_orders_path,
                  class: "text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <h2 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= @order.number %></h2>
      <span class="<%= ui_badge_classes(tone: order_status_tone(@order)) %>"><%= t("orders.statuses.#{@order.status}") %></span>
    </div>
    <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("seller.orders.show.placed_on", date: l(@order.created_at.to_date, format: :long)) %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to t("seller.orders.show.packing_slip"), seller_order_packing_slip_path(@order),
                class: ui_button_classes(variant: :outline, size: :sm), target: "_blank", rel: "noopener" %>
    <%= link_to t("seller.orders.show.message_buyer"), conversations_path,
                class: ui_button_classes(variant: :ghost, size: :sm) %>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-6">
    <section class="surface overflow-hidden" aria-labelledby="seller-order-items">
      <h3 id="seller-order-items" class="border-b border-slate-200 px-5 py-4 font-heading text-lg font-semibold text-slate-950 dark:border-zinc-800 dark:text-white"><%= t("seller.orders.show.items_title") %></h3>
      <ul class="divide-y divide-slate-100 dark:divide-zinc-800">
        <% @order.order_items.each do |item| %>
          <li class="flex gap-4 px-5 py-4">
            <div class="size-16 shrink-0 overflow-hidden rounded-lg bg-slate-100 dark:bg-zinc-800">
              <% if item.listing&.images&.attached? %>
                <%= image_tag item.listing.ordered_images.first.variant(resize_to_limit: [ 128, 128 ], format: :webp),
                              alt: "", class: "size-full object-cover", loading: "lazy" %>
              <% else %>
                <%= image_tag "listing-placeholder.svg", alt: "", class: "size-full object-cover" %>
              <% end %>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-slate-950 dark:text-white"><%= item.title_snapshot %></p>
              <p class="mt-0.5 text-xs text-slate-500 dark:text-zinc-400"><%= t("seller.orders.show.quantity", count: item.quantity) %></p>
            </div>
            <p class="text-sm font-semibold text-slate-950 dark:text-white"><%= format_price(item.subtotal_cents) %></p>
          </li>
        <% end %>
      </ul>
      <dl class="space-y-2 border-t border-slate-200 px-5 py-4 text-sm dark:border-zinc-800">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-zinc-400"><%= t("cart.subtotal") %></dt>
          <dd class="font-medium text-slate-950 dark:text-white"><%= format_price(@order.subtotal_cents) %></dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-zinc-400"><%= t("cart.shipping") %></dt>
          <dd class="font-medium text-slate-950 dark:text-white"><%= format_price(@order.shipping_cents) %></dd>
        </div>
        <% if @order.commission_cents.to_i.positive? %>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-slate-600 dark:text-zinc-400"><%= t("seller.orders.show.commission") %></dt>
            <dd class="font-medium text-rose-600 dark:text-rose-400">−<%= format_price(@order.commission_cents) %></dd>
          </div>
        <% end %>
        <div class="flex items-center justify-between gap-4 border-t border-slate-200 pt-2 dark:border-zinc-800">
          <dt class="font-semibold text-slate-950 dark:text-white"><%= t("cart.estimated_total") %></dt>
          <dd class="font-heading text-lg font-bold text-slate-950 dark:text-white"><%= format_price(@order.total_cents) %></dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="text-slate-600 dark:text-zinc-400"><%= t("seller.orders.show.net_payout") %></dt>
          <dd class="font-semibold text-emerald-700 dark:text-emerald-400"><%= format_price(@order.net_to_seller_cents) %></dd>
        </div>
      </dl>
    </section>

    <section class="surface p-5" aria-labelledby="seller-order-timeline">
      <h3 id="seller-order-timeline" class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("seller.orders.show.timeline_title") %></h3>
      <ol class="mt-3 space-y-2">
        <% @order.timeline.each do |step| %>
          <% event = step[:event] %>
          <li class="flex items-start gap-3 text-sm">
            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-700 text-white">
              <%= icon "check", class: "size-3" %>
            </span>
            <span>
              <span class="font-medium text-slate-900 dark:text-zinc-100"><%= t("orders.events.#{step[:key]}", default: step[:key].to_s.humanize) %></span>
              <span class="ml-1 text-xs text-slate-500 dark:text-zinc-400"><%= l(step[:at].to_date, format: :long) %></span>
            </span>
          </li>
        <% end %>
      </ol>
    </section>

    <% if @order.review.present? && @reviews_enabled %>
      <section class="surface p-5" aria-labelledby="seller-order-review">
        <h3 id="seller-order-review" class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("seller.reviews.title") %></h3>
        <div class="mt-2"><%= render "shared/star_rating", rating: @order.review.rating %></div>
        <p class="mt-2 whitespace-pre-line text-sm text-slate-600 dark:text-zinc-400"><%= @order.review.body %></p>
        <% if @order.review.replied? %>
          <div class="mt-3 rounded-lg bg-slate-50 p-3 dark:bg-zinc-800/60">
            <p class="text-xs font-semibold text-slate-500 dark:text-zinc-400"><%= t("seller.reviews.your_reply") %></p>
            <p class="mt-1 text-sm text-slate-600 dark:text-zinc-300"><%= @order.review.seller_reply %></p>
          </div>
        <% end %>
        <% if @order.review.replied? %>
          <%= form_with url: seller_review_reply_path(@order.review), method: :patch, class: "mt-3 space-y-2" do |f| %>
            <%= f.text_area :seller_reply, value: @order.review.seller_reply, rows: 3,
                            name: "review[seller_reply]", class: ui_input_classes %>
            <%= f.submit t("seller.reviews.update_reply"), class: ui_button_classes(variant: :outline, size: :sm) %>
          <% end %>
        <% else %>
          <%= form_with url: seller_review_replies_path(review_id: @order.review.id), method: :post, class: "mt-3 space-y-2" do |f| %>
            <%= f.text_area :seller_reply, rows: 3, name: "review[seller_reply]",
                            placeholder: t("seller.reviews.reply_placeholder"), class: ui_input_classes %>
            <%= f.submit t("seller.reviews.reply"), class: ui_button_classes(variant: :primary, size: :sm) %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="space-y-6">
    <section class="surface p-5" aria-labelledby="seller-order-actions">
      <h3 id="seller-order-actions" class="font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("seller.orders.show.actions_title") %></h3>
      <div class="mt-3 space-y-2">
        <% if @order.payment_method == "cash_on_pickup" && @order.pending_payment? %>
          <%= button_to t("seller.orders.show.mark_paid"), seller_order_payment_path(@order),
                        method: :post, class: ui_button_classes(variant: :primary, size: :sm, extra: "w-full") %>
        <% end %>

        <% if @order.paid? && @order.shipping? %>
          <div data-controller="modal">
            <button type="button" data-action="modal#open" class="<%= ui_button_classes(variant: :primary, size: :sm, extra: "w-full") %>">
              <%= t("seller.orders.show.mark_shipped") %>
            </button>
            <%= render "shared/modal", id: "ship-modal", title: t("seller.orders.shipment.title") do %>
              <%= form_with url: seller_order_shipment_path(@order), method: :post, scope: :order, class: "space-y-4" do |f| %>
                <div>
                  <%= f.label :carrier, t("seller.orders.shipment.carrier"), class: "block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
                  <%= f.select :carrier,
                               Order::CARRIERS.map { |carrier| [ order_carrier_label(carrier), carrier ] },
                               { prompt: t("seller.orders.shipment.carrier_prompt") },
                               class: ui_input_classes("mt-1") %>
                </div>
                <div>
                  <%= f.label :tracking_number, t("seller.orders.shipment.tracking"), class: "block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
                  <%= f.text_field :tracking_number, class: ui_input_classes("mt-1") %>
                  <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400"><%= t("seller.orders.shipment.tracking_hint") %></p>
                </div>
                <%= f.submit t("seller.orders.shipment.submit"), class: ui_button_classes(variant: :primary, size: :sm, extra: "w-full") %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if @order.paid? && @order.local_pickup? %>
          <%= button_to t("seller.orders.show.mark_ready"), seller_order_pickup_path(@order),
                        method: :post, class: ui_button_classes(variant: :primary, size: :sm, extra: "w-full") %>
        <% end %>

        <% if @order.pending_payment? || @order.paid? %>
          <div data-controller="modal">
            <button type="button" data-action="modal#open" class="<%= ui_button_classes(variant: :danger, size: :sm, extra: "w-full") %>">
              <%= t("seller.orders.show.cancel_order") %>
            </button>
            <%= render "shared/modal", id: "cancel-order-modal", title: t("seller.orders.cancellation.title") do %>
              <%= form_with url: seller_order_cancellation_path(@order), method: :post, scope: :order, class: "space-y-4" do |f| %>
                <%= f.label :reason, t("seller.orders.cancellation.reason"), class: "block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
                <%= f.text_area :reason, rows: 3, required: true, class: ui_input_classes %>
                <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("seller.orders.cancellation.refund_note") %></p>
                <%= f.submit t("seller.orders.cancellation.submit"), class: ui_button_classes(variant: :danger, size: :sm, extra: "w-full") %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="surface p-5" aria-labelledby="seller-order-buyer">
      <h3 id="seller-order-buyer" class="font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("seller.orders.show.buyer_title") %></h3>
      <p class="mt-2 text-sm font-semibold text-slate-950 dark:text-white"><%= @order.buyer&.display_name || @order.buyer_email %></p>
      <p class="text-sm text-slate-600 dark:text-zinc-400"><%= @order.buyer_email.presence || @order.buyer&.email %></p>
      <% if @order.buyer_details_visible? %>
        <address class="mt-3 text-sm not-italic leading-6 text-slate-600 dark:text-zinc-400">
          <%= @order.ship_name %><br>
          <%= @order.ship_line1 %><br>
          <% if @order.ship_line2.present? %><%= @order.ship_line2 %><br><% end %>
          <%= [ @order.ship_postal_code, @order.ship_city ].compact_blank.join(" ") %><br>
          <%= [ @order.ship_region, @order.ship_country_code ].compact_blank.join(", ") %>
          <% if @order.ship_phone.present? %><br><%= @order.ship_phone %><% end %>
        </address>
      <% else %>
        <p class="mt-3 rounded-lg bg-slate-50 p-3 text-xs text-slate-500 dark:bg-zinc-800/60 dark:text-zinc-400"><%= t("seller.orders.show.address_hidden") %></p>
      <% end %>
    </section>

    <section class="surface p-5" aria-labelledby="seller-order-delivery">
      <h3 id="seller-order-delivery" class="font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("seller.orders.show.delivery_title") %></h3>
      <p class="mt-2 text-sm text-slate-700 dark:text-zinc-300"><%= t("checkout.delivery.#{@order.fulfilment}") %></p>
      <% if @order.carrier.present? %>
        <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("orders.show.carrier", carrier: order_carrier_label(@order.carrier)) %></p>
      <% end %>
      <% if @order.tracking_number.present? %>
        <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400">
          <% if @order.tracking_url.present? %>
            <%= link_to @order.tracking_number, @order.tracking_url, target: "_blank", rel: "noopener",
                        class: "font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
          <% else %>
            <span class="font-semibold text-slate-900 dark:text-white"><%= @order.tracking_number %></span>
          <% end %>
        </p>
      <% end %>
    </section>
  </aside>
</div>
