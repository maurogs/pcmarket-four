<% content_for :title, t("seller.orders.packing_slip.title", number: @order.number) %>

<div class="mx-auto max-w-3xl">
  <div class="no-print mb-4 flex items-center justify-between gap-3">
    <%= link_to t("seller.orders.show.back"), seller_order_path(@order),
                class: "text-sm font-semibold text-brand-700 hover:underline" %>
    <button type="button" id="print-slip" class="rounded-full bg-brand-700 px-4 py-2 text-sm font-semibold text-white">
      <%= t("seller.orders.packing_slip.print") %>
    </button>
  </div>

  <article class="print-sheet rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <header class="flex flex-wrap items-start justify-between gap-6 border-b border-slate-200 pb-6">
      <div>
        <p class="font-heading text-2xl font-bold"><%= site_name %></p>
        <p class="mt-1 text-sm text-slate-600"><%= t("seller.orders.packing_slip.packing_slip") %></p>
      </div>
      <div class="text-right text-sm">
        <p class="font-semibold"><%= @order.number %></p>
        <p class="text-slate-600"><%= l(@order.created_at.to_date, format: :long) %></p>
        <p class="text-slate-600"><%= t("orders.statuses.#{@order.status}") %></p>
      </div>
    </header>

    <section class="mt-6 grid gap-6 sm:grid-cols-2">
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("seller.orders.packing_slip.ship_to") %></h2>
        <address class="mt-2 text-sm not-italic leading-6">
          <%= @order.ship_name %><br>
          <%= @order.ship_line1 %><br>
          <% if @order.ship_line2.present? %><%= @order.ship_line2 %><br><% end %>
          <%= [ @order.ship_postal_code, @order.ship_city ].compact_blank.join(" ") %><br>
          <%= [ @order.ship_region, @order.ship_country_code ].compact_blank.join(", ") %>
          <% if @order.ship_phone.present? %><br><%= @order.ship_phone %><% end %>
        </address>
      </div>
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("seller.orders.packing_slip.from") %></h2>
        <p class="mt-2 text-sm leading-6">
          <%= @order.store&.name || @order.seller.display_name %><br>
          <%= @order.store&.location %>
        </p>
        <p class="mt-3 text-xs text-slate-500"><%= t("seller.orders.packing_slip.fulfilment", method: t("checkout.delivery.#{@order.fulfilment}")) %></p>
      </div>
    </section>

    <table class="mt-8 w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500">
          <th class="py-2"><%= t("seller.orders.packing_slip.item") %></th>
          <th class="py-2 text-center"><%= t("seller.orders.packing_slip.quantity_short") %></th>
          <th class="py-2 text-right"><%= t("seller.orders.packing_slip.price") %></th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr class="border-b border-slate-200">
            <td class="py-3"><%= item.title_snapshot %></td>
            <td class="py-3 text-center"><%= item.quantity %></td>
            <td class="py-3 text-right"><%= format_price(item.subtotal_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="mt-4 flex justify-end">
      <dl class="w-64 space-y-1 text-sm">
        <div class="flex justify-between"><dt class="text-slate-600"><%= t("cart.subtotal") %></dt><dd><%= format_price(@order.subtotal_cents) %></dd></div>
        <div class="flex justify-between"><dt class="text-slate-600"><%= t("cart.shipping") %></dt><dd><%= format_price(@order.shipping_cents) %></dd></div>
        <div class="flex justify-between border-t border-slate-300 pt-1 font-semibold"><dt><%= t("cart.estimated_total") %></dt><dd><%= format_price(@order.total_cents) %></dd></div>
      </dl>
    </div>

    <footer class="mt-8 border-t border-slate-200 pt-4 text-xs text-slate-500">
      <%= t("seller.orders.packing_slip.footer", site: site_name) %>
    </footer>
  </article>
</div>

<%= javascript_tag nonce: true do %>
  document.getElementById("print-slip")?.addEventListener("click", function () { window.print(); });
<% end %>
