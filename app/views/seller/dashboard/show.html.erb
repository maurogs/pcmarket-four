<% content_for :title, t("seller.dashboard.title") %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("seller.dashboard.title") %></h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("seller.dashboard.subtitle") %></p>
  </div>
  <%= link_to seller_orders_path, class: ui_button_classes(variant: :outline, size: :sm) do %>
    <%= icon "package", class: "size-4" %><%= t("seller.area.sales") %>
  <% end %>
</div>

<div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <% %i[views favourites active_listings pending_review sales revenue rating].each do |key| %>
    <% metric = @dashboard[:metrics][key] %>
    <div class="surface p-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("seller.dashboard.metrics.#{key}") %></p>
      <p class="mt-1.5 font-heading text-2xl font-bold text-slate-950 dark:text-white">
        <% if key == :revenue %>
          <%= format_price(metric[:value]) %>
        <% elsif key == :rating %>
          <%= number_with_precision(metric[:value], precision: 1) %> / 5
        <% else %>
          <%= number_with_delimiter(metric[:value]) %>
        <% end %>
      </p>
      <% if metric[:delta] %>
        <% delta = metric[:delta] %>
        <p class="mt-1 flex items-center gap-1 text-xs font-medium <%= delta.positive? ? 'text-emerald-600 dark:text-emerald-400' : (delta.negative? ? 'text-rose-600 dark:text-rose-400' : 'text-slate-500 dark:text-zinc-400') %>">
          <span aria-hidden="true"><%= delta.positive? ? "▲" : (delta.negative? ? "▼" : "•") %></span>
          <span><%= delta.abs %>%</span>
          <span class="font-normal text-slate-500 dark:text-zinc-500"><%= t("seller.dashboard.previous_period") %></span>
        </p>
      <% else %>
        <p class="mt-1 text-xs text-slate-500 dark:text-zinc-500"><%= t("seller.dashboard.last_30_days") %></p>
      <% end %>
    </div>
  <% end %>
</div>

<section class="surface mt-5 p-5">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("seller.dashboard.chart_title") %></h3>
      <p class="text-sm text-slate-600 dark:text-zinc-400"><%= t("seller.dashboard.chart_desc") %></p>
    </div>
    <p class="text-sm font-semibold text-slate-700 dark:text-zinc-300"><%= t("seller.dashboard.chart_total", count: @dashboard[:orders_per_day].values.sum) %></p>
  </div>

  <% counts = @dashboard[:orders_per_day].values %>
  <% max = [ counts.max.to_i, 1 ].max %>
  <% slot = 20 %>
  <% width = counts.size * slot %>
  <div class="mt-4 overflow-x-auto">
    <svg viewBox="0 0 <%= width %> 180" role="img" aria-labelledby="orders-chart-title orders-chart-desc"
         class="h-44 w-full min-w-[32rem]" preserveAspectRatio="none">
      <title id="orders-chart-title"><%= t("seller.dashboard.chart_title") %></title>
      <desc id="orders-chart-desc"><%= t("seller.dashboard.chart_desc") %></desc>
      <line x1="0" y1="150" x2="<%= width %>" y2="150" class="stroke-slate-300 dark:stroke-zinc-700" stroke-width="1" />
      <% @dashboard[:orders_per_day].each_with_index do |(date, count), index| %>
        <% bar_height = count.zero? ? 2 : ((count.to_f / max) * 120).round %>
        <rect x="<%= index * slot + 2 %>" y="<%= 150 - bar_height %>" width="<%= slot - 4 %>" height="<%= bar_height %>"
              rx="3" class="fill-brand-600 dark:fill-brand-400">
          <title><%= t("seller.dashboard.chart_day", date: l(date, format: :short), count: count) %></title>
        </rect>
      <% end %>
    </svg>
  </div>

  <table class="sr-only">
    <caption><%= t("seller.dashboard.chart_title") %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t("seller.dashboard.chart_table_day") %></th>
        <th scope="col"><%= t("seller.dashboard.chart_table_orders") %></th>
      </tr>
    </thead>
    <tbody>
      <% @dashboard[:orders_per_day].each do |date, count| %>
        <tr>
          <th scope="row"><%= l(date, format: :short) %></th>
          <td><%= count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="mt-5 grid gap-5 xl:grid-cols-2">
  <section class="surface p-5">
    <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("seller.dashboard.action_needed") %></h3>
    <ul class="mt-3 space-y-2 text-sm">
      <% if @dashboard[:action_needed][:rejected_listings].positive? %>
        <li>
          <%= link_to seller_listings_path(status: "rejected"), class: "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-rose-700 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-500/10" do %>
            <span><%= t("seller.dashboard.actions.rejected", count: @dashboard[:action_needed][:rejected_listings]) %></span>
            <%= icon "chevron-right", class: "size-4 shrink-0" %>
          <% end %>
        </li>
      <% end %>
      <% if @dashboard[:action_needed][:orders_to_ship].positive? %>
        <li>
          <%= link_to seller_orders_path, class: "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-amber-800 hover:bg-amber-50 dark:text-amber-300 dark:hover:bg-amber-500/10" do %>
            <span><%= t("seller.dashboard.actions.orders_to_ship", count: @dashboard[:action_needed][:orders_to_ship]) %></span>
            <%= icon "chevron-right", class: "size-4 shrink-0" %>
          <% end %>
        </li>
      <% end %>
      <% if @dashboard[:action_needed][:unanswered_conversations].positive? %>
        <li>
          <%= link_to conversations_path, class: "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-brand-800 hover:bg-brand-50 dark:text-brand-300 dark:hover:bg-brand-500/10" do %>
            <span><%= t("seller.dashboard.actions.unanswered", count: @dashboard[:action_needed][:unanswered_conversations]) %></span>
            <%= icon "chevron-right", class: "size-4 shrink-0" %>
          <% end %>
        </li>
      <% end %>
      <% unless @dashboard[:action_needed][:rejected_listings].positive? || @dashboard[:action_needed][:orders_to_ship].positive? || @dashboard[:action_needed][:unanswered_conversations].positive? %>
        <li class="flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-300">
          <%= icon "check", class: "size-4 shrink-0" %><%= t("seller.dashboard.no_actions") %>
        </li>
      <% end %>
    </ul>

    <div class="mt-5 border-t border-slate-200 pt-4 dark:border-zinc-800">
      <div class="flex items-center justify-between gap-3">
        <p class="text-sm font-semibold text-slate-800 dark:text-zinc-100"><%= t("seller.dashboard.profile_completeness") %></p>
        <p class="text-sm font-semibold text-brand-700 dark:text-brand-300"><%= t("seller.dashboard.completeness", percent: @dashboard[:action_needed][:completeness]) %></p>
      </div>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-zinc-800" role="progressbar"
           aria-valuenow="<%= @dashboard[:action_needed][:completeness] %>" aria-valuemin="0" aria-valuemax="100"
           aria-label="<%= t("seller.dashboard.profile_completeness") %>">
        <div class="h-full rounded-full bg-brand-600 dark:bg-brand-400" style="width: <%= @dashboard[:action_needed][:completeness] %>%"></div>
      </div>
      <ul class="mt-3 space-y-1.5 text-sm">
        <% @dashboard[:action_needed][:completeness_checks].each do |key, done| %>
          <li class="flex items-center gap-2 <%= done ? 'text-slate-400 line-through dark:text-zinc-500' : 'text-slate-700 dark:text-zinc-300' %>">
            <% if done %>
              <%= icon "check", class: "size-4 shrink-0 text-emerald-600 dark:text-emerald-400" %>
            <% else %>
              <%= icon "chevron-right", class: "size-4 shrink-0" %>
            <% end %>
            <%= t("seller.dashboard.checklist.#{key}") %>
          </li>
        <% end %>
      </ul>
      <%= link_to edit_seller_store_path, class: "mt-3 inline-flex text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" do %>
        <%= t("seller.dashboard.edit_profile") %>
      <% end %>
    </div>
  </section>

  <section class="surface p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("seller.dashboard.recent_listings") %></h3>
      <%= link_to t("seller.dashboard.view_all"), seller_listings_path, class: "text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
    </div>
    <% if @dashboard[:recent_listings].any? %>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-zinc-800 dark:text-zinc-400">
            <tr>
              <th scope="col" class="py-2 pr-3"><%= t("seller.dashboard.columns.listing") %></th>
              <th scope="col" class="px-3 py-2"><%= t("seller.dashboard.columns.status") %></th>
              <th scope="col" class="px-3 py-2 text-right"><%= t("seller.dashboard.columns.views") %></th>
              <th scope="col" class="pl-3 py-2 text-right"><%= t("seller.dashboard.columns.price") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
            <% @dashboard[:recent_listings].each do |listing| %>
              <tr>
                <td class="py-2.5 pr-3">
                  <%= link_to truncate(listing.title, length: 42), edit_listing_path(listing),
                              class: "font-medium text-slate-900 hover:text-brand-700 dark:text-zinc-100 dark:hover:text-brand-300" %>
                  <p class="text-xs text-slate-500 dark:text-zinc-500"><%= listing.category&.name %></p>
                </td>
                <td class="px-3 py-2.5">
                  <span class="<%= ui_badge_classes(tone: listing.published? ? :success : :neutral) %>"><%= t("listings.statuses.#{listing.status}") %></span>
                </td>
                <td class="px-3 py-2.5 text-right tabular-nums text-slate-600 dark:text-zinc-400"><%= listing.views_count %></td>
                <td class="pl-3 py-2.5 text-right font-semibold tabular-nums text-slate-900 dark:text-white"><%= format_price(listing.price_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-slate-500 dark:text-zinc-400"><%= t("seller.dashboard.empty_recent") %></p>
      <%= link_to new_listing_path, class: ui_button_classes(variant: :primary, size: :sm, extra: "mt-3") do %>
        <%= icon "plus", class: "size-4" %><%= t("listings.seller.new_listing") %>
      <% end %>
    <% end %>
  </section>
</div>
