<% content_for :seller_body do %>
  <div class="card max-w-3xl p-8">
    <h1 class="font-display text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-2 text-sm text-muted"><%= t(".status_note", status: @listing.status_label) %></p>

    <%= render "form", listing: @listing %>
  </div>
<% end %>

<%= render "seller/shell" %>
