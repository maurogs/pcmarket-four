<%# Sell form — Phase 3. Specs (step 2) reload from the category select through
    the listing_specs Turbo Frame; photos (step 3) upload directly to storage
    through the image_uploader controller at the end. Price fields work in
    euros and convert to cents via the model's virtual attributes
    (Listing#price=, #original_price=, #shipping_price=). %>
<%= form_with model: listing,
      url: listing.persisted? ? seller_listing_path(listing) : seller_listings_path,
      class: "mt-6 space-y-8" do |f| %>
  <%= render "devise/shared/error_messages", resource: listing %>

  <%# Category choice drives the specs frame below (frame_src_controller). %>
  <div data-controller="frame-src"
       data-frame-src-url-value="<%= seller_listing_spec_fields_path %>"
       data-frame-src-listing-id-value="<%= listing.persisted? ? listing.id : "" %>">
    <section>
      <h2 class="text-lg font-semibold"><%= t(".category_title") %></h2>

      <div class="mt-4">
        <%= f.label :category_id, class: "block text-sm font-medium" %>
        <%= f.select :category_id, grouped_category_options,
              { include_blank: t(".category_prompt") }, class: "input-field mt-1",
              data: { frame_src_target: "select", action: "change->frame-src#refresh" } %>
      </div>
    </section>

    <section>
      <h2 class="mt-8 text-lg font-semibold"><%= t(".specs_title") %></h2>

      <%= turbo_frame_tag "listing_specs", data: { frame_src_target: "frame" } do %>
        <%= render "specs_fields", listing: listing, category: listing.category %>
      <% end %>
    </section>
  </div>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".details_title") %></h2>

    <div class="mt-4 space-y-4">
      <div data-controller="char-count" data-char-count-max-value="<%= Listing::TITLE_MAX_LENGTH %>">
        <%= f.label :title, class: "block text-sm font-medium" %>
        <div class="mt-1 flex items-center gap-3">
          <%= f.text_field :title, required: true, maxlength: Listing::TITLE_MAX_LENGTH,
                class: "input-field",
                data: { char_count_target: "input", action: "input->char-count#refresh" } %>
          <span class="shrink-0 text-xs text-muted" data-char-count-target="count"></span>
        </div>
      </div>

      <div>
        <%= f.label :description, class: "block text-sm font-medium" %>
        <%= f.text_area :description, rows: 6, class: "input-field mt-1 rounded-2xl" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".condition_title") %></h2>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% Listing.conditions.each_key do |value| %>
        <%= f.label :condition, value: value,
              class: "flex cursor-pointer flex-col gap-1 rounded-2xl border border-line bg-surface p-4 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50 dark:has-[:checked]:border-primary-400 dark:has-[:checked]:bg-primary-950" do %>
          <span class="flex items-center gap-2">
            <%= f.radio_button :condition, value, class: "h-4 w-4 border-line accent-primary-600" %>
            <span class="text-sm font-semibold"><%= t("activerecord.attributes.listing.condition.#{value}") %></span>
          </span>
          <span class="text-xs text-muted"><%= t(".condition_descriptions.#{value}") %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".price_title") %></h2>

    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <div>
        <%= f.label :price, class: "block text-sm font-medium" %>
        <p class="text-xs text-muted"><%= t(".price_hint") %></p>
        <%= f.number_field :price, step: 0.01, min: 0, required: true, class: "input-field mt-1" %>
      </div>
      <div>
        <%= f.label :original_price, class: "block text-sm font-medium" %>
        <p class="text-xs text-muted"><%= t(".original_price_hint") %></p>
        <%= f.number_field :original_price, step: 0.01, min: 0, class: "input-field mt-1" %>
      </div>
      <div>
        <%= f.label :quantity, class: "block text-sm font-medium" %>
        <%= f.number_field :quantity, min: 1, required: true, class: "input-field mt-1" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".shipping_title") %></h2>

    <div class="mt-4 space-y-4">
      <div class="grid gap-3 sm:grid-cols-3">
        <% Listing.shipping_methods.each_key do |value| %>
          <label class="flex cursor-pointer items-center gap-2 rounded-2xl border border-line bg-surface p-4 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50 dark:has-[:checked]:border-primary-400 dark:has-[:checked]:bg-primary-950">
            <%= f.radio_button :shipping_method, value, class: "h-4 w-4 border-line accent-primary-600" %>
            <span class="text-sm font-semibold"><%= t("activerecord.attributes.listing.shipping_method.#{value}") %></span>
          </label>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :shipping_price, class: "block text-sm font-medium" %>
          <%= f.number_field :shipping_price, step: 0.01, min: 0, class: "input-field mt-1" %>
        </div>
        <div>
          <%= f.label :ships_within_days, class: "block text-sm font-medium" %>
          <p class="text-xs text-muted"><%= t(".ships_within_days_hint") %></p>
          <%= f.number_field :ships_within_days, min: 1, max: 30, required: true, class: "input-field mt-1" %>
        </div>
      </div>

      <div class="flex flex-wrap gap-6">
        <div class="flex items-center gap-2">
          <%= f.check_box :free_shipping, class: "h-4 w-4 rounded border-line accent-primary-600" %>
          <%= f.label :free_shipping, class: "text-sm font-medium" %>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :local_pickup, class: "h-4 w-4 rounded border-line accent-primary-600" %>
          <%= f.label :local_pickup, class: "text-sm font-medium" %>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".location_title") %></h2>

    <div class="mt-4 grid grid-cols-2 gap-3">
      <div>
        <%= f.label :province, class: "block text-sm font-medium" %>
        <%= f.select :province, SpanishProvince.options,
              { include_blank: t(".province_prompt") }, class: "input-field mt-1" %>
      </div>
      <div>
        <%= f.label :city, class: "block text-sm font-medium" %>
        <%= f.text_field :city, autocomplete: "address-level2", class: "input-field mt-1" %>
      </div>
      <div>
        <%= f.label :postal_code, class: "block text-sm font-medium" %>
        <%= f.text_field :postal_code, autocomplete: "postal-code", class: "input-field mt-1" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".offers_title") %></h2>

    <div class="mt-4 flex items-center gap-2">
      <%= f.check_box :allow_offers, class: "h-4 w-4 rounded border-line accent-primary-600" %>
      <%= f.label :allow_offers, class: "text-sm font-medium" %>
    </div>
  </section>

  <%# Photos (Phase 3 step 3b): existing images are reorderable tiles (drag
      handle or the arrow buttons) with a remove checkbox; new files preview
      client-side and direct-upload on submit. The hidden image_order field
      holds the attachment ids as JSON — see image_uploader_controller.js. %>
  <% max_images = AppSettings.get("max_images_per_listing", Listing::DEFAULT_MAX_IMAGES).to_i %>
  <% existing_images = listing.ordered_images %>
  <section data-controller="image-uploader" data-image-uploader-max-value="<%= max_images %>">
    <h2 class="text-lg font-semibold"><%= t(".photos_title") %></h2>

    <div class="mt-4 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <label class="btn-secondary cursor-pointer">
          <%= t(".photos_add") %>
          <%= f.file_field :images, multiple: true, direct_upload: true,
                accept: "image/jpeg,image/png,image/webp,image/heic", class: "sr-only",
                data: { image_uploader_target: "input",
                        action: "change->image-uploader#filesSelected " \
                                "direct-upload:initialize->image-uploader#uploadInitialize " \
                                "direct-upload:progress->image-uploader#uploadProgress " \
                                "direct-upload:error->image-uploader#uploadError " \
                                "direct-upload:end->image-uploader#uploadEnd" } %>
        </label>
        <span class="text-xs text-muted" data-image-uploader-target="counter">
          <%= existing_images.size %> / <%= max_images %>
        </span>
      </div>

      <p class="text-xs text-muted"><%= t(".photos_hint", max_mb: Listing::MAX_IMAGE_BYTES / 1.megabyte) %></p>

      <p class="hidden text-xs font-medium text-red-600 dark:text-red-400" data-image-uploader-target="warning">
        <%= t(".photos_too_many", max: max_images) %>
      </p>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"
           data-image-uploader-target="grid" data-action="dragover->image-uploader#dragOver">
        <% existing_images.each_with_index do |attachment, index| %>
          <%# A failed save re-renders the form with pending (not yet uploaded)
              or rejected blobs, which have no signed id / cannot be
              transformed — those tiles fall back to a filename placeholder. %>
          <% thumbnail = attachment.persisted? && attachment.blob&.variable? %>
          <div class="relative aspect-square overflow-hidden rounded-2xl border border-line bg-surface"
               data-image-uploader-target="tile" data-image-uploader-id="<%= attachment.id %>">
            <% if thumbnail %>
              <%= image_tag url_for(attachment.variant(**Listing::IMAGE_VARIANTS[:thumb], format: Listing::IMAGE_FORMAT)),
                    alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
            <% else %>
              <div class="flex h-full w-full flex-col items-center justify-center gap-1.5 p-3 text-muted">
                <%= icon "image", class: "h-6 w-6" %>
                <span class="line-clamp-2 break-all text-center text-[10px] leading-tight"><%= attachment.filename %></span>
              </div>
            <% end %>
            <span class="absolute left-1.5 top-1.5 rounded-full bg-primary-600 px-2 py-0.5 text-[10px] font-semibold text-white <%= "hidden" unless index.zero? %>"
                  data-image-uploader-target="badge"><%= t(".photos_cover") %></span>
            <div class="absolute inset-x-0 bottom-0 flex items-center gap-0.5 bg-black/50 px-1.5 py-1 text-white">
              <button type="button" class="cursor-pointer p-1" data-action="image-uploader#moveLeft"
                      aria-label="<%= t(".photos_move_left") %>"><%= icon "chevron-left", class: "h-4 w-4" %></button>
              <button type="button" class="cursor-pointer p-1" data-action="image-uploader#moveRight"
                      aria-label="<%= t(".photos_move_right") %>"><%= icon "chevron-right", class: "h-4 w-4" %></button>
              <span class="cursor-grab p-1 active:cursor-grabbing" draggable="true" title="<%= t(".photos_drag_hint") %>"
                    data-action="dragstart->image-uploader#dragStart">
                <%= icon "grip", class: "h-4 w-4" %>
              </span>
              <% if attachment.persisted? %>
                <label class="ml-auto flex cursor-pointer items-center gap-1 pl-1 text-[11px] font-medium">
                  <%= check_box_tag "listing[remove_image_ids][]", attachment.id, false,
                        id: "remove_image_#{attachment.id}", class: "h-3.5 w-3.5 accent-red-600",
                        data: { action: "image-uploader#toggleRemove" } %>
                  <%= t(".photos_remove") %>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%= f.hidden_field :image_order, value: existing_images.map { |a| a.id.to_s }.to_json,
            data: { image_uploader_target: "order" } %>

      <%# Cloned by the controller for every newly picked file (no attachment
          id yet, so it never enters image_order — the server appends it). %>
      <template data-image-uploader-target="template">
        <div class="relative aspect-square overflow-hidden rounded-2xl border border-line bg-surface"
             data-image-uploader-target="tile" data-image-uploader-id="">
          <img class="h-full w-full object-cover" alt="" data-image-uploader-target="preview">
          <span class="absolute left-1.5 top-1.5 hidden rounded-full bg-primary-600 px-2 py-0.5 text-[10px] font-semibold text-white"
                data-image-uploader-target="badge"><%= t(".photos_cover") %></span>
          <div class="absolute inset-x-0 top-0 h-1 bg-black/20 opacity-0 transition-opacity"
               data-image-uploader-target="progress">
            <div class="h-full w-0 bg-primary-500" data-image-uploader-target="bar"></div>
          </div>
          <div class="absolute inset-x-0 bottom-0 flex items-center gap-0.5 bg-black/50 px-1.5 py-1 text-white">
            <button type="button" class="cursor-pointer p-1" data-action="image-uploader#moveLeft"
                    aria-label="<%= t(".photos_move_left") %>"><%= icon "chevron-left", class: "h-4 w-4" %></button>
            <button type="button" class="cursor-pointer p-1" data-action="image-uploader#moveRight"
                    aria-label="<%= t(".photos_move_right") %>"><%= icon "chevron-right", class: "h-4 w-4" %></button>
            <span class="cursor-grab p-1 active:cursor-grabbing" draggable="true" title="<%= t(".photos_drag_hint") %>"
                  data-action="dragstart->image-uploader#dragStart">
              <%= icon "grip", class: "h-4 w-4" %>
            </span>
            <button type="button" class="ml-auto cursor-pointer p-1" data-action="image-uploader#removeNew"
                    aria-label="<%= t(".photos_remove") %>"><%= icon "close", class: "h-4 w-4" %></button>
          </div>
        </div>
      </template>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t(".photos_tips_title") %></h3>
        <ul class="mt-1 list-disc space-y-0.5 pl-5 text-xs text-muted">
          <li><%= t(".photos_tips.first_is_cover") %></li>
          <li><%= t(".photos_tips.good_light") %></li>
          <li><%= t(".photos_tips.show_defects") %></li>
        </ul>
      </div>
    </div>
  </section>

  <%# "Save & submit" rides on the same form: the button posts the fields
      plus submit_for_review=1, and the update action runs the submission
      through Listings::Submitter right after saving. A <button> (not an
      input[type=submit]) so the label text and the submitted value differ. %>
  <div class="flex flex-wrap gap-3">
    <%= f.submit t(".submit"), class: "btn-primary flex-1 cursor-pointer" %>
    <% if listing.persisted? && listing.may_submit? %>
      <button type="submit" name="submit_for_review" value="1" class="btn-secondary flex-1 cursor-pointer">
        <%= t(".submit_for_review") %>
      </button>
    <% end %>
  </div>
<% end %>
