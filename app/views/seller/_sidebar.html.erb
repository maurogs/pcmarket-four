<%
  # Active item comes from the controller. The dashboard is a "Soon" pill
  # until Phase 4 lands — never a dead link.
  sections = [
    [ "listings", t(".my_listings"), seller_listings_path ],
    [ "stores", t(".store_settings"), edit_seller_store_path ]
  ]
  active = controller.controller_name
  item_class = "block whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold"
  active_class = "bg-primary-100 text-primary-900 dark:bg-primary-900 dark:text-primary-100"
  idle_class = "text-muted hover:bg-cream-100 hover:text-body dark:hover:bg-cream-surface"
  soon_pill_class = "shrink-0 rounded-full bg-cream-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-muted dark:bg-cream-surface"
%>
<nav aria-label="<%= t(".title") %>" class="mb-8 lg:mb-0">
  <ul class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:gap-1 lg:overflow-visible lg:pb-0">
    <li class="shrink-0 lg:w-full">
      <%# TODO Phase 4: link to the seller dashboard once it exists. %>
      <span class="<%= "#{item_class} #{idle_class}" %> flex cursor-default items-center justify-between gap-2 opacity-60"
            aria-disabled="true">
        <span><%= t(".dashboard") %></span>
        <span class="<%= soon_pill_class %>"><%= t("account_menu.soon") %></span>
      </span>
    </li>
    <% sections.each do |section, label, path| %>
      <li class="shrink-0 lg:w-full">
        <%= link_to label, path,
              aria: { current: ("page" if active == section) },
              class: class_names(
                item_class,
                active_class => active == section,
                idle_class => active != section
              ) %>
      </li>
    <% end %>
  </ul>
</nav>
