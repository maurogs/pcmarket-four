<%= turbo_stream.replace "newsletter-form-status" do %>
  <div role="status" class="rounded-lg border px-3 py-2 text-xs <%= @success ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-500/30 dark:bg-emerald-950/60 dark:text-emerald-200" : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-500/30 dark:bg-rose-950/60 dark:text-rose-200" %>">
    <%= @message %>
  </div>
<% end %>
