<div class="mx-auto max-w-5xl space-y-5">
  <%= render "admin/shared/page_header", title: t("admin.settings.title"),
             subtitle: t("admin.settings.subtitle"), eyebrow: t("admin.nav.sections.settings") %>

  <%= form_with url: admin_save_settings_path, method: :patch, class: "space-y-4",
                data: { controller: "maintenance-toggle", action: "submit->maintenance-toggle#confirm" } do |form| %>
    <% @groups.each do |group, keys| %>
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.settings.groups.#{group}") %></h2>
        <div class="mt-3 divide-y divide-slate-100 dark:divide-zinc-800">
          <% keys.each do |key| %>
            <% type = Setting.type_for(key) %>
            <% limits = Setting.limits_for(key) %>
            <% value = @values[key] %>
            <div class="grid grid-cols-1 gap-2 py-3 sm:grid-cols-[1fr_16rem] sm:items-center">
              <div>
                <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-slate-900 dark:text-white">
                  <%= t("admin.settings.keys.#{key}.label") %>
                  <% if Setting.feature_flag?(key) %>
                    <span class="<%= ui_badge_classes(tone: :accent, extra: '!px-2 !py-0.5') %>"><%= t("admin.settings.feature_flag") %></span>
                  <% end %>
                </p>
                <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.settings.keys.#{key}.help") %></p>
              </div>
              <div>
                <% case type %>
                <% when "boolean" %>
                  <label class="flex cursor-pointer items-center gap-2">
                    <%= hidden_field_tag "settings[#{key}]", "0", id: nil %>
                    <%= check_box_tag "settings[#{key}]", "1", ActiveModel::Type::Boolean.new.cast(value),
                                      id: "settings_#{key}",
                                      class: "size-5 rounded text-brand-700 focus:ring-brand-500",
                                      data: key == "maintenance_mode" ? { maintenance_toggle_target: "toggle", confirm_message: t("admin.settings.maintenance_confirm") } : {} %>
                    <span class="text-xs font-medium text-slate-600 dark:text-zinc-300"><%= t("admin.settings.toggle") %></span>
                  </label>
                <% when "integer" %>
                  <%= number_field_tag "settings[#{key}]", value, id: "settings_#{key}",
                                       min: limits&.fetch(:min, nil), max: limits&.fetch(:max, nil), step: 1,
                                       class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
                <% when "decimal" %>
                  <%= number_field_tag "settings[#{key}]", value, id: "settings_#{key}",
                                       min: limits&.fetch(:min, nil), max: limits&.fetch(:max, nil), step: "0.1",
                                       class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
                <% else %>
                  <% if key.in?(%w[blocked_words bank_iban]) %>
                    <%= text_area_tag "settings[#{key}]", value, id: "settings_#{key}", rows: 3,
                                      class: ui_input_classes("!text-sm") %>
                  <% else %>
                    <%= text_field_tag "settings[#{key}]", value, id: "settings_#{key}",
                                       class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
                  <% end %>
                <% end %>
                <% if limits %>
                  <p class="mt-1 text-[10px] text-slate-400 dark:text-zinc-500"><%= t("admin.settings.range", min: limits[:min], max: limits[:max]) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <div class="sticky bottom-4 flex justify-end">
      <%= form.submit t("admin.actions.save"), class: ui_button_classes(variant: :primary, size: :md) %>
    </div>
  <% end %>
</div>
