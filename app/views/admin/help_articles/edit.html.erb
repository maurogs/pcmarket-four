<div class="mx-auto max-w-4xl space-y-5">
  <%= render "admin/shared/page_header", title: @article.title,
             subtitle: t("admin.help_articles.edit_subtitle"), back_path: admin_help_articles_path,
             back_label: t("admin.nav.help_articles") %>
  <%= render "admin/help_articles/form" %>
  <section class="rounded-xl border border-rose-200 bg-rose-50/60 p-4 dark:border-rose-500/30 dark:bg-rose-500/5">
    <%= button_to t("admin.help_articles.delete"), admin_help_article_path(@article), method: :delete,
                  form: { data: { turbo_confirm: t("admin.help_articles.confirm_delete") } },
                  class: ui_button_classes(variant: :danger, size: :sm) %>
  </section>
</div>
