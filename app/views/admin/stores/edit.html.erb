<div class="mx-auto max-w-3xl space-y-5">
  <%= render "admin/shared/page_header", title: t("admin.stores.edit.title"),
             subtitle: t("admin.stores.edit.subtitle", name: @store.name),
             back_path: admin_store_path(@store), back_label: t("admin.actions.back_to_store") %>

  <% if @store.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
      <ul class="list-inside list-disc"><% @store.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: @store, url: admin_store_path(@store), method: :patch, class: "space-y-4" do |form| %>
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.edit.details") %></h2>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :name, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_field :name, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div>
          <%= form.label :store_type, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.select :store_type, Store.store_types.keys.map { |type| [ t("admin.store_types.#{type}"), type ] },
                          {}, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div>
          <%= form.label :company_name, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_field :company_name, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div>
          <%= form.label :tax_id, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_field :tax_id, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div class="sm:col-span-2">
          <%= form.label :description, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_area :description, rows: 4, class: ui_input_classes("!text-sm") %>
        </div>
        <div>
          <%= form.label :country_code, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.select :country_code, Country.enabled.order(:code).map { |country| [ country.name, country.code ] },
                          { include_blank: true }, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div>
          <%= form.label :region_id, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.collection_select :region_id, Region.order(:name), :id, :name, { include_blank: true },
                                     class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div>
          <%= form.label :city, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_field :city, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <div class="flex items-center gap-2">
          <%= form.check_box :allow_offers_default, class: "size-4 rounded text-brand-700" %>
          <%= form.label :allow_offers_default, class: "text-sm" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.edit.vacation") %></h2>
      <div class="mt-3 space-y-3">
        <div class="flex items-center gap-2">
          <%= form.check_box :vacation_mode, class: "size-4 rounded text-brand-700" %>
          <%= form.label :vacation_mode, class: "text-sm" %>
        </div>
        <div>
          <%= form.label :vacation_message, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_area :vacation_message, rows: 2, class: ui_input_classes("!text-sm") %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.edit.policies") %></h2>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :return_policy, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_area :return_policy, rows: 4, class: ui_input_classes("!text-sm") %>
        </div>
        <div>
          <%= form.label :shipping_policy, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_area :shipping_policy, rows: 4, class: ui_input_classes("!text-sm") %>
        </div>
      </div>
    </section>

    <div class="flex items-center justify-end gap-2">
      <%= link_to t("admin.actions.cancel"), admin_store_path(@store), class: ui_button_classes(variant: :ghost, size: :md) %>
      <%= form.submit t("admin.actions.save"), class: ui_button_classes(variant: :primary, size: :md) %>
    </div>
  <% end %>
</div>
