<div class="mx-auto max-w-[90rem] space-y-5">
  <%= render "admin/shared/detail_header", title: @store.name,
             subtitle: t("admin.stores.show.subtitle", owner: @store.user.display_name),
             back_path: admin_stores_path,
             secondary_actions: [ { label: t("admin.actions.edit"), path: edit_admin_store_path(@store), variant: :primary } ],
             actions: [
               (@store.verified? ? { label: t("admin.actions.unverify"), path: admin_store_verification_path(@store), method: :delete } : { label: t("admin.actions.verify"), path: admin_store_verification_path(@store), method: :post }),
               (@store.vacation_mode? ? { label: t("admin.actions.end_vacation"), path: admin_store_vacation_path(@store), method: :delete } : { label: t("admin.actions.start_vacation"), path: admin_store_vacation_path(@store), method: :post })
             ] %>

  <div class="flex flex-wrap items-center gap-2">
    <span class="<%= ui_badge_classes(tone: :brand) %>"><%= t("admin.store_types.#{@store.store_type}") %></span>
    <% if @store.verified? %>
      <span class="<%= ui_badge_classes(tone: :success) %>"><%= icon "badge-check", class: "size-3" %><%= t("admin.stores.verified_badge") %></span>
    <% end %>
    <% if @store.vacation_mode? %>
      <span class="<%= ui_badge_classes(tone: :accent) %>"><%= t("admin.stores.on_vacation") %></span>
    <% end %>
    <%= link_to @store.user.display_name, admin_user_path(@store.user), class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
  </div>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="space-y-4">
      <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <%= render "admin/shared/stat_card", label: t("admin.stores.show.listings"), value: admin_number(@store.listings_count), hint: t("admin.users.show.total") %>
        <%= render "admin/shared/stat_card", label: t("admin.stores.show.sales"), value: admin_number(@store.sales_count), hint: t("admin.users.show.total") %>
        <%= render "admin/shared/stat_card", label: t("admin.stores.show.rating"), value: number_with_precision(@store.rating_avg, precision: 1), hint: t("admin.stores.show.reviews_count", count: @store.reviews_count) %>
        <%= render "admin/shared/stat_card", label: t("admin.stores.show.followers"), value: admin_number(@store.followers_count), hint: t("admin.users.show.total") %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.show.about") %></h2>
        <p class="mt-2 whitespace-pre-line text-sm text-slate-700 dark:text-zinc-300"><%= @store.description.presence || t("admin.stores.show.no_description") %></p>
        <dl class="mt-3 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.company") %></dt><dd class="font-medium"><%= @store.company_name.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.tax_id") %></dt><dd class="font-medium"><%= @store.tax_id.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.location") %></dt><dd class="font-medium"><%= @store.location.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.completeness") %></dt><dd class="font-medium"><%= @store.completeness %>%</dd></div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.show.listings_title") %></h2>
        <% if @listings.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.no_listings") %></p>
        <% else %>
          <ul class="mt-2 divide-y divide-slate-100 text-sm dark:divide-zinc-800">
            <% @listings.each do |listing| %>
              <li class="flex items-center justify-between gap-3 py-2">
                <div class="min-w-0">
                  <%= link_to listing.title, admin_listing_path(listing), class: "block truncate font-medium hover:text-brand-700 dark:hover:text-brand-300" %>
                  <span class="text-[11px] text-slate-500 dark:text-zinc-400"><%= listing.category.name %> · <%= admin_datetime(listing.created_at) %></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs tabular-nums"><%= format_price(listing.price_cents) %></span>
                  <%= render "admin/shared/status_badge", text: t("listings.statuses.#{listing.status}"), tone: admin_listing_status_tone(listing.status) %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.show.orders") %></h2>
        <% if @orders.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.stores.show.no_orders") %></p>
        <% else %>
          <ul class="mt-2 divide-y divide-slate-100 text-sm dark:divide-zinc-800">
            <% @orders.each do |order| %>
              <li class="flex items-center justify-between gap-3 py-2">
                <span class="font-mono text-xs"><%= order.number %></span>
                <span class="text-xs text-slate-500 dark:text-zinc-400"><%= order.buyer&.display_name || order.buyer_email %></span>
                <span class="text-xs tabular-nums"><%= admin_money(order.total_cents) %></span>
                <%= render "admin/shared/status_badge", text: t("orders.statuses.#{order.status}"), tone: admin_order_status_tone(order.status) %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.stores.show.history") %></h2>
        <% if @audit_logs.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.common.no_history") %></p>
        <% else %>
          <ol class="mt-2 space-y-2 text-sm">
            <% @audit_logs.each do |log| %>
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-100 px-3 py-2 dark:border-zinc-800">
                <span class="font-medium"><%= admin_audit_action_label(log.action) %></span>
                <span class="text-[11px] text-slate-500 dark:text-zinc-400"><%= log.admin.display_name %> · <%= admin_datetime(log.created_at) %></span>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <%= render "admin/shared/meta_panel", title: t("admin.stores.show.summary"), rows: [
        [ t("admin.stores.columns.owner"), link_to(@store.user.display_name, admin_user_path(@store.user), class: "text-brand-700 hover:underline dark:text-brand-300") ],
        [ t("admin.stores.columns.type"), t("admin.store_types.#{@store.store_type}") ],
        [ t("admin.stores.show.slug"), @store.slug ],
        [ t("admin.stores.show.created"), admin_date(@store.created_at) ],
        [ t("admin.stores.show.vacation_message"), @store.vacation_message.presence || "—" ]
      ] %>

      <%= render "admin/shared/meta_panel", title: t("admin.stores.show.policies"), rows: [
        [ t("admin.stores.show.return_policy"), @store.return_policy.present? ? t("admin.common.yes") : t("admin.common.no") ],
        [ t("admin.stores.show.shipping_policy"), @store.shipping_policy.present? ? t("admin.common.yes") : t("admin.common.no") ]
      ] %>
    </aside>
  </div>
</div>
