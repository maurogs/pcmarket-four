<div class="mx-auto max-w-5xl space-y-5">
  <%= render "admin/shared/page_header", title: @page.title,
             subtitle: t("admin.legal_pages.edit_subtitle", slug: @page.slug, language: @page.locale.upcase),
             back_path: admin_legal_pages_path, back_label: t("admin.nav.legal_pages") %>

  <% if @copy_sources.any? %>
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="font-heading text-sm font-semibold"><%= t("admin.legal_pages.copy.title") %></h2>
      <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.legal_pages.copy.hint") %></p>
      <%= form_with url: edit_admin_legal_page_path(id: @page.id), method: :get, class: "mt-2 flex flex-wrap items-end gap-2" do |form| %>
        <div class="min-w-64 flex-1">
          <%= select_tag :copy_from,
                         options_from_collection_for_select(@copy_sources, :id,
                           ->(page) { "#{page.country_code.presence || '—'} · #{page.slug} · #{page.locale.upcase}" }),
                         include_blank: true, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
        <%= form.submit t("admin.legal_pages.copy.load"), class: ui_button_classes(variant: :outline, size: :sm) %>
      <% end %>
    </section>
  <% end %>

  <%= render "admin/legal_pages/form" %>

  <section class="rounded-xl border border-rose-200 bg-rose-50/60 p-4 dark:border-rose-500/30 dark:bg-rose-500/5">
    <%= button_to t("admin.legal_pages.delete"), admin_legal_page_path(id: @page.id), method: :delete,
                  form: { data: { turbo_confirm: t("admin.legal_pages.confirm_delete") } },
                  class: ui_button_classes(variant: :danger, size: :sm) %>
  </section>
</div>
