<div class="mx-auto max-w-[90rem]">
  <%= render "admin/shared/page_header", title: t("admin.feature_requests.title"),
             subtitle: t("admin.feature_requests.subtitle"), eyebrow: t("admin.nav.sections.marketing") %>

  <div class="mt-4">
    <%= render "admin/shared/filter_bar", url: admin_feature_requests_path, fields: [
      { name: "status", type: :select, value: params[:status],
        options: FeatureRequest.statuses.keys.map { |status| [ t("admin.feature_requests.statuses.#{status}"), status ] },
        include_blank: t("admin.feature_requests.all_statuses"), label: t("admin.feature_requests.status"), width: "min-w-40" }
    ] %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <table class="w-full min-w-[52rem] text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400">
        <tr>
          <th class="px-3 py-2.5"><%= t("admin.feature_requests.columns.listing") %></th>
          <th class="px-3 py-2.5"><%= t("admin.feature_requests.columns.seller") %></th>
          <th class="px-3 py-2.5 text-right"><%= t("admin.feature_requests.columns.days") %></th>
          <th class="px-3 py-2.5 text-right"><%= t("admin.feature_requests.columns.price") %></th>
          <th class="px-3 py-2.5"><%= t("admin.feature_requests.columns.status") %></th>
          <th class="px-3 py-2.5"><%= t("admin.feature_requests.columns.requested") %></th>
          <th class="px-3 py-2.5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
        <% @requests.each do |request| %>
          <tr class="hover:bg-slate-50/70 dark:hover:bg-zinc-800/40">
            <td class="px-3 py-2.5">
              <%= link_to request.listing.title, admin_listing_path(request.listing),
                          class: "font-medium text-brand-700 hover:underline dark:text-brand-300" %>
            </td>
            <td class="px-3 py-2.5"><%= request.user.display_name %></td>
            <td class="px-3 py-2.5 text-right tabular-nums"><%= request.days %></td>
            <td class="px-3 py-2.5 text-right"><%= admin_money(request.price_cents) %></td>
            <td class="px-3 py-2.5">
              <span class="<%= ui_badge_classes(tone: request.active? ? :success : (request.pending? ? :accent : :neutral), extra: '!px-2 !py-0.5') %>">
                <%= t("admin.feature_requests.statuses.#{request.status}") %>
              </span>
            </td>
            <td class="px-3 py-2.5 text-xs text-slate-500 dark:text-zinc-400"><%= admin_datetime(request.created_at) %></td>
            <td class="px-3 py-2.5 text-right">
              <% if request.pending? %>
                <%= button_to t("admin.feature_requests.approve"), admin_feature_request_approval_path(request),
                              method: :post,
                              form: { data: { turbo_confirm: t("admin.feature_requests.confirm_approve") } },
                              class: ui_button_classes(variant: :primary, size: :sm) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @requests.empty? %>
    <div class="mt-3"><%= render "admin/shared/empty_state", title: t("admin.feature_requests.empty_title"), body: t("admin.feature_requests.empty_body") %></div>
  <% end %>
  <%= render "admin/shared/pagination", pagy: @pagy %>
</div>
