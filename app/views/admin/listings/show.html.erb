<% actions = [
  { label: t("admin.actions.edit"), path: edit_admin_listing_path(@listing) }
] %>
<% actions << { label: t("admin.actions.view_public"), path: listing_path(@listing) } if @listing.visible? %>
<% actions << { label: t("admin.actions.delete"), path: admin_listing_path(@listing), method: :delete, danger: true,
                confirm: t("admin.listings.confirm.delete") } if policy([ :admin, @listing ]).destroy? %>

<div class="mx-auto max-w-[90rem] space-y-5">
  <%= render "admin/shared/detail_header", title: @listing.title,
             subtitle: t("admin.listings.show.subtitle", id: @listing.id, category: @listing.category.name),
             back_path: admin_listings_path,
             secondary_actions: [ { label: t("admin.actions.edit"), path: edit_admin_listing_path(@listing), variant: :primary } ],
             actions: actions %>

  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/shared/status_badge", text: t("listings.statuses.#{@listing.status}"),
               tone: admin_listing_status_tone(@listing.status) %>
    <% if @listing.featured? %>
      <span class="<%= ui_badge_classes(tone: :accent) %>"><%= icon "sparkles", class: "size-3" %><%= t("listings.labels.featured") %></span>
    <% end %>
    <% if @flags.suspicious_price? %>
      <span class="<%= ui_badge_classes(tone: :danger) %>"><%= icon "flame", class: "size-3" %><%= t("admin.moderation.flags.suspicious_price") %></span>
    <% end %>
    <% if @flags.safety[:flagged] %>
      <span class="<%= ui_badge_classes(tone: :accent) %>"><%= icon "shield-check", class: "size-3" %><%= t("admin.moderation.flags.safety_short") %></span>
    <% end %>
    <% if @flags.duplicate? %>
      <span class="<%= ui_badge_classes(tone: :danger) %>"><%= t("admin.moderation.flags.duplicate", count: @flags.duplicate_listings.size) %></span>
    <% end %>
    <span class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.show.created", time: admin_datetime(@listing.created_at)) %></span>
    <span class="text-xs text-slate-500 dark:text-zinc-400">·</span>
    <span class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.show.updated", time: admin_datetime(@listing.updated_at)) %></span>
  </div>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="space-y-4">
      <% if @listing.pending_review? %>
        <section class="rounded-xl border border-amber-300 bg-amber-50 p-4 dark:border-amber-500/40 dark:bg-amber-500/10">
          <h2 class="font-heading text-sm font-semibold text-amber-950 dark:text-amber-100"><%= t("admin.listings.show.moderation_title") %></h2>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-start">
            <%= button_to admin_listing_approval_path(@listing), method: :post,
                          class: ui_button_classes(variant: :primary, size: :sm) do %>
              <%= icon "check", class: "size-4" %><%= t("admin.actions.approve") %>
            <% end %>
            <%= button_to admin_listing_approval_path(@listing, feature_days: 7), method: :post,
                          class: ui_button_classes(variant: :accent, size: :sm) do %>
              <%= icon "sparkles", class: "size-4" %><%= t("admin.moderation.approve_feature") %>
            <% end %>
            <%= form_with url: admin_listing_rejection_path(@listing), method: :post,
                          class: "flex flex-1 flex-wrap items-start gap-2" do %>
              <%= select_tag :reason,
                             options_for_select(Admin::ListingRejectionsController::PRESET_REASONS.map { |reason| [ t("admin.moderation.reasons.#{reason}"), reason ] }),
                             include_blank: t("admin.moderation.reason_placeholder"),
                             class: ui_input_classes("!min-h-9 !w-auto !py-1.5 !text-sm") %>
              <%= text_field_tag :other_reason, nil, placeholder: t("admin.moderation.other_reason"),
                                 class: ui_input_classes("!min-h-9 !w-48 !py-1.5 !text-sm") %>
              <%= button_tag type: "submit", class: ui_button_classes(variant: :danger, size: :sm) do %>
                <%= icon "x", class: "size-4" %><%= t("admin.actions.reject") %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% elsif @listing.rejected? && @listing.rejection_reason.present? %>
        <section class="rounded-xl border border-rose-200 bg-rose-50 p-4 dark:border-rose-500/30 dark:bg-rose-500/10">
          <h2 class="font-heading text-sm font-semibold text-rose-900 dark:text-rose-200"><%= t("admin.listings.show.rejection_title") %></h2>
          <p class="mt-1 text-sm text-rose-800 dark:text-rose-300"><%= @listing.rejection_reason %></p>
          <p class="mt-1 text-xs text-rose-600 dark:text-rose-400"><%= t("admin.listings.show.reviewed_by", name: @listing.reviewer&.display_name || "—", time: admin_datetime(@listing.reviewed_at)) %></p>
        </section>
      <% end %>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.show.images") %></h2>
        <% images = @listing.ordered_images %>
        <% if images.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.moderation.no_images") %></p>
        <% else %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% images.each do |image| %>
              <%= link_to url_for(image), target: "_blank", rel: "noopener",
                          class: "block size-24 overflow-hidden rounded-lg border border-slate-200 dark:border-zinc-700" do %>
                <%= image_tag image.variant(resize_to_limit: [ 240, 240 ], format: :webp),
                              alt: @listing.title, loading: "lazy", class: "size-24 object-cover" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.show.description") %></h2>
        <p class="mt-2 whitespace-pre-line text-sm text-slate-700 dark:text-zinc-300"><%= @listing.description %></p>

        <% if @flags.safety[:flagged] %>
          <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
            <%= t("admin.listings.show.safety_warning") %>
            <ul class="mt-1 list-inside list-disc">
              <% @flags.safety_reasons.each do |reason| %>
                <li><%= t("admin.moderation.safety.#{reason}") %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.condition") %></dt><dd class="font-medium"><%= listing_condition_label(@listing) %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.brand") %></dt><dd class="font-medium"><%= @listing.brand.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.model") %></dt><dd class="font-medium"><%= @listing.model_name_text.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.quantity") %></dt><dd class="font-medium"><%= @listing.quantity %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.shipping") %></dt><dd class="font-medium"><%= @listing.shipping_available? ? format_price(@listing.shipping_price_cents) : t("admin.listings.show.pickup_only") %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.location") %></dt><dd class="font-medium"><%= @listing.location.presence || "—" %></dd></div>
          <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.listings.form.accepts_offers") %></dt><dd class="font-medium"><%= @listing.accepts_offers? ? t("admin.common.yes") : t("admin.common.no") %></dd></div>
        </dl>
      </section>

      <% if @listing.specs.present? %>
        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.form.specs") %></h2>
          <dl class="mt-2 grid grid-cols-2 gap-2 text-sm sm:grid-cols-3">
            <% @listing.specs.each do |key, value| %>
              <div><dt class="text-xs text-slate-500 dark:text-zinc-400"><%= key %></dt><dd class="font-medium"><%= Array(value).join(", ") %></dd></div>
            <% end %>
          </dl>
        </section>
      <% end %>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.show.orders") %></h2>
        <% if @orders.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.listings.show.no_orders") %></p>
        <% else %>
          <div class="mt-2 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="text-[11px] uppercase tracking-wide text-slate-500 dark:text-zinc-400">
                <tr><th class="py-2"><%= t("admin.listings.show.order_number") %></th><th class="py-2"><%= t("admin.listings.show.order_buyer") %></th><th class="py-2"><%= t("admin.listings.show.order_status") %></th><th class="py-2 text-right"><%= t("admin.listings.show.order_total") %></th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
                <% @orders.each do |order| %>
                  <tr>
                    <td class="py-2 font-mono text-xs"><%= order.number %></td>
                    <td class="py-2"><%= order.buyer&.display_name || order.buyer_email %></td>
                    <td class="py-2"><%= render "admin/shared/status_badge", text: t("orders.statuses.#{order.status}"), tone: admin_order_status_tone(order.status) %></td>
                    <td class="py-2 text-right tabular-nums"><%= admin_money(order.total_cents) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.show.reports") %></h2>
        <% if @reports.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.listings.show.no_reports") %></p>
        <% else %>
          <ul class="mt-2 space-y-2 text-sm">
            <% @reports.each do |report| %>
              <li class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-medium"><%= t("admin.reports.reasons.#{report.reason}") %></p>
                  <p class="text-xs text-slate-500 dark:text-zinc-400"><%= report.reporter.display_name %> · <%= admin_datetime(report.created_at) %></p>
                </div>
                <%= render "admin/shared/status_badge", text: t("admin.reports.statuses.#{report.status}"), tone: admin_report_status_tone(report.status) %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <section id="history" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.listings.show.history") %></h2>
        <% if @audit_logs.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.common.no_history") %></p>
        <% else %>
          <ol class="mt-2 space-y-2 text-sm">
            <% @audit_logs.each do |log| %>
              <li class="rounded-lg border border-slate-100 px-3 py-2 dark:border-zinc-800">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="font-medium"><%= admin_audit_action_label(log.action) %></p>
                  <p class="text-[11px] text-slate-500 dark:text-zinc-400"><%= log.admin.display_name %> · <%= admin_datetime(log.created_at) %></p>
                </div>
                <% if log.changeset.present? %>
                  <p class="mt-1 font-mono text-[11px] text-slate-500 dark:text-zinc-400"><%= log.changeset.to_json.truncate(160) %></p>
                <% end %>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <%= render "admin/shared/meta_panel", title: t("admin.listings.show.pricing"), rows: [
        [ t("admin.listings.show.price"), format_price(@listing.price_cents) ],
        [ t("admin.listings.show.original_price"), @listing.original_price_cents.present? ? format_price(@listing.original_price_cents) : "—" ],
        [ t("admin.listings.show.median"), @flags.price_median_cents.to_i.positive? ? format_price(@flags.price_median_cents) : "—" ],
        [ t("admin.listings.show.currency"), @listing.currency ]
      ] %>

      <%= render "admin/shared/meta_panel", title: t("admin.listings.show.stats"), rows: [
        [ t("admin.listings.columns.views"), admin_number(@listing.views_count) ],
        [ t("admin.listings.show.favourites"), admin_number(@listing.favorites_count) ],
        [ t("admin.listings.show.performance"), @listing.performance_score.presence || "—" ],
        [ t("admin.listings.show.featured_until"), @listing.featured_until.present? ? admin_datetime(@listing.featured_until) : "—" ]
      ] %>

      <%= render "admin/shared/meta_panel", title: t("admin.listings.show.seller"), rows: [
        [ t("admin.listings.form.seller"), link_to(@listing.user.display_name, admin_user_path(@listing.user), class: "text-brand-700 hover:underline dark:text-brand-300") ],
        [ t("admin.listings.show.store"), @listing.store ? link_to(@listing.store.name, admin_store_path(@listing.store), class: "text-brand-700 hover:underline dark:text-brand-300") : "—" ],
        [ t("admin.moderation.seller.account_age"), t("admin.moderation.days", count: @flags.seller.account_age_days) ],
        [ t("admin.moderation.seller.sales"), @flags.seller.completed_sales ],
        [ t("admin.moderation.seller.rejections"), @flags.seller.previous_rejections ],
        [ t("admin.moderation.seller.verified"), @flags.seller.verified ? t("admin.common.yes") : t("admin.common.no") ]
      ] %>

      <% if @flags.duplicate? %>
        <section class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm dark:border-rose-500/30 dark:bg-rose-500/10">
          <h2 class="font-heading text-sm font-semibold text-rose-900 dark:text-rose-200"><%= t("admin.moderation.flags.duplicate", count: @flags.duplicate_listings.size) %></h2>
          <ul class="mt-2 space-y-1">
            <% @flags.duplicate_listings.each do |other| %>
              <li><%= link_to other.title, admin_listing_path(other), class: "text-rose-800 underline decoration-dotted hover:no-underline dark:text-rose-300" %></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <%= render "admin/shared/meta_panel", title: t("admin.listings.show.meta"), rows: [
        [ t("admin.listings.show.id"), @listing.id ],
        [ t("admin.listings.show.slug"), @listing.slug ],
        [ t("admin.listings.show.country"), @listing.country_code ],
        [ t("admin.listings.show.labels"), @listing.labels.any? ? @listing.labels.map { |label| t("listings.labels.#{label}") }.join(", ") : "—" ],
        [ t("admin.listings.show.reviewed_at"), @listing.reviewed_at.present? ? admin_datetime(@listing.reviewed_at) : "—" ]
      ] %>
    </aside>
  </div>
</div>
