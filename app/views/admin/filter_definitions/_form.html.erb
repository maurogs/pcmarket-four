<%= form_with model: [ :admin, @filter ], class: "space-y-4" do |form| %>
  <% if @filter.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
      <ul class="list-inside list-disc"><% @filter.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <%= form.label :key, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.text_field :key, disabled: @filter.persisted?,
                            class: ui_input_classes("!min-h-9 !py-1.5 !text-sm font-mono"),
                            placeholder: "gpu_brand" %>
        <% if @filter.persisted? %>
          <p class="mt-1 text-xs text-amber-700 dark:text-amber-300"><%= t("admin.filters.form.key_locked") %></p>
        <% else %>
          <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.filters.form.key_hint") %></p>
        <% end %>
      </div>
      <div>
        <%= form.label :input_type, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.select :input_type,
                        FilterDefinition.input_types.keys.map { |type| [ t("admin.filters.input_types.#{type}"), type ] },
                        {}, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div>
        <%= form.label :unit, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.text_field :unit, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div>
        <%= form.label :position, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.number_field :position, min: 0, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div class="flex items-end pb-1">
        <label class="flex items-center gap-2 text-sm"><%= form.check_box :active, class: "size-4 rounded text-brand-700" %><%= t("admin.categories.active") %></label>
      </div>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.filters.form.names") %></h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% I18n.available_locales.each do |locale| %>
        <div>
          <%= label_tag "filter_names_#{locale}", t("admin.categories.form.name_for", code: locale.to_s.upcase),
                        class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= text_field_tag "filter_definition[names][#{locale}]", @filter.names[locale.to_s],
                             id: "filter_names_#{locale}", required: %w[es en].include?(locale.to_s),
                             class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.filters.form.categories") %></h2>
    <%= hidden_field_tag "filter_definition[category_ids][]", "", id: nil %>
    <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% assigned = @filter.category_ids %>
      <% Category.order(:ancestry, :position, :id).each do |category| %>
        <label class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-zinc-700">
          <%= check_box_tag "filter_definition[category_ids][]", category.id, assigned.include?(category.id),
                            id: "filter_category_#{category.id}", class: "size-4 rounded text-brand-700" %>
          <%= category.is_root? ? category.name : "— #{category.name}" %>
        </label>
      <% end %>
    </div>
  </section>

  <div class="flex items-center justify-end gap-2">
    <%= link_to t("admin.actions.cancel"), admin_filter_definitions_path, class: ui_button_classes(variant: :ghost, size: :md) %>
    <%= form.submit t("admin.actions.save"), class: ui_button_classes(variant: :primary, size: :md) %>
  </div>
<% end %>
