<div class="mx-auto max-w-5xl space-y-5">
  <%= render "admin/shared/page_header", title: t("admin.filters.edit_title", name: @filter.name),
             subtitle: t("admin.filters.edit_subtitle", key: @filter.key),
             back_path: admin_filter_definitions_path, back_label: t("admin.nav.filters") %>

  <%= render "admin/filter_definitions/form" %>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.filters.options.title") %></h2>
        <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.filters.options.hint") %></p>
      </div>
    </div>

    <% if @options.any? %>
      <div class="mt-3" data-controller="sortable-list"
           data-sortable-url-value="<%= admin_filter_option_positions_path %>"
           data-sortable-parent-value=""
           data-filter-definition-id="<%= @filter.id %>">
        <ul class="space-y-2" data-sortable-list data-action="dragover->sortable-list#dragOver">
          <% @options.each do |option| %>
            <li data-sortable-id="<%= option.id %>" data-sortable-parent="" draggable="true"
                data-action="dragstart->sortable-list#dragStart dragend->sortable-list#dragEnd"
                class="rounded-lg border border-slate-200 p-3 dark:border-zinc-700">
              <div class="flex flex-wrap items-center gap-2">
                <span class="cursor-grab text-slate-400"><%= icon "menu", class: "size-4" %></span>
                <span class="font-mono text-xs text-slate-500 dark:text-zinc-400"><%= option.value %></span>
                <span class="text-sm font-medium text-slate-900 dark:text-white"><%= option.label %></span>
                <span class="<%= ui_badge_classes(tone: :neutral, extra: '!px-2 !py-0.5') %>">
                  <%= t("admin.filters.options.usage", count: @usage_counts[option.value].to_i) %>
                </span>
                <div class="ml-auto flex items-center gap-1">
                  <button type="button" data-action="sortable-list#moveUp" class="rounded p-1 text-slate-500 hover:bg-slate-100 dark:hover:bg-zinc-800" aria-label="<%= t("admin.categories.move_up") %>"><%= icon "chevron-up", class: "size-4" %></button>
                  <button type="button" data-action="sortable-list#moveDown" class="rounded p-1 text-slate-500 hover:bg-slate-100 dark:hover:bg-zinc-800" aria-label="<%= t("admin.categories.move_down") %>"><%= icon "chevron-down", class: "size-4" %></button>
                  <%= button_to t("admin.actions.delete"),
                                admin_filter_definition_filter_option_path(@filter, option),
                                method: :delete,
                                form: { data: { turbo_confirm: t("admin.filters.options.confirm_delete") } },
                                class: ui_button_classes(variant: :ghost, size: :sm, extra: "!text-rose-600") %>
                </div>
              </div>

              <%= form_with model: [ :admin, @filter, option ], class: "mt-2 grid grid-cols-1 gap-2 sm:grid-cols-4" do |form| %>
                <div>
                  <%= form.label :value, class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
                  <%= form.text_field :value, class: ui_input_classes("!min-h-8 !py-1 !text-xs font-mono") %>
                </div>
                <% %w[es en fr de it pt].each do |locale| %>
                  <div>
                    <%= label_tag "option_#{option.id}_labels_#{locale}", locale.upcase,
                                  class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
                    <%= text_field_tag "filter_option[labels][#{locale}]", option.labels[locale],
                                       id: "option_#{option.id}_labels_#{locale}",
                                       class: ui_input_classes("!min-h-8 !py-1 !text-xs") %>
                  </div>
                <% end %>
                <div class="sm:col-span-4 flex justify-end">
                  <%= form.submit t("admin.actions.save"), class: ui_button_classes(variant: :outline, size: :sm) %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="mt-3 rounded-lg border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-zinc-700 dark:text-zinc-400">
        <%= t("admin.filters.options.empty") %>
      </p>
    <% end %>

    <%= form_with url: admin_filter_definition_filter_options_path(@filter), method: :post, class: "mt-3 grid grid-cols-1 gap-2 sm:grid-cols-6" do |form| %>
      <div class="sm:col-span-2">
        <%= form.label :value, t("admin.filters.options.value"), class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
        <%= text_field_tag "filter_option[value]", nil, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm font-mono") %>
      </div>
      <% %w[es en fr de it pt].each do |locale| %>
        <div>
          <%= label_tag "new_option_label_#{locale}", locale.upcase, class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
          <%= text_field_tag "filter_option[labels][#{locale}]", nil, id: "new_option_label_#{locale}",
                             class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
        </div>
      <% end %>
      <div class="sm:col-span-6 flex justify-end">
        <%= form.submit t("admin.filters.options.add"), class: ui_button_classes(variant: :primary, size: :sm) %>
      </div>
    <% end %>

    <div class="mt-6 grid grid-cols-1 gap-4 border-t border-slate-200 pt-4 lg:grid-cols-2 dark:border-zinc-800">
      <%= form_with url: admin_filter_definition_bulk_path(@filter), method: :post, class: "space-y-2" do |form| %>
        <h3 class="font-heading text-sm font-semibold"><%= t("admin.filters.options.bulk_title") %></h3>
        <%= text_area_tag :values, nil, rows: 4, placeholder: t("admin.filters.options.bulk_placeholder"),
                          class: ui_input_classes("!text-sm") %>
        <%= form.submit t("admin.filters.options.bulk_submit"), class: ui_button_classes(variant: :outline, size: :sm) %>
      <% end %>

      <%= form_with url: admin_filter_definition_merge_path(@filter), method: :post, class: "space-y-2" do |form| %>
        <h3 class="font-heading text-sm font-semibold"><%= t("admin.filters.options.merge_title") %></h3>
        <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.filters.options.merge_hint") %></p>
        <div class="grid grid-cols-2 gap-2">
          <% options = @options.map { |option| [ option.label, option.value ] } %>
          <div>
            <%= label_tag :source_value, t("admin.filters.options.merge_source"), class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
            <%= select_tag :source_value, options_for_select(options), include_blank: true,
                           class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
          </div>
          <div>
            <%= label_tag :target_value, t("admin.filters.options.merge_target"), class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500" %>
            <%= select_tag :target_value, options_for_select(options), include_blank: true,
                           class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
          </div>
        </div>
        <%= form.submit t("admin.filters.options.merge_submit"), class: ui_button_classes(variant: :outline, size: :sm) %>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-rose-200 bg-rose-50/60 p-4 dark:border-rose-500/30 dark:bg-rose-500/5">
    <h2 class="font-heading text-sm font-semibold text-rose-800 dark:text-rose-200"><%= t("admin.filters.danger_title") %></h2>
    <p class="mt-1 text-xs text-rose-700 dark:text-rose-300">
      <%= t("admin.filters.danger_hint", count: @filter.listing_usage_count) %>
    </p>
    <%= form_with url: admin_filter_definition_path(@filter), method: :delete, class: "mt-2 flex flex-wrap items-end gap-2" do |form| %>
      <div>
        <%= label_tag :confirm_key, t("admin.filters.confirm_key", key: @filter.key),
                      class: "mb-1 block text-xs font-medium" %>
        <%= text_field_tag :confirm_key, nil, id: "confirm_key",
                           class: ui_input_classes("!min-h-9 !py-1.5 !text-sm font-mono") %>
      </div>
      <%= form.submit t("admin.actions.delete"), class: ui_button_classes(variant: :danger, size: :sm),
                      data: { turbo_confirm: t("admin.filters.confirm_delete") } %>
    <% end %>
  </section>
</div>
