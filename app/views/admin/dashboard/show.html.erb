<% stats = @dashboard[:stats] %>
<% charts = @dashboard[:charts] %>
<% tables = @dashboard[:tables] %>
<% health = @dashboard[:health] %>

<div class="mx-auto max-w-[90rem] space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-300"><%= t("admin.dashboard.eyebrow") %></p>
      <h1 class="mt-0.5 font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("admin.dashboard.title") %></h1>
      <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("admin.dashboard.subtitle") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to admin_moderation_queue_path, class: ui_button_classes(variant: :primary, size: :sm) do %>
        <%= icon "shield-check", class: "size-4" %><%= t("admin.dashboard.open_queue") %>
      <% end %>
      <%= link_to admin_listings_path, class: ui_button_classes(variant: :outline, size: :sm) do %>
        <%= t("admin.dashboard.all_listings") %>
      <% end %>
    </div>
  </div>

  <section aria-label="<%= t('admin.dashboard.kpis') %>"
           class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4 2xl:grid-cols-5">
    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.new_users"),
               value: admin_number(stats[:new_users][:value]),
               change: admin_percent_change(stats[:new_users][:change]),
               direction: stats[:new_users][:direction],
               hint: t("admin.dashboard.vs_previous") %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.active_listings"),
               value: admin_number(stats[:active_listings][:value]),
               hint: t("admin.dashboard.live_now") %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.pending_review"),
               value: admin_number(stats[:pending_review][:value]),
               direction: stats[:pending_review][:direction],
               hint: t("admin.dashboard.needs_attention") %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.published_today"),
               value: admin_number(stats[:published_today][:value]),
               change: admin_percent_change(stats[:published_today][:change]),
               direction: stats[:published_today][:direction],
               hint: t("admin.dashboard.vs_yesterday") %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.orders"),
               value: admin_number(stats[:orders][:value]),
               change: admin_percent_change(stats[:orders][:change]),
               direction: stats[:orders][:direction],
               hint: t("admin.dashboard.vs_previous") %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.gmv"),
               value: admin_money(stats[:gmv_cents][:value]),
               change: admin_percent_change(stats[:gmv_cents][:change]),
               direction: stats[:gmv_cents][:direction],
               hint: t("admin.dashboard.vs_previous") %>

    <% if stats[:commission_cents][:value].positive? %>
      <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.commission"),
                 value: admin_money(stats[:commission_cents][:value]),
                 change: admin_percent_change(stats[:commission_cents][:change]),
                 direction: stats[:commission_cents][:direction],
                 hint: t("admin.dashboard.vs_previous") %>
    <% end %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.open_disputes"),
               value: admin_number(stats[:open_disputes][:value]),
               direction: stats[:open_disputes][:direction],
               hint: t("admin.dashboard.needs_attention"),
               href: admin_disputes_path %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.open_reports"),
               value: admin_number(stats[:open_reports][:value]),
               direction: stats[:open_reports][:direction],
               hint: t("admin.dashboard.needs_attention"),
               href: admin_reports_path %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.pending_payments"),
               value: admin_number(stats[:pending_payments][:value]),
               direction: stats[:pending_payments][:direction],
               hint: t("admin.dashboard.needs_attention"),
               href: admin_payments_path %>

    <%= render "admin/shared/stat_card", label: t("admin.dashboard.stats.newsletter"),
               value: admin_number(stats[:newsletter_subscribers][:value]),
               change: admin_percent_change(stats[:newsletter_subscribers][:change]),
               direction: stats[:newsletter_subscribers][:direction],
               hint: t("admin.dashboard.vs_previous") %>
  </section>

  <section class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm xl:col-span-2 dark:border-zinc-800 dark:bg-zinc-900">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.charts.signups") %></h2>
        <span class="text-[11px] text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.last_30_days") %></span>
      </div>
      <%= admin_line_chart(charts[:signups], title: t("admin.dashboard.charts.signups")) %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.charts.categories") %></h2>
      </div>
      <%= admin_horizontal_bars(charts[:categories]) %>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm xl:col-span-2 dark:border-zinc-800 dark:bg-zinc-900">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.charts.orders") %></h2>
        <span class="text-[11px] text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.last_30_days") %></span>
      </div>
      <%= admin_bar_chart(charts[:orders], title: t("admin.dashboard.charts.orders")) %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.health.title") %></h2>
      <dl class="mt-3 space-y-3 text-sm">
        <div class="flex items-center justify-between gap-3">
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.health.failed_jobs") %></dt>
          <dd class="<%= health[:failed_jobs].positive? ? 'font-semibold text-rose-600 dark:text-rose-400' : 'font-medium text-slate-900 dark:text-zinc-100' %>"><%= admin_number(health[:failed_jobs]) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.health.pending_jobs") %></dt>
          <dd class="font-medium text-slate-900 dark:text-zinc-100"><%= admin_number(health[:pending_jobs]) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.health.storage") %></dt>
          <dd class="font-medium text-slate-900 dark:text-zinc-100"><%= admin_bytes(health[:storage_bytes]) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.health.database") %></dt>
          <dd class="font-medium text-slate-900 dark:text-zinc-100"><%= admin_bytes(health[:database_bytes]) %></dd>
        </div>
      </dl>
      <p class="mt-4 text-[11px] text-slate-400 dark:text-zinc-500"><%= t("admin.dashboard.health.cached") %></p>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-zinc-800">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.tables.pending") %></h2>
        <%= link_to t("admin.dashboard.view_all"), admin_moderation_queue_path,
                    class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
      </div>
      <% if tables[:pending_listings].empty? %>
        <p class="px-4 py-8 text-center text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.dashboard.all_caught_up") %></p>
      <% else %>
        <ul class="divide-y divide-slate-100 dark:divide-zinc-800">
          <% tables[:pending_listings].each do |listing| %>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="size-10 shrink-0 overflow-hidden rounded-lg bg-slate-100 dark:bg-zinc-800">
                <% thumb = listing.ordered_images.first %>
                <% if thumb %>
                  <%= image_tag thumb.variant(resize_to_limit: [ 80, 80 ], format: :webp), alt: "", loading: "lazy",
                                class: "size-10 object-cover" %>
                <% else %>
                  <%= image_tag "listing-placeholder.svg", alt: "", loading: "lazy", class: "size-10 object-cover" %>
                <% end %>
              </span>
              <div class="min-w-0 flex-1">
                <%= link_to admin_listing_path(listing), class: "line-clamp-1 text-sm font-medium text-slate-900 hover:text-brand-700 dark:text-zinc-100 dark:hover:text-brand-300" do %>
                  <%= listing.title %>
                <% end %>
                <p class="text-[11px] text-slate-500 dark:text-zinc-400">
                  <%= listing.user.display_name %> · <%= admin_money(listing.price_cents) %> · <%= relative_time(listing.created_at) %>
                </p>
              </div>
              <%= button_to t("admin.actions.approve"), admin_listing_approval_path(listing),
                            method: :post,
                            class: ui_button_classes(variant: :primary, size: :sm,
                                                     extra: "!min-h-7 !px-2 !text-[11px]") %>
              <%= button_to t("admin.actions.reject"), admin_listing_rejection_path(listing),
                            method: :post, params: { reason: "other" },
                            class: ui_button_classes(variant: :ghost, size: :sm,
                                                     extra: "!min-h-7 !px-2 !text-[11px] !text-rose-600 dark:!text-rose-400") %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-zinc-800">
          <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.tables.orders") %></h2>
          <%= link_to t("admin.dashboard.view_all"), admin_orders_path,
                      class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-zinc-800">
          <% tables[:latest_orders].each do |order| %>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
              <div class="min-w-0">
                <p class="truncate font-medium text-slate-900 dark:text-zinc-100"><%= order.number %></p>
                <p class="text-[11px] text-slate-500 dark:text-zinc-400"><%= order.buyer&.display_name || order.buyer_email %> · <%= admin_datetime(order.created_at) %></p>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold tabular-nums"><%= admin_money(order.total_cents) %></span>
                <%= render "admin/shared/status_badge", text: t("orders.statuses.#{order.status}"),
                           tone: admin_order_status_tone(order.status) %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-zinc-800">
          <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.dashboard.tables.users") %></h2>
          <%= link_to t("admin.dashboard.view_all"), admin_users_path,
                      class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-zinc-800">
          <% tables[:latest_users].each do |user| %>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <div class="flex min-w-0 items-center gap-2.5">
                <span class="flex size-7 items-center justify-center rounded-full bg-slate-200 text-[10px] font-semibold text-slate-700 dark:bg-zinc-800 dark:text-zinc-200"><%= user.initials %></span>
                <div class="min-w-0">
                  <%= link_to user.display_name, admin_user_path(user),
                              class: "block truncate text-sm font-medium text-slate-900 hover:text-brand-700 dark:text-zinc-100 dark:hover:text-brand-300" %>
                  <p class="truncate text-[11px] text-slate-500 dark:text-zinc-400"><%= user.email %></p>
                </div>
              </div>
              <span class="whitespace-nowrap text-[11px] text-slate-500 dark:text-zinc-400"><%= admin_date(user.created_at) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>
</div>
