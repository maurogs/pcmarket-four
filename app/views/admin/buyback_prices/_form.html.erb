<%= form_with model: [ :admin, @buyback_price ], class: "space-y-4" do |form| %>
  <% if @buyback_price.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200">
      <ul class="list-inside list-disc"><% @buyback_price.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :item_kind, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.select :item_kind, BuybackPrice.item_kinds.keys.map { |kind| [ t("sell_to_us.kinds.#{kind}"), kind ] },
                        {}, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div>
        <%= form.label :item_model, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.text_field :item_model, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div>
        <%= form.label :base_price_cents, t("admin.buyback_prices.columns.base_price"), class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.number_field :base_price_cents, min: 1, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
      <div>
        <%= form.label :position, class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
        <%= form.number_field :position, min: 0, class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
      </div>
    </div>
    <div class="mt-4 flex items-center gap-2">
      <%= form.check_box :active, class: "size-4 rounded text-brand-700" %>
      <%= form.label :active, t("admin.categories.active"), class: "text-sm" %>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <h2 class="text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.buyback_prices.multipliers_title") %></h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <% BuybackPrice::CONDITION_MULTIPLIERS.each_key do |condition| %>
        <div>
          <label for="buyback_price_condition_multipliers_<%= condition %>" class="mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300">
            <%= t("sell_to_us.conditions.#{condition}") %>
          </label>
          <input type="number" step="0.01" min="0.01" max="1.5"
                 id="buyback_price_condition_multipliers_<%= condition %>"
                 name="buyback_price[condition_multipliers][<%= condition %>]"
                 value="<%= @buyback_price.condition_multipliers.to_h.fetch(condition, BuybackPrice::CONDITION_MULTIPLIERS[condition]) %>"
                 class="<%= ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>">
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex justify-end gap-2">
    <%= link_to t("admin.actions.cancel"), admin_buyback_prices_path, class: ui_button_classes(variant: :ghost, size: :md) %>
    <%= form.submit t("admin.actions.save"), class: ui_button_classes(variant: :primary, size: :md) %>
  </div>
<% end %>
