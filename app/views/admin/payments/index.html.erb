<div class="mx-auto max-w-[90rem] space-y-5">
  <%= render "admin/shared/page_header", title: t("admin.payments.title"),
             subtitle: t("admin.payments.subtitle"), eyebrow: t("admin.nav.sections.marketplace") %>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-4">
      <% if @orders.empty? %>
        <%= render "admin/shared/empty_state", title: t("admin.payments.empty_title"),
                   body: t("admin.payments.empty_body") %>
      <% else %>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <table class="w-full min-w-[46rem] text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400">
              <tr>
                <th class="px-3 py-2.5"><%= t("admin.payments.columns.order") %></th>
                <th class="px-3 py-2.5"><%= t("admin.payments.columns.buyer") %></th>
                <th class="px-3 py-2.5"><%= t("admin.payments.columns.age") %></th>
                <th class="px-3 py-2.5"><%= t("admin.payments.columns.deadline") %></th>
                <th class="px-3 py-2.5 text-right"><%= t("admin.payments.columns.total") %></th>
                <th class="px-3 py-2.5"><%= t("admin.payments.columns.mark_paid") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
              <% @orders.each do |order| %>
                <% deadline = order.created_at + @deadline_days.days %>
                <tr class="align-middle hover:bg-slate-50/70 dark:hover:bg-zinc-800/40">
                  <td class="px-3 py-2.5">
                    <%= link_to order.number, admin_order_path(order),
                                class: "font-medium text-brand-700 hover:underline dark:text-brand-300" %>
                    <p class="text-[11px] text-slate-500 dark:text-zinc-400"><%= admin_datetime(order.created_at) %></p>
                  </td>
                  <td class="px-3 py-2.5 text-xs text-slate-600 dark:text-zinc-400">
                    <span class="block truncate"><%= order.buyer&.display_name || order.buyer_email %></span>
                    <span class="block truncate text-[11px]"><%= order.seller.display_name %></span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2.5 text-xs text-slate-500 dark:text-zinc-400">
                    <%= time_ago_in_words(order.created_at) %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2.5 text-xs">
                    <% if deadline > Time.current %>
                      <span class="font-medium text-emerald-700 dark:text-emerald-400">
                        <%= t("admin.payments.due_in", time: distance_of_time_in_words(Time.current, deadline)) %>
                      </span>
                    <% else %>
                      <span class="font-semibold text-rose-600 dark:text-rose-400">
                        <%= t("admin.payments.overdue", time: time_ago_in_words(deadline)) %>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2.5 text-right font-semibold tabular-nums"><%= admin_money(order.total_cents) %></td>
                  <td class="px-3 py-2.5">
                    <%= form_with url: admin_order_payment_path(order), method: :post, class: "flex items-center gap-1.5" do %>
                      <%= text_field_tag :payment_reference, nil, required: true,
                                         placeholder: t("admin.payments.reference"),
                                         class: ui_input_classes("!min-h-8 !py-1 !text-xs !w-36") %>
                      <%= button_tag type: "submit", class: ui_button_classes(variant: :primary, size: :sm, extra: "!min-h-8 !px-2 !text-xs") do %>
                        <%= t("admin.payments.mark_paid") %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "admin/shared/pagination", pagy: @pagy %>
      <% end %>
    </div>

    <aside>
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.payments.bulk.title") %></h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.payments.bulk.hint") %></p>
        <%= form_with url: admin_bulk_payments_path, method: :post, class: "mt-3 space-y-2" do %>
          <%= text_area_tag :order_numbers, nil, rows: 8, required: true,
                            placeholder: t("admin.payments.bulk.placeholder"),
                            class: ui_input_classes("!text-sm font-mono") %>
          <%= text_field_tag :payment_reference, nil, required: true,
                             placeholder: t("admin.payments.reference"),
                             class: ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>
          <%= button_tag type: "submit", class: ui_button_classes(variant: :primary, size: :sm, extra: "w-full") do %>
            <%= t("admin.payments.bulk.submit") %>
          <% end %>
        <% end %>
      </section>
    </aside>
  </div>
</div>
