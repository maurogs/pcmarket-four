<div class="mx-auto max-w-[90rem]">
  <%= render "admin/shared/page_header", title: t("admin.newsletter.title"),
             subtitle: t("admin.newsletter.subtitle"), eyebrow: t("admin.nav.sections.marketing"),
             actions: [ { label: t("admin.newsletter.export"), path: admin_newsletter_export_path(format: :csv), icon: "package" } ] %>

  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <% %i[confirmed unconfirmed unsubscribed].each do |status| %>
      <%= link_to admin_newsletter_subscribers_path(status: status),
                  class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-400 dark:border-zinc-800 dark:bg-zinc-900" do %>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("admin.newsletter.statuses.#{status}") %></p>
        <p class="mt-1 font-heading text-2xl font-bold text-slate-950 dark:text-white"><%= @counts[status] %></p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-4">
    <%= render "admin/shared/filter_bar", url: admin_newsletter_subscribers_path, fields: [
      { name: "status", type: :select, value: params[:status],
        options: %i[confirmed unconfirmed unsubscribed].map { |status| [ t("admin.newsletter.statuses.#{status}"), status ] },
        include_blank: t("admin.newsletter.all_statuses"), label: t("admin.newsletter.status"), width: "min-w-44" },
      { name: "q", type: :search, value: params[:q], placeholder: t("admin.newsletter.search_placeholder"),
        label: t("admin.newsletter.search") }
    ] %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <table class="w-full min-w-[44rem] text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400">
        <tr>
          <th class="px-3 py-2.5"><%= t("admin.newsletter.columns.email") %></th>
          <th class="px-3 py-2.5"><%= t("admin.newsletter.columns.locale") %></th>
          <th class="px-3 py-2.5"><%= t("admin.newsletter.columns.status") %></th>
          <th class="px-3 py-2.5"><%= t("admin.newsletter.columns.subscribed") %></th>
          <th class="px-3 py-2.5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
        <% @subscribers.each do |subscriber| %>
          <tr class="hover:bg-slate-50/70 dark:hover:bg-zinc-800/40">
            <td class="px-3 py-2.5 font-medium"><%= subscriber.email %></td>
            <td class="px-3 py-2.5 uppercase"><%= subscriber.locale %></td>
            <td class="px-3 py-2.5">
              <% status = subscriber.unsubscribed_at ? "unsubscribed" : (subscriber.confirmed? ? "confirmed" : "unconfirmed") %>
              <span class="<%= ui_badge_classes(tone: status == "confirmed" ? :success : (status == "unsubscribed" ? :danger : :neutral), extra: '!px-2 !py-0.5') %>">
                <%= t("admin.newsletter.statuses.#{status}") %>
              </span>
            </td>
            <td class="px-3 py-2.5 text-xs text-slate-500 dark:text-zinc-400"><%= admin_date(subscriber.created_at) %></td>
            <td class="px-3 py-2.5 text-right">
              <%= button_to t("admin.actions.delete"), admin_newsletter_subscriber_path(subscriber),
                            method: :delete,
                            form: { data: { turbo_confirm: t("admin.newsletter.confirm_delete") } },
                            class: ui_button_classes(variant: :ghost, size: :sm, extra: "!text-rose-600") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @subscribers.empty? %>
    <div class="mt-3"><%= render "admin/shared/empty_state", title: t("admin.newsletter.empty_title"), body: t("admin.newsletter.empty_body") %></div>
  <% end %>
  <%= render "admin/shared/pagination", pagy: @pagy %>
</div>
