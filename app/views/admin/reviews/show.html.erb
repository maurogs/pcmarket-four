<div class="mx-auto max-w-[90rem] space-y-5">
  <%= render "admin/shared/detail_header", title: t("admin.reviews.show.title", id: @review.id),
             subtitle: t("admin.reviews.show.subtitle", store: @review.store.name, reviewer: @review.reviewer.display_name),
             back_path: admin_reviews_path,
             secondary_actions: [ { label: t("admin.reviews.show.view_store"), path: store_path(@review.store), variant: :outline } ], actions: [] %>

  <div class="flex flex-wrap items-center gap-2">
    <%= render "shared/star_rating", rating: @review.rating %>
    <%= render "admin/shared/status_badge", text: @review.published? ? t("admin.reviews.published") : t("admin.reviews.unpublished"),
               tone: @review.published? ? :success : :danger %>
    <% if @review.replied? %>
      <span class="<%= ui_badge_classes(tone: @review.seller_reply_visible? ? :brand : :neutral) %>">
        <%= @review.seller_reply_visible? ? t("admin.reviews.reply_visible") : t("admin.reviews.reply_hidden") %>
      </span>
    <% end %>
    <span class="text-xs text-slate-500 dark:text-zinc-400"><%= admin_datetime(@review.created_at) %></span>
  </div>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-4">
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.reviews.show.body") %></h2>
        <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-700 dark:text-zinc-300"><%= @review.body %></p>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.reviews.show.reply") %></h2>
        <% if @review.replied? %>
          <p class="mt-2 whitespace-pre-line rounded-lg bg-slate-50 p-3 text-sm text-slate-700 dark:bg-zinc-800/60 dark:text-zinc-300"><%= @review.seller_reply %></p>
        <% else %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.show.no_reply") %></p>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.reviews.show.context") %></h2>
        <dl class="mt-2 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.columns.store") %></dt>
            <dd class="font-medium"><%= link_to @review.store.name, admin_store_path(@review.store), class: "text-brand-700 hover:underline dark:text-brand-300" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.columns.reviewer") %></dt>
            <dd class="font-medium"><%= link_to @review.reviewer.display_name, admin_user_path(@review.reviewer), class: "text-brand-700 hover:underline dark:text-brand-300" %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.columns.order") %></dt>
            <dd class="font-medium">
              <% if @review.order %>
                <%= link_to @review.order.number, admin_order_path(@review.order), class: "text-brand-700 hover:underline dark:text-brand-300" %>
              <% else %>
                —
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.columns.rating") %></dt>
            <dd class="font-medium"><%= @review.rating %>/5</dd>
          </div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.orders.show.history") %></h2>
        <% if @audit_logs.empty? %>
          <p class="mt-2 text-sm text-slate-500 dark:text-zinc-400"><%= t("admin.common.no_history") %></p>
        <% else %>
          <ol class="mt-2 space-y-2 text-sm">
            <% @audit_logs.each do |log| %>
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-100 px-3 py-2 dark:border-zinc-800">
                <span class="font-medium"><%= admin_audit_action_label(log.action) %></span>
                <span class="text-[11px] text-slate-500 dark:text-zinc-400"><%= log.admin.display_name %> · <%= admin_datetime(log.created_at) %></span>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.reviews.show.actions") %></h2>
        <div class="mt-3 space-y-2">
          <%= button_to @review.published? ? t("admin.reviews.show.unpublish") : t("admin.reviews.show.publish"),
                        admin_review_path(@review),
                        method: :patch, params: { review: { published: !@review.published? } },
                        class: ui_button_classes(variant: :outline, size: :sm, extra: "w-full") %>

          <% if @review.replied? %>
            <%= button_to @review.seller_reply_visible? ? t("admin.reviews.show.hide_reply") : t("admin.reviews.show.show_reply"),
                          admin_review_path(@review),
                          method: :patch, params: { review: { seller_reply_visible: !@review.seller_reply_visible? } },
                          class: ui_button_classes(variant: :outline, size: :sm, extra: "w-full") %>
          <% end %>

          <% if policy([ :admin, @review ]).destroy? %>
            <%= button_to t("admin.reviews.show.delete"), admin_review_path(@review), method: :delete,
                          form: { data: { turbo_confirm: t("admin.reviews.confirm.delete") } },
                          class: ui_button_classes(variant: :danger, size: :sm, extra: "w-full") %>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= t("admin.reviews.show.settings") %></h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.reviews.blocked_words_hint") %></p>
        <%= link_to t("admin.reviews.blocked_words_link"), admin_placeholder_path("settings"),
                    class: "mt-2 inline-block text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
      </section>
    </aside>
  </div>
</div>
