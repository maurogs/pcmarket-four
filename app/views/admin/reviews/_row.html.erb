<tr class="align-middle hover:bg-slate-50/70 dark:hover:bg-zinc-800/40">
  <td class="px-3 py-2.5">
    <%= link_to admin_review_path(record), class: "block max-w-md" do %>
      <span class="line-clamp-2 text-sm font-medium text-slate-900 dark:text-zinc-100"><%= admin_truncate(record.body, length: 110) %></span>
    <% end %>
    <% if record.replied? %>
      <span class="mt-0.5 inline-flex text-[10px] font-semibold uppercase text-brand-700 dark:text-brand-300"><%= t("admin.reviews.replied") %></span>
    <% end %>
  </td>
  <td class="px-3 py-2.5 text-xs">
    <%= link_to record.store.name, admin_store_path(record.store),
                class: "text-slate-700 hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300" %>
  </td>
  <td class="px-3 py-2.5 text-xs text-slate-600 dark:text-zinc-400"><%= record.reviewer.display_name %></td>
  <td class="px-3 py-2.5 text-xs">
    <% if record.order %>
      <%= link_to record.order.number, admin_order_path(record.order),
                  class: "font-medium text-brand-700 hover:underline dark:text-brand-300" %>
    <% else %>
      <span class="text-slate-400">—</span>
    <% end %>
  </td>
  <td class="px-3 py-2.5 text-right text-sm tabular-nums"><%= record.rating %>/5</td>
  <td class="px-3 py-2.5">
    <%= render "admin/shared/status_badge", text: record.published? ? t("admin.reviews.published") : t("admin.reviews.unpublished"),
               tone: record.published? ? :success : :danger %>
  </td>
  <td class="whitespace-nowrap px-3 py-2.5 text-xs text-slate-500 dark:text-zinc-400"><%= admin_datetime(record.created_at) %></td>
  <td class="px-3 py-2.5 text-right">
    <%= link_to icon("eye", class: "size-4"), admin_review_path(record),
                class: "inline-flex rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-zinc-800 dark:hover:text-zinc-200",
                aria: { label: t("admin.actions.view") } %>
  </td>
</tr>
