<% tone_classes = {
  up: "text-emerald-700 dark:text-emerald-400",
  down: "text-rose-700 dark:text-rose-400",
  flat: "text-slate-500 dark:text-zinc-400"
}.fetch((local_assigns[:direction] || :flat).to_sym, "text-slate-500 dark:text-zinc-400") %>
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
  <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= label %></p>
  <div class="mt-1.5 flex items-baseline gap-2">
    <p class="font-heading text-2xl font-bold tabular-nums text-slate-950 dark:text-white"><%= value %></p>
    <% if local_assigns[:change].present? %>
      <span class="inline-flex items-center gap-0.5 text-xs font-semibold <%= tone_classes %>">
        <% if local_assigns[:direction].to_s == "up" %>
          <%= icon "arrow-up", class: "size-3" %>
        <% elsif local_assigns[:direction].to_s == "down" %>
          <%= icon "chevron-down", class: "size-3" %>
        <% end %>
        <%= change %>
      </span>
    <% end %>
  </div>
  <p class="mt-1 text-[11px] text-slate-500 dark:text-zinc-500"><%= local_assigns[:hint] || t("admin.dashboard.last_7_days") %></p>
</div>
