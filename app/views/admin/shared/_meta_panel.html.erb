<section class="<%= local_assigns[:class] || '' %>">
  <% if local_assigns[:title].present? %>
    <h2 class="mb-2 font-heading text-sm font-semibold text-slate-900 dark:text-white"><%= title %></h2>
  <% end %>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <dl class="space-y-2.5 text-sm">
      <% rows.each do |label, value| %>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-xs font-medium text-slate-500 dark:text-zinc-400"><%= label %></dt>
          <dd class="text-right font-medium text-slate-900 dark:text-zinc-100"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
