<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <% if local_assigns[:back_path].present? %>
      <%= link_to back_path, class: "mb-1 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300" do %>
        <%= icon "chevron-left", class: "size-3.5" %><%= local_assigns[:back_label] || t("admin.actions.back") %>
      <% end %>
    <% end %>
    <% if local_assigns[:eyebrow].present? %>
      <p class="text-[10px] font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-300"><%= eyebrow %></p>
    <% end %>
    <h1 class="mt-0.5 font-heading text-2xl font-bold tracking-tight text-slate-950 sm:text-[1.7rem] dark:text-white"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-1 max-w-2xl text-sm text-slate-600 dark:text-zinc-400"><%= subtitle %></p>
    <% end %>
  </div>

  <% if local_assigns[:actions].present? %>
    <div class="flex flex-wrap items-center gap-2">
      <% actions.each do |action| %>
        <% next if action[:if] == false %>
        <% classes = ui_button_classes(variant: action[:variant] || :outline, size: :sm,
                                       extra: action[:class]) %>
        <% if action[:method] && action[:method].to_s != "get" %>
          <%= button_to action[:label], action[:path], method: action[:method],
                        form: { data: { turbo_confirm: action[:confirm] } },
                        class: classes %>
        <% else %>
          <%= link_to action[:path], class: classes,
                      data: action[:confirm] ? { turbo_confirm: action[:confirm] } : {} do %>
            <% if action[:icon].present? %><%= icon action[:icon], class: "size-4" %><% end %>
            <%= action[:label] %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
