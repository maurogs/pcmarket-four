<div class="mx-auto max-w-4xl">
  <%= render "admin/shared/page_header", title: @sell_offer.item_name, subtitle: @sell_offer.user.email,
             back_path: admin_sell_offers_path, eyebrow: t("admin.nav.sections.marketplace") %>

  <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
    <div class="surface p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="<%= ui_badge_classes(tone: @sell_offer.status.in?(%w[paid received accepted]) ? :success : (@sell_offer.status.in?(%w[rejected declined expired]) ? :danger : :brand)) %>">
          <%= t("sell_to_us.statuses.#{@sell_offer.status}") %>
        </span>
        <p class="font-heading text-2xl font-bold text-slate-950 dark:text-white"><%= format_price(@sell_offer.offered_price_cents) %></p>
      </div>

      <dl class="mt-5 grid gap-3 border-t border-slate-200 pt-4 text-sm sm:grid-cols-2 dark:border-zinc-800">
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.sell_offers.columns.kind") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= t("sell_to_us.kinds.#{@sell_offer.item_kind}") %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.form.condition") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= t("sell_to_us.conditions.#{@sell_offer.condition_label_key}") %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.form.original_box") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @sell_offer.original_box? ? t("common.yes") : t("common.no") %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.form.accessories") %></dt>
          <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @sell_offer.accessories.presence || "—" %></dd>
        </div>
        <% if @sell_offer.payout_iban.present? %>
          <div class="sm:col-span-2">
            <dt class="text-xs text-slate-500 dark:text-zinc-400"><%= t("admin.sell_offers.columns.payout") %></dt>
            <dd class="mt-0.5 font-medium text-slate-900 dark:text-white"><%= @sell_offer.payout_account_name %> · <%= @sell_offer.payout_iban %></dd>
          </div>
        <% end %>
      </dl>

      <% if @sell_offer.admin_notes.present? %>
        <div class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-700 dark:bg-zinc-800/50 dark:text-zinc-300">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("sell_to_us.offer.notes") %></p>
          <p class="mt-1"><%= @sell_offer.admin_notes %></p>
        </div>
      <% end %>
    </div>

    <div class="surface p-5">
      <h2 class="font-heading text-base font-semibold text-slate-950 dark:text-white"><%= t("admin.sell_offers.update_title") %></h2>
      <%= form_with url: admin_sell_offer_path(@sell_offer), method: :patch, class: "mt-3 space-y-3" do %>
        <div>
          <label for="sell_offer_status" class="mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300"><%= t("admin.sell_offers.columns.status") %></label>
          <select id="sell_offer_status" name="sell_offer[status]" class="<%= ui_input_classes("!min-h-9 !py-1.5 !text-sm") %>">
            <% %w[received paid rejected].each do |status| %>
              <option value="<%= status %>" <%= "selected" if @sell_offer.status == status %>><%= t("sell_to_us.statuses.#{status}") %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label for="sell_offer_admin_notes" class="mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300"><%= t("admin.sell_offers.notes") %></label>
          <textarea id="sell_offer_admin_notes" name="sell_offer[admin_notes]" rows="4"
                    class="<%= ui_input_classes("!text-sm") %>"><%= @sell_offer.admin_notes %></textarea>
        </div>
        <%= submit_tag t("admin.actions.save"), class: ui_button_classes(variant: :primary, size: :sm, extra: "w-full") %>
      <% end %>

      <div class="mt-4 border-t border-slate-200 pt-4 text-xs text-slate-500 dark:border-zinc-800 dark:text-zinc-400">
        <p><%= t("admin.sell_offers.created", date: l(@sell_offer.created_at, format: :long)) %></p>
        <% if @sell_offer.offer_expires_at.present? %>
          <p class="mt-1"><%= t("sell_to_us.offer.expires_on") %>: <%= l(@sell_offer.offer_expires_at, format: :short) %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
