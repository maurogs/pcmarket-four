<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%= display_meta_tags %>

    <meta name="theme-color" content="#0F766E" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap">

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" sizes="512x512" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_tag nonce: true do %>
      (function () {
        try {
          var stored = localStorage.getItem("pcmarket-theme");
          var match = document.cookie.match(/(?:^|; )theme=(dark|light)/);
          var theme = stored || (match && match[1]);
          if (!theme) {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          if (theme === "dark") document.documentElement.classList.add("dark");
        } catch (error) {}
      })();
    <% end %>

    <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
      <%= raw structured_data %>
    </script>

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col overflow-x-clip bg-slate-50 pb-14 text-slate-900 antialiased md:pb-0 dark:bg-zinc-950 dark:text-zinc-100"
        data-controller="theme cookie-consent drawer">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-full focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      <%= t("layout.skip_to_content") %>
    </a>

    <%= render "shared/announcement_bar" %>
    <%= render "shared/header" %>
    <%= render "shared/mobile_drawer" %>

    <div id="flash-messages" class="pointer-events-none fixed inset-x-4 top-20 z-[70] mx-auto flex max-w-md flex-col gap-2">
      <%= render "shared/flash" %>
    </div>

    <dialog id="auth-dialog" data-controller="auth-modal"
            class="w-[min(92vw,64rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-[var(--shadow-panel)] dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100">
      <turbo-frame id="auth-modal"></turbo-frame>
    </dialog>

    <main id="main-content" tabindex="-1" class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/mobile_tab_bar" %>
    <%= render "shared/cookie_consent" %>
    <%= render "shared/back_to_top" %>
  </body>
</html>
