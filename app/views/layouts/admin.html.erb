<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <%= render "layouts/head" %>

  <body class="min-h-full bg-slate-100 text-slate-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
        data-controller="theme admin-sidebar">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-full focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      <%= t("layout.skip_to_content") %>
    </a>

    <div class="flex min-h-screen">
      <aside data-admin-sidebar-target="panel"
             class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-all duration-200 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 lg:w-64 dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex min-h-16 items-center gap-2 border-b border-slate-200 px-3 dark:border-zinc-800">
          <%= link_to admin_root_path, class: "flex min-w-0 items-center gap-2.5 px-1" do %>
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-brand-700 font-heading text-sm font-bold text-white">PC</span>
            <span class="min-w-0" data-admin-sidebar-target="label">
              <span class="block truncate font-heading text-sm font-semibold text-slate-950 dark:text-white"><%= site_name %></span>
              <span class="block text-[10px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300"><%= t("admin.title") %></span>
            </span>
          <% end %>
          <button type="button" data-action="admin-sidebar#close"
                  class="ml-auto rounded-lg p-2 text-slate-500 hover:bg-slate-100 lg:hidden dark:text-zinc-400 dark:hover:bg-zinc-800"
                  aria-label="<%= t("admin.nav.close") %>">
            <%= icon "x", class: "size-5" %>
          </button>
        </div>

        <%= render "admin/shared/nav" %>

        <div class="border-t border-slate-200 p-2 dark:border-zinc-800">
          <button type="button" data-action="admin-sidebar#toggleCollapsed"
                  class="flex min-h-9 w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
                  aria-label="<%= t("admin.nav.collapse") %>">
            <span data-admin-sidebar-target="collapseIcon" class="transition-transform">
              <%= icon "chevron-left", class: "size-4" %>
            </span>
            <span class="hidden lg:inline" data-admin-sidebar-target="label"><%= t("admin.nav.collapse_hint") %></span>
          </button>
        </div>
      </aside>

      <div data-admin-sidebar-target="overlay" data-action="click->admin-sidebar#close"
           class="fixed inset-0 z-40 hidden bg-slate-950/50 lg:hidden"></div>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/90">
          <div class="flex min-h-16 items-center gap-3 px-4 sm:px-6">
            <button type="button" data-action="admin-sidebar#open"
                    class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden dark:text-zinc-300 dark:hover:bg-zinc-800"
                    aria-label="<%= t("admin.nav.open") %>">
              <%= icon "menu", class: "size-5" %>
            </button>

            <%= form_with url: admin_search_path, method: :get, class: "relative min-w-0 flex-1 max-w-xl" do |form| %>
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><%= icon "search", class: "size-4" %></span>
              <%= search_field_tag :q, params[:q].presence, id: "admin-global-search",
                                   placeholder: t("admin.search.placeholder"),
                                   autocomplete: "off",
                                   class: ui_input_classes("!min-h-9 !py-1.5 !pl-9 !text-sm") %>
            <% end %>

            <div class="ml-auto flex items-center gap-1.5">
              <%= link_to root_path,
                          class: "hidden items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-950 sm:inline-flex dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white" do %>
                <%= icon "arrow-up-right", class: "size-4" %><%= t("admin.topbar.view_site") %>
              <% end %>

              <button type="button" data-theme-target="toggle" data-action="theme#toggle"
                      data-label-light="<%= t("layout.header.theme_light") %>"
                      data-label-dark="<%= t("layout.header.theme_dark") %>"
                      class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
                      aria-label="<%= t("layout.header.theme_dark") %>">
                <span class="dark:hidden"><%= icon "moon", class: "size-5" %></span>
                <span class="hidden dark:inline"><%= icon "sun", class: "size-5" %></span>
              </button>

              <div class="ml-1 hidden items-center gap-2 border-l border-slate-200 pl-3 text-right sm:flex dark:border-zinc-700">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-900 dark:text-white"><%= current_user.display_name %></p>
                  <p class="text-[10px] font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300"><%= t("admin.roles.#{current_user.role}") %></p>
                </div>
                <span class="flex size-8 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-700 dark:bg-zinc-800 dark:text-zinc-200">
                  <%= current_user.initials %>
                </span>
              </div>
            </div>
          </div>
        </header>

        <%= render "shared/maintenance_banner" if @maintenance_mode_staff_view %>
        <%= render "shared/impersonation_banner" %>

        <div id="flash-messages" class="pointer-events-none fixed inset-x-4 top-20 z-[70] mx-auto flex max-w-md flex-col gap-2">
          <%= render "shared/flash" %>
        </div>

        <main id="main-content" tabindex="-1" class="flex-1 px-4 py-5 sm:px-6 lg:px-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
