<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : site_name %></title>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      @media print {
        .no-print { display: none !important; }
        body { background: #fff !important; color: #000 !important; }
        .print-sheet { box-shadow: none !important; border: 0 !important; padding: 0 !important; }
        @page { margin: 16mm; }
      }
    </style>
  </head>
  <body class="min-h-full bg-slate-100 p-4 text-slate-900 sm:p-8">
    <%= yield %>
  </body>
</html>
