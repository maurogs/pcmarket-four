<% content_for :account_body do %>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="section-title"><%= t(".title") %></h1>
    <%= link_to t(".add_new"), new_account_address_path, class: "btn-primary" %>
  </div>

  <% if @addresses.any? %>
    <ul class="mt-6 space-y-4">
      <% @addresses.each do |address| %>
        <li class="card p-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="font-semibold">
                <%= address.label.presence || address.full_name %>
                <% if address.default_shipping? %>
                  <span class="ml-2 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 dark:bg-primary-900 dark:text-primary-100"><%= t(".default_badge") %></span>
                <% end %>
              </p>
              <address class="mt-1 text-sm text-muted not-italic">
                <% address.formatted_lines.each do |line| %><%= line %><br><% end %>
              </address>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <% unless address.default_shipping? %>
                <%= button_to t(".make_default"), account_address_default_path(address), method: :patch, class: "btn-secondary" %>
              <% end %>
              <%= link_to t(".edit"), edit_account_address_path(address), class: "btn-ghost" %>
              <%= button_to t(".destroy"), account_address_path(address), method: :delete,
                    class: "btn-ghost text-rose-700 dark:text-rose-400",
                    form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card mt-6 p-10 text-center">
      <p class="text-muted"><%= t(".empty") %></p>
      <%= link_to t(".add_new"), new_account_address_path, class: "btn-primary mt-4" %>
    </div>
  <% end %>
<% end %>

<%= render "account/shell" %>
