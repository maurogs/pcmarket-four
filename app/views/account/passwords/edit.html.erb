<% content_for :title, t("account.password.title") %>

<div>
  <h2 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("account.password.title") %></h2>
  <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("account.password.subtitle") %></p>
</div>

<%= form_with model: current_user, url: account_password_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
  <% if current_user.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% current_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="surface p-5">
    <div class="space-y-4">
      <% unless current_user.oauth_only? %>
        <div>
          <%= label_tag :current_password, t("account.password.current"), class: "mb-1 block text-sm font-medium text-slate-800 dark:text-zinc-200" %>
          <%= password_field_tag :current_password, nil, autocomplete: "current-password", class: ui_input_classes %>
        </div>
      <% else %>
        <p class="rounded-xl border border-brand-200 bg-brand-50 px-3 py-2.5 text-sm text-brand-900 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-200">
          <%= t("account.password.google_note") %>
        </p>
      <% end %>
      <div>
        <%= form.label :password, t("account.password.new"), class: "mb-1 block text-sm font-medium text-slate-800 dark:text-zinc-200" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, class: ui_input_classes %>
      </div>
      <div>
        <%= form.label :password_confirmation, t("account.password.confirmation"), class: "mb-1 block text-sm font-medium text-slate-800 dark:text-zinc-200" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, class: ui_input_classes %>
      </div>
      <p class="text-xs text-slate-500 dark:text-zinc-400"><%= t("account.password.hint") %></p>
    </div>
  </section>

  <div class="flex justify-end">
    <%= form.submit t("account.password.save"), class: ui_button_classes(variant: :primary, size: :md) %>
  </div>
<% end %>
