<% content_for :title, t("account.following.title") %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("account.following.title") %></h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("account.following.subtitle") %></p>
  </div>
  <%= link_to t("account.following.browse"), listings_path,
              class: ui_button_classes(variant: :outline, size: :sm) %>
</div>

<% if @stores.any? %>
  <div class="mt-6 space-y-4">
    <% @stores.each do |store| %>
      <section class="surface p-4">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-brand-100 font-heading text-sm font-bold text-brand-800 dark:bg-brand-900/50 dark:text-brand-200">
              <% if store.logo.attached? %>
                <%= image_tag store.logo.variant(resize_to_fill: [ 88, 88 ]), alt: "", class: "size-full object-cover" %>
              <% else %>
                <%= store.name.first.upcase %>
              <% end %>
            </span>
            <div class="min-w-0">
              <%= link_to store.name, store_path(store),
                          class: "truncate font-heading text-base font-semibold text-slate-950 hover:text-brand-700 dark:text-white dark:hover:text-brand-300" %>
              <p class="text-xs text-slate-500 dark:text-zinc-400">
                <%= t("stores.header.followers_count", count: store.followers_count, formatted: number_with_delimiter(store.followers_count)) %>
              </p>
            </div>
          </div>
          <%= button_to t("stores.unfollow"), follow_path(store.follows.find_by(follower_id: current_user.id)),
                        method: :delete, class: ui_button_classes(variant: :outline, size: :sm) %>
        </div>

        <% listings = @latest_listings.select { |listing| listing.store_id == store.id }.first(4) %>
        <% if listings.any? %>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% listings.each do |listing| %>
              <%= render "listings/card", listing: listing %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-500 dark:text-zinc-400"><%= t("account.following.no_listings") %></p>
        <% end %>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="mt-6">
    <%= render "shared/empty_state", title: t("account.following.empty_title"),
               body: t("account.following.empty_body"),
               cta_label: t("account.following.empty_cta"), cta_path: listings_path %>
  </div>
<% end %>
