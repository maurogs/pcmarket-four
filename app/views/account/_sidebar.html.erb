<%
  # Active item comes from the controller; the nested address-default
  # controller belongs to the Addresses section.
  sections = [
    [ "profiles", t(".profile"), edit_account_profile_path ],
    [ "passwords", t(".security"), edit_account_password_path ],
    [ "addresses", t(".addresses"), account_addresses_path ],
    [ "notifications", t(".notifications"), edit_account_notifications_path ],
    [ "stores", t(".my_store"), current_user.store ? edit_seller_store_path : new_seller_store_path ],
    [ "data_exports", t(".download_data"), account_data_export_path ]
  ]
  active = controller.controller_name == "address_defaults" ? "addresses" : controller.controller_name
%>
<nav aria-label="<%= t(".title") %>" class="mb-8 lg:mb-0">
  <ul class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:gap-1 lg:overflow-visible lg:pb-0">
    <% sections.each do |section, label, path| %>
      <li class="shrink-0 lg:w-full">
        <%= link_to label, path,
              aria: { current: ("page" if active == section) },
              class: class_names(
                "block whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold",
                "bg-primary-100 text-primary-900 dark:bg-primary-900 dark:text-primary-100" => active == section,
                "text-muted hover:bg-cream-100 hover:text-body dark:hover:bg-cream-surface" => active != section
              ) %>
      </li>
    <% end %>
    <li class="shrink-0 lg:mt-4 lg:w-full">
      <%= link_to t(".delete_account"), account_deletion_path,
            aria: { current: ("page" if active == "deletions") },
            class: class_names(
              "block whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold",
              "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200" => active == "deletions",
              "text-rose-700 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950" => active != "deletions"
            ) %>
    </li>
  </ul>
</nav>
