<% content_for :title, t("layout.meta.title") %>

<div class="page-container space-y-16 py-8 sm:space-y-20 sm:py-12">
  <section aria-labelledby="home-hero-title">
    <div class="mb-6 max-w-3xl">
      <span class="<%= ui_badge_classes(tone: :accent) %>">
        <%= icon "flame", class: "size-3.5" %>
        <%= t("home.hero.eyebrow") %>
      </span>
      <h1 id="home-hero-title" class="mt-3 break-words text-balance font-heading text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl dark:text-white">
        <%= t("home.hero.title") %>
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-zinc-400"><%= t("home.hero.subtitle") %></p>
    </div>

    <% cache "home/#{I18n.locale}/hero", expires_in: 5.minutes do %>
      <% hero = @feed.hero %>
      <% if hero.any? %>
        <div data-controller="carousel" data-carousel-interval-value="6500"
             data-action="mouseenter->carousel#pause mouseleave->carousel#resume keydown->carousel#keydown"
             tabindex="0" role="region" aria-roledescription="<%= t("home.hero.carousel_role") %>" aria-label="<%= t("home.hero.carousel") %>"
             class="relative overflow-hidden rounded-2xl bg-slate-900 shadow-[var(--shadow-lift)]">
          <% hero.each_with_index do |listing, index| %>
            <div data-carousel-target="slide" <%= "hidden" unless index.zero? %>
                 role="group" aria-roledescription="<%= t("home.hero.slide_role") %>" aria-label="<%= t("home.hero.slide", number: index + 1) %>"
                 class="relative min-h-[380px] w-full min-w-0 sm:min-h-[440px]">
              <% if listing.images.attached? %>
                <%= image_tag listing.ordered_images.first.variant(resize_to_limit: [ 1600, 900 ], format: :webp),
                              alt: t("listings.card.image_alt", title: listing.title),
                              class: "absolute inset-0 h-full w-full object-cover", loading: "eager" %>
              <% else %>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,#14b8a6_0%,transparent_45%),radial-gradient(circle_at_80%_80%,#f59e0b_0%,transparent_40%)] bg-slate-900"></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/65 to-slate-950/20"></div>

              <div class="relative flex min-h-[380px] w-full max-w-2xl min-w-0 flex-col justify-end p-6 sm:min-h-[440px] sm:p-10">
                <span class="<%= ui_badge_classes(tone: :dark, extra: "w-fit") %>">
                  <%= listing.category.name %>
                </span>
                <h2 class="mt-4 font-heading text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl">
                  <%= listing.title %>
                </h2>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  <span class="font-heading text-2xl font-bold text-accent-300"><%= format_price(listing.price_cents) %></span>
                  <% if listing.original_price_cents.present? && listing.original_price_cents > listing.price_cents %>
                    <span class="text-sm text-slate-300 line-through"><%= format_price(listing.original_price_cents) %></span>
                  <% end %>
                </div>
                <div class="mt-6 flex flex-wrap gap-3">
                  <%= link_to listing_path(listing), class: ui_button_classes(variant: :accent, size: :lg) do %>
                    <%= t("home.hero.cta") %><%= icon "arrow-right", class: "size-4" %>
                  <% end %>
                  <%= link_to category_path(path: listing.category.path_slugs),
                              class: ui_button_classes(variant: :outline, size: :lg, extra: "!border-white/30 !bg-white/10 !text-white hover:!border-white/60 hover:!text-white") do %>
                    <%= listing.category.name %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <% if hero.size > 1 %>
            <div class="absolute bottom-5 right-5 z-10 hidden items-center gap-2 sm:flex">
              <button type="button" data-action="carousel#previous"
                      class="inline-flex size-11 items-center justify-center rounded-full border border-white/30 bg-slate-950/40 text-white backdrop-blur transition hover:bg-slate-950/70"
                      aria-label="<%= t("home.hero.previous") %>">
                <%= icon "chevron-left", class: "size-5" %>
              </button>
              <button type="button" data-action="carousel#next"
                      class="inline-flex size-11 items-center justify-center rounded-full border border-white/30 bg-slate-950/40 text-white backdrop-blur transition hover:bg-slate-950/70"
                      aria-label="<%= t("home.hero.next") %>">
                <%= icon "chevron-right", class: "size-5" %>
              </button>
            </div>
            <div class="absolute bottom-7 left-6 z-10 flex items-center gap-1.5 sm:left-10" role="tablist" aria-label="<%= t("home.hero.eyebrow") %>">
              <% hero.each_with_index do |_listing, index| %>
                <button type="button" data-carousel-target="dot" data-action="carousel#goTo" data-index="<%= index %>"
                        role="tab" aria-selected="<%= index.zero? %>" aria-label="<%= t("home.hero.slide", number: index + 1) %>"
                        class="size-2.5 rounded-full transition <%= index.zero? ? "bg-white" : "bg-white/40" %>"></button>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render "shared/empty_state", title: t("home.hero.empty_title"), body: t("home.hero.empty_body"),
                   cta_label: t("home.hero.empty_cta"), cta_path: listings_path %>
      <% end %>
    <% end %>
  </section>

  <section aria-label="<%= t("home.promos.most_wanted_title") %>">
    <% cache "home/#{I18n.locale}/promos", expires_in: 5.minutes do %>
      <div class="grid gap-4 md:grid-cols-3">
        <%= link_to listings_path(sort: "popular"),
                    class: "group relative w-full min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-[var(--shadow-card)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] dark:border-zinc-800 dark:bg-zinc-900" do %>
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-rose-100 text-rose-600 dark:bg-rose-500/15 dark:text-rose-300">
            <%= icon "heart", class: "size-6" %>
          </span>
          <h2 class="mt-5 font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("home.promos.most_wanted_title") %></h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("home.promos.most_wanted_body") %></p>
          <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 dark:text-brand-300">
            <%= t("home.promos.most_wanted_cta") %><%= icon "arrow-right", class: "size-4 transition group-hover:translate-x-0.5" %>
          </p>
        <% end %>

        <%= link_to category_path(path: "gaming-pcs"),
                    class: "group relative w-full min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-[var(--shadow-card)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] dark:border-zinc-800 dark:bg-zinc-900" do %>
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-300">
            <%= icon "truck", class: "size-6" %>
          </span>
          <h2 class="mt-5 font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("home.promos.ready_title") %></h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("home.promos.ready_body") %></p>
          <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 dark:text-brand-300">
            <%= t("home.promos.ready_cta") %><%= icon "arrow-right", class: "size-4 transition group-hover:translate-x-0.5" %>
          </p>
        <% end %>

        <%= link_to listings_path(deals: 1),
                    class: "group relative w-full min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-[var(--shadow-card)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] dark:border-zinc-800 dark:bg-zinc-900" do %>
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-accent-100 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300">
            <%= icon "tag", class: "size-6" %>
          </span>
          <h2 class="mt-5 font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("home.promos.deals_title") %></h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("home.promos.deals_body") %></p>
          <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 dark:text-brand-300">
            <%= t("home.promos.deals_cta") %><%= icon "arrow-right", class: "size-4 transition group-hover:translate-x-0.5" %>
          </p>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl bg-brand-900 px-6 py-10 text-brand-50 shadow-[var(--shadow-lift)] sm:px-10 lg:px-14 lg:py-14">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-800 px-3 py-1 text-xs font-semibold text-brand-100">
          <%= icon "sparkles", class: "size-3.5" %><%= t("home.pc_finder.eyebrow") %>
        </span>
        <h2 class="mt-4 font-heading text-2xl font-bold leading-tight text-white sm:text-3xl"><%= t("home.pc_finder.title") %></h2>
        <p class="mt-3 max-w-xl text-sm text-brand-200 sm:text-base"><%= t("home.pc_finder.body") %></p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-100">
          <% %w[bullet_1 bullet_2 bullet_3].each do |key| %>
            <li class="inline-flex items-center gap-1.5">
              <%= icon "check", class: "size-4 text-accent-300" %><%= t("home.pc_finder.#{key}") %>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="lg:justify-self-end">
        <%= link_to pc_finder_path, class: ui_button_classes(variant: :accent, size: :lg) do %>
          <%= t("home.pc_finder.cta") %><%= icon "arrow-right", class: "size-4" %>
        <% end %>
      </div>
    </div>
  </section>

  <section aria-labelledby="shop-by-vibe-title">
    <div class="mb-6">
      <h2 id="shop-by-vibe-title" class="section-heading"><%= t("home.vibe.title") %></h2>
      <p class="section-subtitle"><%= t("home.vibe.subtitle") %></p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <% {
        "minimalist" => [ "sparkles", "from-slate-200 to-slate-100 text-slate-700 dark:from-zinc-800 dark:to-zinc-900 dark:text-zinc-200" ],
        "anime" => [ "flame", "from-rose-200 to-fuchsia-100 text-rose-800 dark:from-rose-950 dark:to-fuchsia-950 dark:text-rose-200" ],
        "rgb" => [ "zap", "from-brand-200 to-indigo-100 text-brand-900 dark:from-brand-950 dark:to-indigo-950 dark:text-brand-200" ],
        "white" => [ "sun", "from-amber-100 to-orange-50 text-amber-900 dark:from-amber-950 dark:to-orange-950 dark:text-amber-200" ]
      }.each do |tag, (icon_name, gradient)| %>
        <%= link_to listings_path(tags: tag),
                    class: "group flex min-h-[120px] flex-col justify-between rounded-xl bg-gradient-to-br p-5 ring-1 ring-slate-200/60 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] dark:ring-zinc-800 #{gradient}" do %>
          <%= icon icon_name, class: "size-6" %>
          <span class="font-heading text-lg font-semibold"><%= t("home.vibe.#{tag}") %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <% cache "home/#{I18n.locale}/rows", expires_in: 5.minutes do %>
    <% home_rows = [
      [ t("home.rows.latest_gpus"), @feed.latest_gpus, category_path(path: "components/gpus") ],
      [ t("home.rows.most_watched"), @feed.most_watched, listings_path(sort: "popular") ],
      [ t("home.rows.on_sale"), @feed.on_sale, listings_path(deals: 1) ],
      [ t("home.rows.newest"), @feed.newest, listings_path ],
      [ t("home.rows.recently_sold"), @feed.recently_sold, nil ]
    ] %>
    <% row_favorited_ids = listing_favorite_ids(home_rows.flat_map { |_title, listings, _path| listings }) %>
    <% home_rows.each do |row_title, row_listings, row_path| %>
      <%= render "shared/listing_row", title: row_title, listings: row_listings,
                 view_all_path: row_path, favorited_ids: row_favorited_ids %>
    <% end %>
  <% end %>

  <section class="surface overflow-hidden">
    <% cache "home/#{I18n.locale}/trust", expires_in: 5.minutes do %>
      <div class="grid divide-y divide-slate-200 sm:grid-cols-2 sm:divide-x lg:grid-cols-4 dark:divide-zinc-800">
        <% [
          [ "shield-check", "buyer_protection" ],
          [ "badge-check", "verified_sellers" ],
          [ "lock", "secure_payments" ],
          [ "headset", "spanish_support" ]
        ].each do |icon_name, key| %>
          <div class="flex items-start gap-3 p-6">
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-300">
              <%= icon icon_name, class: "size-5" %>
            </span>
            <div>
              <h2 class="text-sm font-semibold text-slate-950 dark:text-white"><%= t("home.trust.#{key}_title") %></h2>
              <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-zinc-400"><%= t("home.trust.#{key}_body") %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="home-reviews-title">
    <div class="mb-6">
      <h2 id="home-reviews-title" class="section-heading"><%= t("home.reviews.title") %></h2>
      <p class="section-subtitle"><%= t("home.reviews.subtitle") %></p>
    </div>

    <% cache "home/#{I18n.locale}/reviews", expires_in: 5.minutes do %>
      <% reviews = @feed.reviews %>
      <% if reviews.any? %>
        <div data-controller="carousel" data-carousel-interval-value="8000"
             data-action="mouseenter->carousel#pause mouseleave->carousel#resume keydown->carousel#keydown"
             tabindex="0" role="region" aria-roledescription="<%= t("home.hero.carousel_role") %>" aria-label="<%= t("home.reviews.title") %>"
             class="relative">
          <% reviews.each_with_index do |review, index| %>
            <div data-carousel-target="slide" <%= "hidden" unless index.zero? %>
                 role="group" aria-roledescription="<%= t("home.hero.slide_role") %>" aria-label="<%= t("home.hero.slide", number: index + 1) %>"
                 class="surface grid gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-center">
              <div>
                <%= render "shared/star_rating", rating: review.rating, label: review.rating %>
                <blockquote class="mt-4 font-heading text-lg font-medium leading-8 text-slate-900 sm:text-xl dark:text-zinc-100">
                  “<%= review.body.presence || t("home.reviews.static_1_body") %>”
                </blockquote>
                <p class="mt-4 text-sm text-slate-600 dark:text-zinc-400">
                  <span class="font-semibold text-slate-900 dark:text-white"><%= review.reviewer.display_name %></span>
                  <% if review.store.present? %>
                    <span class="mx-1.5 text-slate-300 dark:text-zinc-600">·</span><%= review.store.name %>
                  <% end %>
                </p>
              </div>
              <div class="rounded-xl bg-brand-50 p-5 text-sm text-brand-900 dark:bg-brand-950/60 dark:text-brand-100">
                <p class="inline-flex items-center gap-1.5 font-semibold">
                  <%= icon "shield-check", class: "size-4" %><%= t("home.trust.buyer_protection_title") %>
                </p>
                <p class="mt-2 text-xs leading-5 text-brand-800 dark:text-brand-200"><%= t("home.trust.buyer_protection_body") %></p>
              </div>
            </div>
          <% end %>
          <div class="mt-4 flex justify-center gap-1.5" role="tablist" aria-label="<%= t("home.reviews.title") %>">
            <% reviews.each_with_index do |_review, index| %>
              <button type="button" data-carousel-target="dot" data-action="carousel#goTo" data-index="<%= index %>"
                      role="tab" aria-selected="<%= index.zero? %>" aria-label="<%= t("home.hero.slide", number: index + 1) %>"
                      class="size-2.5 rounded-full transition <%= index.zero? ? "bg-brand-600" : "bg-slate-300 dark:bg-zinc-700" %>"></button>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="grid gap-4 md:grid-cols-3">
          <% (1..3).each do |index| %>
            <figure class="surface p-6">
              <%= render "shared/star_rating", rating: 5, label: 5 %>
              <blockquote class="mt-4 text-sm leading-6 text-slate-700 dark:text-zinc-300">
                “<%= t("home.reviews.static_#{index}_body") %>”
              </blockquote>
              <figcaption class="mt-4 text-xs text-slate-500 dark:text-zinc-400">
                <span class="font-semibold text-slate-800 dark:text-zinc-200"><%= t("home.reviews.static_#{index}_name") %></span>
                · <%= t("home.reviews.static_#{index}_location") %>
              </figcaption>
            </figure>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

  <% if @recently_viewed.present? %>
    <section>
      <%= render "shared/listing_row", title: t("listings.show.recently_viewed"),
                 listings: @recently_viewed, view_all_path: listings_path,
                 favorited_ids: listing_favorite_ids(@recently_viewed) %>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-2xl bg-slate-900 px-6 py-10 text-white sm:px-10 lg:px-14 lg:py-12 dark:bg-zinc-900">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <h2 class="font-heading text-2xl font-bold text-white sm:text-3xl"><%= t("home.sell.title") %></h2>
        <p class="mt-2 text-sm text-slate-300 sm:text-base"><%= t("home.sell.body") %></p>
      </div>
      <%= link_to sell_path, class: ui_button_classes(variant: :accent, size: :lg) do %>
        <%= t("home.sell.cta") %><%= icon "arrow-right", class: "size-4" %>
      <% end %>
    </div>
  </section>

  <section class="border-t border-slate-200 pt-10 dark:border-zinc-800">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="prose-pcm max-w-3xl">
        <h2 class="!mt-0"><%= t("home.seo.title") %></h2>
        <p><%= t("home.seo.paragraph_1") %></p>
        <p><%= t("home.seo.paragraph_2") %></p>
      </div>
      <div class="space-y-2 text-sm">
        <%= link_to category_path(path: "components/gpus"),
                    class: "flex items-center justify-between rounded-lg border border-slate-200 px-3 py-2.5 text-slate-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-800 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300" do %>
          <%= t("home.rows.latest_gpus") %><%= icon "chevron-right", class: "size-4" %>
        <% end %>
        <%= link_to pc_finder_path,
                    class: "flex items-center justify-between rounded-lg border border-slate-200 px-3 py-2.5 text-slate-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-800 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300" do %>
          <%= t("layout.nav.pc_finder") %><%= icon "chevron-right", class: "size-4" %>
        <% end %>
        <%= link_to sell_path,
                    class: "flex items-center justify-between rounded-lg border border-slate-200 px-3 py-2.5 text-slate-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-zinc-800 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-300" do %>
          <%= t("home.sell.cta") %><%= icon "chevron-right", class: "size-4" %>
        <% end %>
      </div>
    </div>
  </section>
</div>
