<% content_for :head do %>
  <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>"><%= @store_json_ld %></script>
<% end %>

<div class="pb-6">
  <div class="relative h-36 w-full overflow-hidden bg-brand-900 sm:h-48">
    <% if @store.banner.attached? %>
      <%= image_tag @store.banner.variant(resize_to_limit: [ 1600, 480 ], format: :webp),
                    alt: @store.name, class: "h-full w-full object-cover", loading: "eager" %>
    <% else %>
      <div class="h-full w-full bg-[radial-gradient(circle_at_15%_20%,#14b8a6_0%,transparent_45%),radial-gradient(circle_at_85%_80%,#f59e0b_0%,transparent_40%)]"></div>
    <% end %>
  </div>

  <div class="page-container">
    <div class="relative -mt-12 rounded-2xl border border-slate-200 bg-white p-5 shadow-[var(--shadow-card)] sm:-mt-16 sm:p-6 dark:border-zinc-800 dark:bg-zinc-900">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
        <div class="flex min-w-0 items-start gap-4">
          <% if @store.logo.attached? %>
            <%= image_tag @store.logo.variant(resize_to_limit: [ 192, 192 ], format: :webp),
                          alt: @store.name, width: 96, height: 96, loading: "eager",
                          class: "size-20 shrink-0 rounded-2xl border-4 border-white object-cover shadow-sm sm:size-24 dark:border-zinc-900" %>
          <% else %>
            <span class="flex size-20 shrink-0 items-center justify-center rounded-2xl border-4 border-white bg-brand-100 font-heading text-2xl font-bold text-brand-800 shadow-sm sm:size-24 dark:border-zinc-900 dark:bg-brand-900/50 dark:text-brand-200">
              <%= @store.name.first.upcase %>
            </span>
          <% end %>

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="font-heading text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl dark:text-white">
                <%= @store.name %>
              </h1>
              <% if @store.verified? %>
                <span class="<%= ui_badge_classes(tone: :brand) %>">
                  <%= icon "badge-check", class: "size-3.5" %><%= t("stores.header.verified") %>
                </span>
              <% end %>
              <span class="<%= ui_badge_classes(tone: @store.professional? ? :dark : :neutral) %>">
                <%= t("stores.header.#{@store.professional? ? 'professional' : 'private'}") %>
              </span>
            </div>

            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 dark:text-zinc-400">
              <span class="inline-flex items-center gap-1">
                <%= render "shared/star_rating", rating: @store.rating_avg.round,
                           label: t("stores.header.rating_label", rating: @store.rating_avg) %>
                <span class="text-xs"><%= @store.rating_avg %> (<%= @store.reviews_count %>)</span>
              </span>
              <span><%= render "stores/followers_count", store: @store %></span>
              <span><%= t("stores.header.for_sale", count: @for_sale_count) %></span>
              <span><%= t("stores.header.sold_count", count: @sold_count) %></span>
              <span><%= t("stores.header.member_since", date: month_year(@store.user.created_at)) %></span>
              <% if @store.location.present? %>
                <span class="inline-flex items-center gap-1"><%= icon "map-pin", class: "size-3.5" %><%= @store.location %></span>
              <% end %>
            </div>

            <% if @store.description.present? %>
              <p class="mt-3 line-clamp-2 max-w-2xl text-sm text-slate-600 dark:text-zinc-400"><%= @store.description %></p>
            <% end %>
          </div>
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-2">
          <%= render "stores/follow_button", store: @store, follow: @follow %>
          <% if chat_enabled? %>
            <% if user_signed_in? && current_user.id != @store.user_id %>
              <%= button_to conversations_path(seller_id: @store.user_id), method: :post,
                            form: { data: { turbo: false } },
                            class: ui_button_classes(variant: :outline, size: :md) do %>
                <%= icon "message-circle", class: "size-4" %><%= t("stores.header.message") %>
              <% end %>
            <% elsif !user_signed_in? %>
              <%= link_to new_user_session_path, data: { turbo_frame: "auth-modal" },
                          class: ui_button_classes(variant: :outline, size: :md) do %>
                <%= icon "message-circle", class: "size-4" %><%= t("stores.header.message") %>
              <% end %>
            <% end %>
          <% end %>
          <button type="button" data-controller="share"
                  data-share-title-value="<%= @store.name %>"
                  data-share-text-value="<%= t("stores.header.share_text", store: @store.name) %>"
                  data-share-url-value="<%= store_url(@store, locale: I18n.locale) %>"
                  data-copy-prompt="<%= t("listings.show.copy_link") %>"
                  data-action="share#share"
                  class="<%= ui_button_classes(variant: :outline, size: :md) %>">
            <%= icon "arrow-up-right", class: "size-4" %>
            <span data-share-label data-copied-label="<%= t("listings.show.link_copied") %>"><%= t("stores.header.share") %></span>
          </button>
        </div>
      </div>

      <% unless chat_enabled? %>
        <p class="mt-3 rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-600 dark:bg-zinc-800 dark:text-zinc-300">
          <%= t("messaging.inbox.chat_disabled") %>
        </p>
      <% end %>

      <% if @store.on_vacation? %>
        <div class="mt-5 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
          <%= icon "clock", class: "mt-0.5 size-4 shrink-0" %>
          <div>
            <p class="font-semibold"><%= t("stores.header.vacation_title") %></p>
            <p><%= @store.vacation_message.presence || t("stores.header.vacation_body") %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div id="store-tabs" class="mt-6 flex gap-1 overflow-x-auto border-b border-slate-200 scrollbar-hide dark:border-zinc-800">
      <% { "listings" => t("stores.tabs.listings"), "about" => t("stores.tabs.about"), "reviews" => t("stores.tabs.reviews") }.each do |tab, label| %>
        <%= link_to label, store_path(@store, tab: tab, anchor: "store-tabs"),
                    class: "border-b-2 px-4 py-3 text-sm font-medium transition #{@tab == tab ? 'border-brand-600 text-brand-700 dark:text-brand-300' : 'border-transparent text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white'}",
                    data: { turbo_frame: "store-panel" } %>
      <% end %>
    </div>

    <div class="mt-6">
      <%= render "stores/tabs/#{@tab}" %>
    </div>
  </div>
</div>
