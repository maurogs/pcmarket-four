<turbo-frame id="store-panel">
  <turbo-frame id="store-reviews">
  <% unless Setting.enabled?("reviews_enabled") %>
    <%= render "shared/empty_state", title: t("stores.reviews.disabled_title"),
               body: t("stores.reviews.disabled_body") %>
  <% else %>
  <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
      <aside class="surface h-fit p-5">
        <p class="font-heading text-4xl font-bold text-slate-950 dark:text-white"><%= @store.rating_avg %></p>
        <div class="mt-1"><%= render "shared/star_rating", rating: @store.rating_avg.round %></div>
        <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400">
          <%= t("stores.reviews.based_on", count: @reviews_count, formatted: localized_count(@reviews_count)) %>
        </p>

        <div class="mt-5 space-y-2">
          <% 5.downto(1) do |rating| %>
            <% count = @rating_distribution[rating] || 0 %>
            <% percent = @reviews_count.positive? ? (count.to_f / @reviews_count * 100).round : 0 %>
            <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-zinc-400">
              <span class="w-3 text-right"><%= rating %></span>
              <%= icon "star", class: "size-3 text-accent-500" %>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100 dark:bg-zinc-800">
                <div class="h-full rounded-full bg-accent-500" style="width: <%= percent %>%"></div>
              </div>
              <span class="w-6 text-right"><%= count %></span>
            </div>
          <% end %>
        </div>
      </aside>

      <div>
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-heading text-lg font-semibold text-slate-950 dark:text-white">
            <%= t("stores.reviews.title") %>
          </h2>
          <%= form_with url: request.path, method: :get,
                        data: { turbo_frame: "store-reviews" },
                        class: "flex items-center gap-2" do %>
            <%= hidden_field_tag :tab, "reviews", id: nil %>
            <label for="review-sort" class="text-xs text-slate-500 dark:text-zinc-400"><%= t("stores.reviews.sort") %></label>
            <%= select_tag :review_sort,
                           options_for_select([
                             [ t("stores.reviews.newest"), "newest" ],
                             [ t("stores.reviews.highest"), "highest" ],
                             [ t("stores.reviews.lowest"), "lowest" ]
                           ], @review_sort),
                           id: "review-sort", class: ui_input_classes("!min-h-9 !w-auto !rounded-full !py-1 text-xs") %>
            <%= submit_tag t("stores.reviews.apply"),
                           class: ui_button_classes(variant: :outline, size: :sm) %>
          <% end %>
        </div>

        <% if @reviews.any? %>
          <div class="mt-4 space-y-4">
            <% @reviews.each do |review| %>
              <article class="surface p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="flex size-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600 dark:bg-zinc-800 dark:text-zinc-300">
                      <%= review.reviewer.initials %>
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-slate-900 dark:text-zinc-100"><%= review.reviewer.display_name %></p>
                      <p class="text-xs text-slate-500 dark:text-zinc-400"><%= month_year(review.created_at) %></p>
                    </div>
                  </div>
                  <%= render "shared/star_rating", rating: review.rating %>
                </div>
                <% if review.body.present? %>
                  <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-zinc-400"><%= review.body %></p>
                <% end %>
                <% if review.seller_reply.present? && review.seller_reply_visible? %>
                  <div class="mt-3 rounded-lg bg-slate-50 p-3 text-sm dark:bg-zinc-800/60">
                    <p class="text-xs font-semibold text-slate-500 dark:text-zinc-400"><%= t("stores.reviews.seller_reply") %></p>
                    <p class="mt-1 text-slate-600 dark:text-zinc-300"><%= review.seller_reply %></p>
                  </div>
                <% end %>
                <% if user_signed_in? && current_user.id == @store.user_id %>
                  <% if review.replied? %>
                    <%= form_with url: seller_review_reply_path(review), method: :patch, class: "mt-3 space-y-2" do |f| %>
                      <%= f.text_area :seller_reply, name: "review[seller_reply]", rows: 2,
                                      value: review.seller_reply, class: ui_input_classes("text-sm") %>
                      <%= f.submit t("seller.reviews.update_reply"), class: ui_button_classes(variant: :outline, size: :sm) %>
                    <% end %>
                  <% else %>
                    <%= form_with url: seller_review_replies_path(review_id: review.id), method: :post, class: "mt-3 space-y-2" do |f| %>
                      <%= f.text_area :seller_reply, name: "review[seller_reply]", rows: 2,
                                      placeholder: t("seller.reviews.reply_placeholder"), class: ui_input_classes("text-sm") %>
                      <%= f.submit t("seller.reviews.reply"), class: ui_button_classes(variant: :primary, size: :sm) %>
                    <% end %>
                  <% end %>
                <% end %>
              </article>
            <% end %>
          </div>
          <%= render "shared/pagination", pagy: @pagy_reviews, frame: "store-reviews" %>
        <% else %>
          <%= render "shared/empty_state", title: t("stores.reviews.empty_title"),
                     body: t("stores.reviews.empty_body") %>
        <% end %>
      </div>
    </div>
  <% end %>
  </turbo-frame>
</turbo-frame>
