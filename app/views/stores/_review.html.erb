<%# One published store review: author, stars, title/body, verified-purchase
    badge and the seller reply block. Deleted authors stay visible as
    "Deleted user" (GDPR deletion anonymizes, it never removes reviews). %>
<%# locals: (review:) %>
<% deleted_author = review.author.deleted? %>
<article class="card p-5">
  <div class="flex items-start gap-3">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-primary-100 font-display text-sm font-bold text-primary-700 dark:bg-primary-900 dark:text-primary-200">
      <% if review.author.avatar.attached? %>
        <%= image_tag url_for(review.author.avatar.variant(resize_to_fill: [ 80, 80 ], format: Listing::IMAGE_FORMAT)),
              alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
      <% elsif deleted_author %>
        ?
      <% else %>
        <%= review.author.username.first.upcase %>
      <% end %>
    </span>
    <div class="min-w-0 flex-1">
      <p class="truncate font-semibold"><%= deleted_author ? t(".deleted_user") : review.author.username %></p>
      <time class="block text-xs text-muted" datetime="<%= review.created_at.iso8601 %>"><%= l(review.created_at.to_date) %></time>
    </div>
    <div class="shrink-0"><%= review_stars(review.rating) %></div>
  </div>

  <% if review.title.present? %>
    <h3 class="mt-3 font-semibold"><%= review.title %></h3>
  <% end %>
  <% if review.body.present? %>
    <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-body"><%= review.body %></p>
  <% end %>

  <% if review.verified_purchase? %>
    <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
      <%= icon "check", class: "h-3.5 w-3.5" %>
      <%= t(".verified_purchase") %>
    </p>
  <% end %>

  <% if review.seller_reply.present? %>
    <div class="mt-4 rounded-xl border border-line bg-cream-100 p-4 dark:bg-cream-surface">
      <p class="text-xs font-semibold">
        <%= t(".seller_reply") %>
        <% if review.seller_replied_at %>
          <time class="ml-1 font-normal text-muted" datetime="<%= review.seller_replied_at.iso8601 %>"><%= l(review.seller_replied_at.to_date) %></time>
        <% end %>
      </p>
      <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-body"><%= review.seller_reply %></p>
    </div>
  <% end %>
</article>
