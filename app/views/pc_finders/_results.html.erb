<%# Locals: query (PcFinder::Query), result (PcFinder::Recommender::Result). %>
<section class="mt-8">
  <% summary = [
       [ 1, query.games.map(&:name).join(", ") ],
       [ 2, t("pc_finders.show.resolutions.#{query.resolution}") ],
       [ 3, t("pc_finders.show.fps_label", fps: query.fps) ],
       [ 4, t("pc_finders.show.budgets.#{query.budget}") ],
       [ 5, t("pc_finders.show.cases.#{query.case_pref}") ],
       [ 6, t("pc_finders.show.cooling.#{query.cooling}") ]
     ] %>
  <% if (vibe_tag = query.vibe && selectable_labels("seller_tags").index_by(&:slug)[query.vibe]) %>
    <% summary << [ 7, vibe_tag.name ] %>
  <% end %>

  <div class="flex flex-wrap items-center gap-2" aria-label="<%= t("pc_finders.show.summary.label") %>">
    <% summary.each do |number, label| %>
      <%= link_to pc_finder_path(query.to_params.merge("step" => number)), data: { turbo_action: "advance" },
            class: "flex items-center gap-1.5 rounded-full bg-primary-100 px-3 py-1.5 text-xs font-semibold text-primary-800 transition-colors hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-100 dark:hover:bg-primary-800" do %>
        <span><%= label %></span>
        <span aria-hidden="true" class="opacity-60"><%= icon "chevron-down", class: "h-3 w-3" %></span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <p class="text-sm text-muted"><%= t("pc_finders.show.results_count", count: result.pagy.count) %></p>

    <form action="<%= pc_finder_path %>" method="get" data-controller="filters" class="ml-auto flex items-center gap-2">
      <input type="hidden" name="page" value="1">
      <% query.games.each do |game| %>
        <%= hidden_field_tag "games[]", game.slug %>
      <% end %>
      <%= hidden_field_tag :resolution, query.resolution %>
      <%= hidden_field_tag :fps, query.fps %>
      <%= hidden_field_tag :budget, query.budget %>
      <%= hidden_field_tag :case_pref, query.case_pref %>
      <%= hidden_field_tag :cooling, query.cooling %>
      <%= hidden_field_tag :vibe, query.vibe if query.vibe %>
      <label class="flex items-center gap-2 text-sm">
        <span class="text-muted"><%= t("pc_finders.show.sort_label") %></span>
        <%= select_tag :sort,
              options_for_select(PcFinder::Query::SORTS.map { |value| [ t("pc_finders.show.sorts.#{value}"), value ] }, query.sort),
              class: "input-field w-auto py-1.5 text-sm", data: { action: "filters#submit" } %>
      </label>
    </form>
  </div>

  <% if result.pagy.count.zero? %>
    <div class="card mt-4 p-10 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-cream-100 text-primary-600 dark:bg-cream-surface dark:text-primary-300">
        <%= icon "search", class: "h-6 w-6" %>
      </span>
      <h2 class="mt-3 font-display text-lg font-semibold"><%= t("pc_finders.show.empty.title") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("pc_finders.show.empty.body") %></p>
    </div>
  <% else %>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
      <% result.listings.each do |listing| %>
        <div>
          <%= render "listings/card", listing: listing %>
          <%= render "performance", listing: listing, result: result %>
        </div>
      <% end %>
    </div>
    <%= render "browse/pagination", pagy: result.pagy %>
  <% end %>
</section>
