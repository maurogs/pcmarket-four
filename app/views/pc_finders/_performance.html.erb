<%# Locals: listing, result (PcFinder::Recommender::Result). Estimated FPS per
    chosen game, green when it reaches the target, amber otherwise. %>
<div class="mt-2 rounded-2xl border border-line bg-cream-100 p-3 dark:bg-cream-surface">
  <p class="text-[11px] font-extrabold uppercase tracking-widest text-muted"><%= t("pc_finders.show.performance.label") %></p>
  <ul class="mt-1.5 space-y-1">
    <% result.games.each do |game| %>
      <% fps = result.estimated_fps(listing, game) %>
      <li class="flex items-baseline justify-between gap-2 text-xs">
        <span class="truncate font-medium"><%= game.name %></span>
        <% if fps %>
          <span class="shrink-0 font-bold tabular-nums <%= fps >= result.fps ? "text-green-600 dark:text-green-400" : "text-amber-600 dark:text-amber-400" %>">
            <%= t("pc_finders.show.performance.fps", fps: fps) %>
          </span>
        <% else %>
          <span class="shrink-0 text-muted"><%= t("pc_finders.show.performance.unknown") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
