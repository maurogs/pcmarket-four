<% set_meta_tags title: t(".title"), description: t(".meta.description") %>

<div class="mx-auto max-w-7xl px-4 py-6 sm:py-8">
  <header class="text-center">
    <p class="text-xs font-extrabold uppercase tracking-widest text-primary-600 dark:text-primary-400"><%= t(".eyebrow") %></p>
    <h1 class="mx-auto mt-2 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl"><%= t(".title") %></h1>
    <p class="mx-auto mt-4 max-w-2xl text-base text-muted sm:text-lg"><%= t(".intro") %></p>
  </header>

  <%= render "quiz", query: @query, games: @games %>

  <% if @result %>
    <%= render "results", query: @query, result: @result %>
  <% else %>
    <%# Discovery tiles while the quiz has not been answered yet. %>
    <section class="mt-10" aria-labelledby="gamer-types-heading">
      <h2 id="gamer-types-heading" class="section-title text-xl sm:text-2xl"><%= t(".gamer_types.title") %></h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <% { "anime" => "heart", "minimalist" => "image", "rgb" => "sun" }.each do |slug, icon_name| %>
          <%= link_to category_path("gaming-pcs", seller_tags: [ slug ]),
                class: "card group flex items-center gap-4 p-5 hover:border-primary-300 hover:shadow-md dark:hover:border-primary-700" do %>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-600 dark:bg-primary-900 dark:text-primary-300"><%= icon icon_name %></span>
            <span>
              <span class="block font-bold"><%= t(".gamer_types.#{slug}.title") %></span>
              <span class="mt-0.5 block text-sm text-muted"><%= t(".gamer_types.#{slug}.body") %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    </section>

    <% if @games.any? %>
      <section class="mt-10" aria-labelledby="best-games-heading">
        <h2 id="best-games-heading" class="section-title text-xl sm:text-2xl"><%= t(".best_games.title") %></h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% @games.each do |game| %>
            <%= link_to pc_finder_path(games: [ game.slug ]),
                  class: "card group flex items-center gap-3 p-4 hover:border-primary-300 hover:shadow-md dark:hover:border-primary-700" do %>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-primary-100 text-sm font-bold text-primary-700 dark:bg-primary-900 dark:text-primary-200">
                <% if game.image.attached? %>
                  <%= image_tag url_for(game.image), alt: "", class: "h-full w-full object-cover" %>
                <% else %>
                  <%= game.name.first %>
                <% end %>
              </span>
              <span class="text-sm font-semibold group-hover:text-primary-700 dark:group-hover:text-primary-300"><%= t(".best_games.cta", game: game.name) %></span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
