<%# Frame body: toolbar, active filters, grid, pagination. Local: result. %>
<div class="mb-3 flex flex-wrap items-center gap-3">
  <button type="button" class="btn-secondary gap-2 lg:hidden" data-action="drawer#open"
          aria-controls="mobile-filters" aria-expanded="false">
    <%= icon "filter", class: "h-4 w-4" %>
    <%= t("browse.filters.title") %>
    <% count = selected_filter_count %>
    <% if count.positive? %><span class="font-bold">(<%= count %>)</span><% end %>
  </button>

  <p class="text-sm text-muted"><%= t("browse.results_count", count: result.pagy.count) %></p>

  <form action="<%= request.path %>" method="get" data-controller="filters"
        data-turbo-frame="browse_results" data-turbo-action="advance" class="ml-auto flex items-center gap-2">
    <input type="hidden" name="page" value="1">
    <%= hidden_filter_fields(except: ["sort"]) %>
    <label class="flex items-center gap-2 text-sm">
      <span class="text-muted"><%= t("browse.sort_label") %></span>
      <%= select_tag :sort, options_for_select(sort_options_for_select, current_sort),
            class: "input-field w-auto py-1.5 text-sm", data: { action: "filters#submit" } %>
    </label>
  </form>
</div>

<% pills = active_filters(result) %>
<% if pills.any? %>
  <div class="mb-4 flex flex-wrap items-center gap-2" aria-label="<%= t("browse.filters.applied") %>">
    <% pills.each do |pill| %>
      <%= link_to pill[:remove_url], data: { turbo_action: "advance" },
            class: "group flex items-center gap-1.5 rounded-full bg-primary-100 px-3 py-1 text-xs font-semibold text-primary-800 transition-colors hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-100 dark:hover:bg-primary-800" do %>
        <span><%= pill[:label] %></span>
        <span aria-hidden="true" title="<%= t("browse.filters.remove") %>"><%= icon "close", class: "h-3 w-3 opacity-60 group-hover:opacity-100" %></span>
      <% end %>
    <% end %>
    <%= link_to t("browse.filters.clear_all"), clear_filters_url, data: { turbo_action: "advance" },
          class: "px-1 text-xs font-semibold text-muted underline hover:text-body" %>
  </div>
<% end %>

<% if result.pagy.count.zero? %>
  <div class="card p-10 text-center">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-cream-100 text-primary-600 dark:bg-cream-surface dark:text-primary-300">
      <%= icon "search", class: "h-6 w-6" %>
    </span>
    <h2 class="mt-3 font-display text-lg font-semibold"><%= t("browse.empty.title") %></h2>
    <p class="mt-1 text-sm text-muted"><%= t("browse.empty.body") %></p>
    <%# Placeholder until saved searches ship (Phase 4). %>
    <%= link_to t("browse.empty.save_search"), "#", class: "btn-secondary mt-4" %>
  </div>
<% else %>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
    <%= render partial: "listings/card", collection: result.listings, as: :listing %>
  </div>
  <%= render "browse/pagination", pagy: result.pagy %>
<% end %>
