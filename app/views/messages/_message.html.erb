<% viewer = local_assigns[:viewer] %>
<% own = viewer.present? && message.sender_id == viewer.id %>

<% if message.system? %>
  <p class="mx-auto max-w-md rounded-full bg-slate-100 px-4 py-2 text-center text-xs font-medium text-slate-600 dark:bg-zinc-800 dark:text-zinc-300">
    <%= message.body %>
  </p>
<% else %>
  <div class="flex <%= own ? "justify-end" : "justify-start" %>">
    <div class="max-w-[85%] space-y-1.5">
      <% unless own %>
        <p class="text-[11px] font-semibold text-slate-500 dark:text-zinc-400"><%= message.sender.display_name %></p>
      <% end %>

      <% if message.flagged? && !own %>
        <div class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
          <%= icon "shield-check", class: "mt-0.5 size-3.5 shrink-0" %>
          <span><%= t("messaging.safety.warning") %></span>
        </div>
      <% end %>

      <% if message.offer? %>
        <div class="rounded-2xl border <%= own ? "border-brand-200 bg-brand-50 dark:border-brand-500/30 dark:bg-brand-500/10" : "border-slate-200 bg-white dark:border-zinc-700 dark:bg-zinc-900" %> p-3">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("messaging.offers.label") %></p>
          <p class="mt-0.5 font-heading text-xl font-bold text-slate-950 dark:text-white"><%= format_price(message.offer_amount_cents) %></p>
          <p class="mt-1 inline-flex <%= ui_badge_classes(tone: offer_status_tone(message), extra: "!px-2 !py-0.5") %>">
            <%= t("messaging.offers.statuses.#{message.offer_status}") %>
          </p>
          <% if message.offer_pending? && !message.offer_expired? %>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-zinc-400">
              <%= t("messaging.offers.expires_at", time: l(message.effective_offer_expiry, format: :short)) %>
            </p>
          <% end %>
          <p class="mt-2 whitespace-pre-line text-sm text-slate-700 dark:text-zinc-200"><%= message.body %></p>

          <% if !own && message.offer_pending? && !message.offer_expired? %>
            <div class="mt-3 space-y-2">
              <div class="flex flex-wrap gap-2">
                <%= button_to t("messaging.offers.accept"), message_offer_response_path(message, decision: "accept"),
                              method: :post, class: ui_button_classes(variant: :primary, size: :sm) %>
                <%= button_to t("messaging.offers.decline"), message_offer_response_path(message, decision: "decline"),
                              method: :post, class: ui_button_classes(variant: :outline, size: :sm) %>
              </div>
              <%= form_with url: message_offer_response_path(message), method: :post, class: "flex items-end gap-2" do %>
                <%= hidden_field_tag :decision, "counter" %>
                <%= number_field_tag :amount, nil, step: "0.01", min: "0.01", required: true,
                                     class: ui_input_classes("!min-h-9 !py-1.5 text-xs"),
                                     placeholder: t("messaging.offers.counter_placeholder"),
                                     aria: { label: t("messaging.offers.counter_amount") } %>
                <%= submit_tag t("messaging.offers.counter"), class: ui_button_classes(variant: :outline, size: :sm) %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="whitespace-pre-line rounded-2xl px-4 py-2.5 text-sm <%= own ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-800 dark:bg-zinc-800 dark:text-zinc-100" %>">
          <%= message.body %>
        </div>
      <% end %>

      <p class="flex items-center gap-1 text-[11px] text-slate-400 <%= own ? "justify-end" : "" %> dark:text-zinc-500">
        <span><%= l(message.created_at, format: :short) %></span>
        <% if own %>
          <span aria-label="<%= message.read? ? t("messaging.thread.read") : t("messaging.thread.sent") %>"
                title="<%= message.read? ? t("messaging.thread.read") : t("messaging.thread.sent") %>">
            <%= message.read? ? "✓✓" : "✓" %>
          </span>
        <% end %>
      </p>
    </div>
  </div>
<% end %>
