<div class="page-container py-8 sm:py-12">
  <div class="mx-auto grid max-w-5xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[var(--shadow-card)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] dark:border-zinc-800 dark:bg-zinc-900">
    <aside class="relative hidden flex-col justify-between overflow-hidden bg-brand-900 p-8 text-brand-50 lg:flex">
      <div class="pointer-events-none absolute -right-20 -top-20 size-72 rounded-full bg-brand-700/60 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-16 size-72 rounded-full bg-accent-500/20 blur-3xl"></div>

      <div class="relative">
        <p class="font-heading text-2xl font-bold text-white"><%= site_name %></p>
        <p class="mt-2 max-w-xs text-sm text-brand-200"><%= t("auth.shared.brand_body") %></p>
      </div>

      <div class="relative mt-10" data-controller="carousel" data-carousel-interval-value="7000">
        <% 3.times do |index| %>
          <figure data-carousel-target="slide" <%= "hidden" unless index.zero? %> class="min-h-36">
            <blockquote class="font-heading text-lg leading-snug text-white">
              “<%= t("auth.shared.testimonials.#{index + 1}.quote") %>”
            </blockquote>
            <figcaption class="mt-3 text-xs font-medium text-brand-200">
              <%= t("auth.shared.testimonials.#{index + 1}.author") %>
            </figcaption>
          </figure>
        <% end %>
        <div class="mt-4 flex gap-1.5">
          <% 3.times do |index| %>
            <button type="button" data-carousel-target="dot" data-index="<%= index %>"
                    data-action="carousel#goTo" aria-label="<%= t("auth.shared.testimonial", number: index + 1) %>"
                    class="size-2 rounded-full <%= index.zero? ? 'bg-white' : 'bg-white/40' %>"></button>
          <% end %>
        </div>
      </div>

      <ul class="relative mt-10 space-y-2 text-xs text-brand-200">
        <li class="flex items-center gap-2"><%= icon "shield-check", class: "size-4" %><%= t("auth.shared.point_1") %></li>
        <li class="flex items-center gap-2"><%= icon "truck", class: "size-4" %><%= t("auth.shared.point_2") %></li>
        <li class="flex items-center gap-2"><%= icon "heart", class: "size-4" %><%= t("auth.shared.point_3") %></li>
      </ul>
    </aside>

    <turbo-frame id="auth-modal" target="_top" class="block p-6 sm:p-8 lg:p-10">
      <div class="mx-auto w-full max-w-sm">
        <h1 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= title %></h1>
        <% if subtitle.present? %>
          <p class="mt-1.5 text-sm text-slate-600 dark:text-zinc-400"><%= subtitle %></p>
        <% end %>

        <div class="mt-6">
          <%= yield %>
        </div>
      </div>
    </turbo-frame>
  </div>
</div>
