<div class="mx-auto max-w-md px-4 py-12">
  <div class="card p-8">
    <h1 class="text-center font-display text-2xl font-bold"><%= t(".sign_in") %></h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mt-6 space-y-4">
        <div>
          <%= f.label :email, class: "block text-sm font-medium" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field mt-1" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "input-field mt-1" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 text-sm">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-line-strong accent-primary-600" %>
            <%= t(".remember_me") %>
          </label>
        <% end %>

        <%= f.submit t(".sign_in"), class: "btn-primary w-full cursor-pointer" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
