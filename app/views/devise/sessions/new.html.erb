<% content_for :title, t("auth.sign_in.title") %>

<%= render "devise/shared/auth_shell",
           title: t("auth.sign_in.title"), subtitle: t("auth.sign_in.subtitle") do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
               html: { class: "space-y-4" }) do |form| %>
    <div>
      <%= form.label :email, t("auth.fields.email"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email",
                           class: ui_input_classes, placeholder: t("auth.fields.email_placeholder") %>
    </div>

    <div>
      <div class="mb-1.5 flex items-center justify-between gap-3">
        <%= form.label :password, t("auth.fields.password"), class: "block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
        <%= link_to t("auth.sign_in.forgot"), new_user_password_path,
                    class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
      </div>
      <%= form.password_field :password, autocomplete: "current-password",
                             class: ui_input_classes, placeholder: t("auth.fields.password_placeholder") %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-600 dark:text-zinc-300">
        <%= form.check_box :remember_me, class: "size-4 rounded border-slate-300 text-brand-700 focus:ring-brand-500 dark:border-zinc-600 dark:bg-zinc-800" %>
        <%= t("auth.sign_in.remember") %>
      </label>
    <% end %>

    <%= form.submit t("auth.sign_in.submit"),
                    class: ui_button_classes(variant: :primary, size: :lg, extra: "w-full") %>
  <% end %>

  <% if ENV["GOOGLE_CLIENT_ID"].present? && ENV["GOOGLE_CLIENT_SECRET"].present? %>
    <div class="mt-5 flex items-center gap-3 text-xs text-slate-400 dark:text-zinc-500">
      <span class="h-px flex-1 bg-slate-200 dark:bg-zinc-800"></span>
      <%= t("auth.shared.or") %>
      <span class="h-px flex-1 bg-slate-200 dark:bg-zinc-800"></span>
    </div>
    <%= button_to "/auth/google_oauth2", method: :post,
                  form: { data: { turbo: false } },
                  class: ui_button_classes(variant: :outline, size: :lg, extra: "mt-4 w-full") do %>
      <%= icon "log-in", class: "size-4" %><%= t("auth.shared.google") %>
    <% end %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600 dark:text-zinc-400">
    <%= t("auth.sign_in.no_account") %>
    <%= link_to t("auth.sign_in.sign_up"), new_user_registration_path,
                class: "font-semibold text-brand-700 hover:underline dark:text-brand-300",
                data: { turbo_frame: "_top" } %>
  </p>
<% end %>
