<% content_for :title, t("auth.sign_up.title") %>

<%= render "devise/shared/auth_shell",
           title: t("auth.sign_up.title"), subtitle: t("auth.sign_up.subtitle") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "space-y-4" }) do |form| %>
    <% if resource.errors.any? %>
      <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800 dark:border-rose-500/30 dark:bg-rose-950/50 dark:text-rose-200">
        <ul class="space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, t("auth.fields.first_name"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
        <%= form.text_field :first_name, autocomplete: "given-name", class: ui_input_classes %>
      </div>
      <div>
        <%= form.label :last_name, t("auth.fields.last_name"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
        <%= form.text_field :last_name, autocomplete: "family-name", class: ui_input_classes %>
      </div>
    </div>

    <div>
      <%= form.label :username, t("auth.fields.username"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.text_field :username, autocomplete: "nickname", class: ui_input_classes,
                           placeholder: t("auth.fields.username_placeholder") %>
      <p class="mt-1 text-xs text-slate-500 dark:text-zinc-500"><%= t("auth.fields.username_hint") %></p>
    </div>

    <div>
      <%= form.label :email, t("auth.fields.email"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.email_field :email, autocomplete: "email", class: ui_input_classes %>
    </div>

    <div>
      <%= form.label :password, t("auth.fields.password"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.password_field :password, autocomplete: "new-password", class: ui_input_classes %>
      <p class="mt-1 text-xs text-slate-500 dark:text-zinc-500"><%= t("auth.sign_up.password_hint") %></p>
    </div>

    <div>
      <%= form.label :password_confirmation, t("auth.fields.password_confirmation"),
                     class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: ui_input_classes %>
    </div>

    <div class="space-y-2 rounded-xl bg-slate-50 p-3 dark:bg-zinc-800/60">
      <label class="flex cursor-pointer items-start gap-2 text-sm text-slate-600 dark:text-zinc-300">
        <%= check_box_tag "user[terms_accepted]", "1", false,
                          id: "user_terms_accepted",
                          class: "mt-0.5 size-4 rounded border-slate-300 text-brand-700 focus:ring-brand-500 dark:border-zinc-600 dark:bg-zinc-800",
                          required: true %>
        <span>
          <%= t("auth.sign_up.terms") %>
          <%= link_to t("auth.sign_up.terms_link"), legal_page_path("terms"),
                      class: "font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
          <%= t("auth.sign_up.and") %>
          <%= link_to t("auth.sign_up.privacy_link"), legal_page_path("privacy"),
                      class: "font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
        </span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm text-slate-600 dark:text-zinc-300">
        <%= form.check_box :accepts_marketing,
                           class: "mt-0.5 size-4 rounded border-slate-300 text-brand-700 focus:ring-brand-500 dark:border-zinc-600 dark:bg-zinc-800" %>
        <span>
          <%= t("auth.sign_up.marketing") %>
          <span class="block text-xs text-slate-500 dark:text-zinc-500"><%= t("auth.sign_up.marketing_hint") %></span>
        </span>
      </label>
    </div>

    <%= form.submit t("auth.sign_up.submit"),
                    class: ui_button_classes(variant: :primary, size: :lg, extra: "w-full") %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600 dark:text-zinc-400">
    <%= t("auth.sign_up.have_account") %>
    <%= link_to t("auth.sign_up.sign_in"), new_user_session_path,
                class: "font-semibold text-brand-700 hover:underline dark:text-brand-300",
                data: { turbo_frame: "_top" } %>
  </p>
<% end %>
