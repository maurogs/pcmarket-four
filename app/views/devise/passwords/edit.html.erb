<% content_for :title, t("auth.reset.title") %>

<%= render "devise/shared/auth_shell",
           title: t("auth.reset.title"), subtitle: t("auth.reset.subtitle") do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "space-y-4" }) do |form| %>
    <%= form.hidden_field :reset_password_token %>
    <div>
      <%= form.label :password, t("auth.fields.new_password"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.password_field :password, autofocus: true, autocomplete: "new-password", class: ui_input_classes %>
      <p class="mt-1 text-xs text-slate-500 dark:text-zinc-500"><%= t("auth.sign_up.password_hint") %></p>
    </div>
    <div>
      <%= form.label :password_confirmation, t("auth.fields.password_confirmation"),
                     class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: ui_input_classes %>
    </div>
    <%= form.submit t("auth.reset.submit"),
                    class: ui_button_classes(variant: :primary, size: :lg, extra: "w-full") %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    <%= link_to t("auth.reset.back"), new_user_session_path,
                class: "font-semibold text-brand-700 hover:underline dark:text-brand-300",
                data: { turbo_frame: "_top" } %>
  </p>
<% end %>
