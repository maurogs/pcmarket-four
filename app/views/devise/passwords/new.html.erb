<% content_for :title, t("auth.forgot.title") %>

<%= render "devise/shared/auth_shell",
           title: t("auth.forgot.title"), subtitle: t("auth.forgot.subtitle") do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :post, class: "space-y-4" }) do |form| %>
    <div>
      <%= form.label :email, t("auth.fields.email"), class: "mb-1.5 block text-sm font-medium text-slate-700 dark:text-zinc-300" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: ui_input_classes %>
    </div>
    <%= form.submit t("auth.forgot.submit"),
                    class: ui_button_classes(variant: :primary, size: :lg, extra: "w-full") %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600 dark:text-zinc-400">
    <%= link_to t("auth.forgot.back"), new_user_session_path,
                class: "font-semibold text-brand-700 hover:underline dark:text-brand-300",
                data: { turbo_frame: "_top" } %>
  </p>
<% end %>
