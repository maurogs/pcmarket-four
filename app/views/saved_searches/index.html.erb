<% content_for :title, t("saved_searches.title") %>

<div class="page-container py-8 sm:py-10">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white">
        <%= t("saved_searches.title") %>
      </h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-zinc-400"><%= t("saved_searches.body") %></p>
    </div>
    <%= link_to t("saved_searches.browse"), listings_path,
                class: ui_button_classes(variant: :outline, size: :md) %>
  </div>

  <% if @saved_searches.any? %>
    <div class="mt-8 space-y-3">
      <% @saved_searches.each do |saved_search| %>
        <%= render "saved_searches/saved_search", saved_search: saved_search %>
      <% end %>
    </div>
  <% else %>
    <div class="surface mt-8">
      <%= render "shared/empty_state", title: t("saved_searches.empty_title"),
                 body: t("saved_searches.empty_body"),
                 cta_label: t("saved_searches.empty_cta"), cta_path: listings_path %>
    </div>
  <% end %>
</div>
