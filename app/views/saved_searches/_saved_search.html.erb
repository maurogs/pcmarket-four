<div id="saved-search-<%= saved_search.id %>" class="surface space-y-3 p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 flex-1">
      <%= form_with model: saved_search, url: saved_search_path(saved_search), method: :patch,
                    data: { turbo_stream: true }, class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="min-w-0 flex-1">
          <%= form.label :name, t("saved_searches.name"), class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.text_field :name, required: true, maxlength: 80,
                              class: ui_input_classes("!min-h-9 !py-1.5 text-sm") %>
        </div>
        <div>
          <%= form.label :frequency, t("saved_searches.frequency_label"), class: "mb-1 block text-xs font-medium text-slate-600 dark:text-zinc-300" %>
          <%= form.select :frequency,
                          SavedSearch.frequencies.keys.map { |key| [ t("saved_searches.frequencies.#{key}"), key ] },
                          {}, class: ui_input_classes("!min-h-9 !py-1.5 text-sm") %>
        </div>
        <%= form.submit t("saved_searches.save"), class: ui_button_classes(variant: :outline, size: :sm) %>
      <% end %>

      <p class="mt-2 text-xs text-slate-500 dark:text-zinc-400">
        <%= saved_search.category&.name || t("saved_searches.all_categories") %>
        <% if saved_search.min_price_cents || saved_search.max_price_cents %>
          · <%= t("saved_searches.price_range",
                 min: saved_search.min_price_cents ? format_price(saved_search.min_price_cents) : t("saved_searches.any"),
                 max: saved_search.max_price_cents ? format_price(saved_search.max_price_cents) : t("saved_searches.any")) %>
        <% end %>
        · <%= t("saved_searches.created_on", date: l(saved_search.created_at.to_date, format: :short)) %>
        · <%= t("saved_searches.frequencies.#{saved_search.frequency}") %>
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <%= link_to t("saved_searches.view"), saved_search_results_path(saved_search),
                  class: ui_button_classes(variant: :outline, size: :sm) %>
      <%= button_to saved_search_path(saved_search,
                                      saved_search: { notify: !saved_search.notify? }),
                    method: :patch,
                    form: { data: { turbo_stream: true } },
                    class: "inline-flex size-9 items-center justify-center rounded-full border #{saved_search.notify? ? 'border-brand-300 bg-brand-50 text-brand-700 dark:border-brand-700 dark:bg-brand-900/30 dark:text-brand-200' : 'border-slate-200 text-slate-500 dark:border-zinc-700 dark:text-zinc-400'}",
                    aria: { label: saved_search_toggle_label(saved_search), pressed: saved_search.notify?.to_s },
                    title: saved_search_toggle_label(saved_search) do %>
        <%= icon "bell", class: "size-4" %>
      <% end %>
      <%= button_to saved_search_path(saved_search), method: :delete,
                    form: { data: { turbo_confirm: t("saved_searches.confirm_delete") } },
                    class: "inline-flex size-9 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:border-rose-300 hover:text-rose-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-rose-500 dark:hover:text-rose-400",
                    aria: { label: t("saved_searches.delete") } do %>
        <%= icon "x", class: "size-4" %>
      <% end %>
    </div>
  </div>
</div>
