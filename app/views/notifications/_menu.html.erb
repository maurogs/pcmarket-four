<%= turbo_frame_tag "notifications-menu" do %>
  <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-3 py-2 dark:border-zinc-800">
    <p class="text-sm font-semibold text-slate-900 dark:text-zinc-100"><%= t("notifications.title") %></p>
    <% if @unread_count.positive? %>
      <%= button_to t("notifications.read_all.label"), notifications_read_all_path,
                    method: :post,
                    class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
    <% end %>
  </div>

  <% notifications = @notifications.first(8) %>
  <% if notifications.any? %>
    <ul class="divide-y divide-slate-100 dark:divide-zinc-800">
      <% notifications.each do |notification| %>
        <li class="<%= "bg-brand-50/60 dark:bg-brand-500/5" unless notification.read? %>">
          <%= button_to notification_path(notification), method: :patch,
                        class: "flex w-full items-start gap-2 px-3 py-2.5 text-left transition hover:bg-slate-50 dark:hover:bg-zinc-800/60" do %>
            <span class="mt-1 size-1.5 shrink-0 rounded-full <%= notification.read? ? "bg-slate-300 dark:bg-zinc-600" : "bg-accent-500" %>"></span>
            <span class="min-w-0">
              <span class="block text-sm leading-5 text-slate-700 dark:text-zinc-300"><%= notification_text(notification) %></span>
              <span class="mt-0.5 block text-[11px] text-slate-400 dark:text-zinc-500"><%= l(notification.created_at, format: :short) %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-3 py-6 text-center text-sm text-slate-500 dark:text-zinc-400"><%= t("notifications.empty") %></p>
  <% end %>

  <div class="border-t border-slate-200 px-3 py-2 dark:border-zinc-800">
    <%= link_to t("notifications.view_all"), notifications_path,
                class: "block text-center text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
  </div>
<% end %>
