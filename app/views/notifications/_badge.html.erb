<span id="notifications-badge">
  <% if count.to_i.positive? %>
    <span class="absolute right-1 top-1 flex size-5 items-center justify-center rounded-full bg-accent-500 text-[10px] font-bold text-slate-950"
          aria-label="<%= t("layout.header.notifications_count", count: count) %>">
      <%= count.to_i > 9 ? "9+" : count.to_i %>
    </span>
  <% end %>
</span>
