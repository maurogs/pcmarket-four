<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t("maintenance.title") %> · <%= Setting.get("site_name", "PCMarket") %></title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem;
             font-family: Inter, system-ui, -apple-system, sans-serif; background: #f8fafc; color: #0f172a; }
      .card { max-width: 34rem; text-align: center; background: #fff; border: 1px solid #e2e8f0;
              border-radius: 1rem; padding: 2.5rem; box-shadow: 0 12px 32px rgb(15 23 42 / 0.08); }
      .logo { display: inline-flex; width: 3rem; height: 3rem; align-items: center; justify-content: center;
              border-radius: .9rem; background: #0f766e; color: #fff; font-weight: 700; }
      h1 { margin: 1.25rem 0 .5rem; font-size: 1.6rem; }
      p { margin: 0; color: #475569; line-height: 1.6; }
      @media (prefers-color-scheme: dark) {
        body { background: #09090b; color: #f4f4f5; }
        .card { background: #18181b; border-color: #27272a; }
        p { color: #a1a1aa; }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <span class="logo">PC</span>
      <h1><%= t("maintenance.title") %></h1>
      <p><%= t("maintenance.body") %></p>
    </main>
  </body>
</html>
