<% content_for :title, t("content.about.title") %>

<section class="border-b border-slate-200 bg-gradient-to-b from-accent-50/60 via-white to-white dark:border-zinc-800 dark:from-accent-500/10 dark:via-zinc-950 dark:to-zinc-950">
  <div class="page-container py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <span class="<%= ui_badge_classes(tone: :accent) %>"><%= icon "sparkles", class: "size-3.5" %><%= t("content.about.eyebrow") %></span>
        <h1 class="section-heading mt-4"><%= t("content.about.hero_title") %></h1>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 dark:text-zinc-400"><%= t("content.about.hero_body") %></p>
        <div class="mt-7 flex flex-wrap gap-3">
          <%= link_to t("content.about.hero_primary_cta"), search_path, class: ui_button_classes(variant: :primary, size: :md) %>
          <%= link_to t("content.about.hero_secondary_cta"), trust_path, class: ui_button_classes(variant: :outline, size: :md) %>
        </div>
      </div>
      <div class="surface p-6">
        <h2 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.about.mission.title") %></h2>
        <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.about.mission.body") %></p>
        <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4 dark:border-zinc-800">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("content.about.mission.stat1_label") %></dt>
            <dd class="mt-1 font-heading text-xl font-bold text-slate-950 dark:text-white"><%= t("content.about.mission.stat1_value") %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-zinc-500"><%= t("content.about.mission.stat2_label") %></dt>
            <dd class="mt-1 font-heading text-xl font-bold text-slate-950 dark:text-white"><%= t("content.about.mission.stat2_value") %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="page-container py-14 sm:py-16" aria-labelledby="about-why-title">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start">
    <div>
      <h2 id="about-why-title" class="section-heading"><%= t("content.about.why.title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.about.why.body") %></p>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2">
      <% t("content.about.why.items").each do |item| %>
        <li class="surface p-5">
          <span class="text-brand-700 dark:text-brand-300"><%= icon "rotate-ccw", class: "size-5" %></span>
          <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= item[:title] || item["title"] %></h3>
          <p class="mt-1 text-xs leading-6 text-slate-600 dark:text-zinc-400"><%= item[:body] || item["body"] %></p>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<section class="border-y border-slate-200 bg-white py-14 dark:border-zinc-800 dark:bg-zinc-900/30" aria-labelledby="about-how-title">
  <div class="page-container">
    <h2 id="about-how-title" class="section-heading text-center"><%= t("content.about.how.title") %></h2>
    <p class="mt-3 text-center text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.about.how.body") %></p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <div class="surface p-6">
        <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.about.how.buyers_title") %></h3>
        <ol class="mt-4 space-y-3">
          <% t("content.about.how.buyers_steps").each_with_index do |step, index| %>
            <li class="flex gap-3 text-sm text-slate-600 dark:text-zinc-400">
              <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-800 dark:bg-brand-900/50 dark:text-brand-200"><%= index + 1 %></span>
              <span><%= step %></span>
            </li>
          <% end %>
        </ol>
        <%= link_to t("content.about.how.buyers_cta"), search_path, class: "mt-5 inline-flex text-sm font-semibold text-brand-700 dark:text-brand-300" %>
      </div>
      <div class="surface p-6">
        <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.about.how.sellers_title") %></h3>
        <ol class="mt-4 space-y-3">
          <% t("content.about.how.sellers_steps").each_with_index do |step, index| %>
            <li class="flex gap-3 text-sm text-slate-600 dark:text-zinc-400">
              <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-100 text-xs font-bold text-accent-700 dark:bg-accent-500/20 dark:text-accent-300"><%= index + 1 %></span>
              <span><%= step %></span>
            </li>
          <% end %>
        </ol>
        <%= link_to t("content.about.how.sellers_cta"), new_listing_path, class: "mt-5 inline-flex text-sm font-semibold text-brand-700 dark:text-brand-300" %>
      </div>
    </div>
  </div>
</section>

<section class="page-container py-14 sm:py-16" aria-labelledby="about-values-title">
  <h2 id="about-values-title" class="section-heading text-center"><%= t("content.about.values.title") %></h2>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% t("content.about.values.items").each do |item| %>
      <div class="surface p-5">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "shield-check", class: "size-5" %></span>
        <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= item[:title] || item["title"] %></h3>
        <p class="mt-1 text-xs leading-6 text-slate-600 dark:text-zinc-400"><%= item[:body] || item["body"] %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="border-y border-slate-200 bg-white py-14 dark:border-zinc-800 dark:bg-zinc-900/30" aria-labelledby="about-team-title">
  <div class="page-container">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="about-team-title" class="section-heading"><%= t("content.about.team.title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.about.team.body") %></p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <% t("content.about.team.members").each_with_index do |member, index| %>
        <div class="surface p-6 text-center">
          <span class="mx-auto inline-flex size-16 items-center justify-center rounded-full font-heading text-lg font-bold <%= %w[bg-brand-100 text-brand-800 dark:bg-brand-900/50 dark:text-brand-200 bg-accent-100 text-accent-700 dark:bg-accent-500/20 dark:text-accent-300 bg-slate-200 text-slate-700 dark:bg-zinc-800 dark:text-zinc-200][index % 3] %>">
            <%= member[:initials] || member["initials"] %>
          </span>
          <h3 class="mt-4 text-sm font-semibold text-slate-900 dark:text-white"><%= member[:role] || member["role"] %></h3>
          <p class="mt-1 text-xs leading-6 text-slate-600 dark:text-zinc-400"><%= member[:body] || member["body"] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="page-container py-14">
  <div class="surface flex flex-col items-center gap-4 p-8 text-center">
    <h2 class="font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("content.about.contact.title") %></h2>
    <p class="max-w-xl text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.about.contact.body") %></p>
    <div class="flex flex-wrap justify-center gap-3">
      <%= link_to t("content.about.contact.help"), help_articles_path, class: ui_button_classes(variant: :primary, size: :md) %>
      <%= mail_to Setting.get("contact_email"), t("content.about.contact.email"),
                  class: ui_button_classes(variant: :outline, size: :md) %>
    </div>
  </div>
</section>
