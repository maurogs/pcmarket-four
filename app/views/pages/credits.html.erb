<div class="page-container py-10">
  <nav class="mb-5 flex items-center gap-1.5 text-xs text-slate-500 dark:text-zinc-400"
       aria-label="<%= t("demo_credits.title") %>">
    <%= link_to t("layout.tab_bar.home"), root_path,
                class: "hover:text-brand-700 dark:hover:text-brand-300" %>
    <span aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-zinc-200"><%= t("demo_credits.title") %></span>
  </nav>

  <header class="max-w-3xl">
    <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
      <%= t("demo_credits.title") %>
    </h1>
    <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-zinc-400"><%= t("demo_credits.intro") %></p>
  </header>

  <% if @credits.any? %>
    <% @credits.group_by { |entry| entry["source"] }.sort_by { |source, _entries| source.to_s }.each do |source, entries| %>
      <section class="mt-10" aria-labelledby="credits-<%= source.to_s.parameterize %>">
        <h2 id="credits-<%= source.to_s.parameterize %>"
            class="font-heading text-xl font-semibold text-slate-950 dark:text-white">
          <%= source.presence || t("demo_credits.source_label") %>
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% entries.each do |entry| %>
            <li class="surface p-4">
              <p class="text-sm font-medium text-slate-900 dark:text-white">
                <%= entry["creator"].presence || t("demo_credits.creator_unknown") %>
              </p>
              <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400">
                <%= entry["query"] %>
              </p>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                <% if entry["source_url"].present? %>
                  <%= link_to t("demo_credits.source_label"),
                              entry["source_url"], target: "_blank", rel: "noopener noreferrer",
                              class: "font-medium text-brand-700 hover:underline dark:text-brand-300" %>
                <% end %>
                <% if entry["license_url"].present? %>
                  <%= link_to entry["license"].presence || t("demo_credits.license_label"),
                              entry["license_url"], target: "_blank", rel: "noopener noreferrer",
                              class: "text-slate-600 hover:underline dark:text-zinc-300" %>
                <% else %>
                  <span class="text-slate-500 dark:text-zinc-400">
                    <%= entry["license"].presence || t("demo_credits.license_label") %>
                  </span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="mt-8 rounded-xl border border-slate-200 bg-white px-4 py-6 text-sm text-slate-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
      <%= t("demo_credits.empty") %>
    </p>
  <% end %>

  <div class="mt-10">
    <%= link_to t("demo_credits.back_home"), root_path,
                class: ui_button_classes(variant: :outline, size: :md) %>
  </div>
</div>
