<% content_for :title, t("content.trust.title") %>
<% stats = @trust_stats %>
<% stat_keys = %i[completed_orders verified_stores average_rating reviewed_listings] %>

<script type="application/ld+json" nonce="<%= content_security_policy_nonce %>"><%= trust_faq_json_ld %></script>

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 via-white to-white dark:border-zinc-800 dark:from-brand-950/40 dark:via-zinc-950 dark:to-zinc-950">
  <div class="page-container py-14 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class="<%= ui_badge_classes(tone: :brand) %>">
        <%= icon "shield-check", class: "size-3.5" %>
        <%= t("content.trust.eyebrow") %>
      </span>
      <h1 class="section-heading mt-4"><%= t("content.trust.hero_title") %></h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-slate-600 dark:text-zinc-400"><%= t("content.trust.hero_body") %></p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <%= link_to t("content.trust.hero_primary_cta"), search_path,
                    class: ui_button_classes(variant: :primary, size: :lg) %>
        <%= link_to t("content.trust.hero_secondary_cta"), help_articles_path,
                    class: ui_button_classes(variant: :outline, size: :lg) %>
      </div>
    </div>
  </div>
</section>

<section class="page-container -mt-8 sm:-mt-10" aria-labelledby="trust-stats-title">
  <h2 id="trust-stats-title" class="sr-only"><%= t("content.trust.stats.title") %></h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% stat_keys.each do |key| %>
      <div class="surface p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400"><%= t("content.trust.stats.#{key}.label") %></p>
        <p class="mt-2 font-heading text-2xl font-bold tracking-tight text-slate-950 dark:text-white"><%= trust_stat_display(key, stats[key]) %></p>
        <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-500"><%= t("content.trust.stats.#{key}.hint") %></p>
      </div>
    <% end %>
  </div>
  <p class="mt-3 text-center text-xs text-slate-500 dark:text-zinc-500"><%= t("content.trust.stats.note") %></p>
</section>

<section class="page-container py-14 sm:py-16" aria-labelledby="trust-how-title">
  <div class="mx-auto max-w-2xl text-center">
    <h2 id="trust-how-title" class="section-heading"><%= t("content.trust.how.title") %></h2>
    <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.trust.how.body", days: Setting.get("inspection_window_days", 2)) %></p>
  </div>
  <ol class="mt-8 grid gap-4 md:grid-cols-3">
    <% 1.upto(3) do |step| %>
      <li class="surface p-6">
        <span class="inline-flex size-9 items-center justify-center rounded-full bg-brand-700 font-heading text-sm font-bold text-white"><%= step %></span>
        <h3 class="mt-4 font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.trust.how.step#{step}_title") %></h3>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-zinc-400"><%= t("content.trust.how.step#{step}_body") %></p>
      </li>
    <% end %>
  </ol>
</section>

<section class="border-y border-slate-200 bg-white py-14 dark:border-zinc-800 dark:bg-zinc-900/30" aria-labelledby="trust-covered-title">
  <div class="page-container grid gap-8 lg:grid-cols-2 lg:items-start">
    <div>
      <span class="<%= ui_badge_classes(tone: :success) %>"><%= icon "shield-check", class: "size-3.5" %><%= t("content.trust.covered.eyebrow") %></span>
      <h2 id="trust-covered-title" class="section-heading mt-3"><%= t("content.trust.covered.title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.trust.covered.body") %></p>
      <ul class="mt-5 space-y-3">
        <% t("content.trust.covered.items").each do |item| %>
          <li class="flex gap-3 text-sm text-slate-700 dark:text-zinc-300">
            <span class="mt-0.5 text-brand-600 dark:text-brand-400"><%= icon "check", class: "size-5" %></span>
            <span><%= item %></span>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="surface p-6">
      <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.trust.review.title") %></h3>
      <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.trust.review.body") %></p>
      <ul class="mt-4 space-y-2">
        <% t("content.trust.review.items").each do |item| %>
          <li class="flex gap-2 text-sm text-slate-600 dark:text-zinc-400">
            <span class="text-brand-600 dark:text-brand-400"><%= icon "check", class: "size-4" %></span>
            <span><%= item %></span>
          </li>
        <% end %>
      </ul>
      <p class="mt-4 rounded-lg bg-slate-50 p-3 text-xs leading-5 text-slate-500 dark:bg-zinc-800/60 dark:text-zinc-400"><%= t("content.trust.review.footnote") %></p>
    </div>
  </div>
</section>

<section class="page-container py-14 sm:py-16" aria-labelledby="trust-verified-title">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <div>
      <h2 id="trust-verified-title" class="section-heading"><%= t("content.trust.verified.title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.trust.verified.body") %></p>
      <div class="mt-5 rounded-xl border border-slate-200 p-4 dark:border-zinc-800">
        <p class="text-sm font-semibold text-slate-900 dark:text-white"><%= t("content.trust.verified.company_title") %></p>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-zinc-400"><%= t("content.trust.verified.company_body") %></p>
      </div>
    </div>
    <div class="surface p-6">
      <h3 class="font-heading text-lg font-semibold text-slate-950 dark:text-white"><%= t("content.trust.tips.title") %></h3>
      <ul class="mt-3 space-y-3">
        <% t("content.trust.tips.items").each do |item| %>
          <li class="flex gap-3 text-sm text-slate-700 dark:text-zinc-300">
            <span class="mt-0.5 text-accent-600 dark:text-accent-400"><%= icon "zap", class: "size-4" %></span>
            <span><%= item %></span>
          </li>
        <% end %>
      </ul>
      <%= link_to t("content.trust.tips.report"), help_article_path("spot-scams"),
                  class: "mt-4 inline-flex text-sm font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 dark:text-brand-300" %>
    </div>
  </div>
</section>

<section class="border-y border-slate-200 bg-white py-14 dark:border-zinc-800 dark:bg-zinc-900/30" aria-labelledby="trust-contact-title">
  <div class="page-container">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="trust-contact-title" class="section-heading"><%= t("content.trust.contact.title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= t("content.trust.contact.body") %></p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="surface p-5">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "message-circle", class: "size-5" %></span>
        <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= t("content.trust.contact.help_title") %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("content.trust.contact.help_body") %></p>
        <%= link_to t("content.trust.contact.help_cta"), help_articles_path, class: "mt-2 inline-flex text-xs font-semibold text-brand-700 dark:text-brand-300" %>
      </div>
      <div class="surface p-5">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "mail", class: "size-5" %></span>
        <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= t("content.trust.contact.email_title") %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("content.trust.contact.email_body") %></p>
        <%= mail_to Setting.get("support_email"), class: "mt-2 inline-flex text-xs font-semibold text-brand-700 dark:text-brand-300" %>
      </div>
      <div class="surface p-5">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "headset", class: "size-5" %></span>
        <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= t("content.trust.contact.phone_title") %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("content.trust.contact.phone_body") %></p>
        <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white"><%= Setting.get("support_phone") %></p>
      </div>
      <div class="surface p-5">
        <span class="text-brand-700 dark:text-brand-300"><%= icon "clock", class: "size-5" %></span>
        <h3 class="mt-3 text-sm font-semibold text-slate-900 dark:text-white"><%= t("content.trust.contact.hours_title") %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-zinc-400"><%= t("content.trust.contact.hours_body") %></p>
        <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white"><%= Setting.get("support_hours") %></p>
      </div>
    </div>
  </div>
</section>

<section class="page-container py-14 sm:py-16" aria-labelledby="trust-faq-title">
  <div class="mx-auto max-w-3xl">
    <h2 id="trust-faq-title" class="section-heading text-center"><%= t("content.trust.faq.title") %></h2>
    <p class="mt-3 text-center text-sm text-slate-600 dark:text-zinc-400"><%= t("content.trust.faq.body") %></p>
    <div class="mt-8 space-y-3">
      <% t("content.trust.faq.items").each do |item| %>
        <details class="group surface p-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-slate-900 dark:text-white">
            <%= item[:q] || item["q"] %>
            <span class="text-slate-400 transition group-open:rotate-180 dark:text-zinc-500"><%= icon "chevron-down", class: "size-4" %></span>
          </summary>
          <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-zinc-400"><%= item[:a] || item["a"] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<section class="page-container pb-16">
  <div class="rounded-2xl bg-slate-900 px-6 py-10 text-center dark:bg-zinc-900">
    <h2 class="font-heading text-2xl font-bold tracking-tight text-white"><%= t("content.trust.cta.title") %></h2>
    <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-slate-300"><%= t("content.trust.cta.body") %></p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <%= link_to t("content.trust.cta.browse"), search_path, class: ui_button_classes(variant: :accent, size: :md) %>
      <%= link_to t("content.trust.cta.sell"), new_listing_path, class: ui_button_classes(variant: :outline, size: :md) %>
    </div>
  </div>
</section>
