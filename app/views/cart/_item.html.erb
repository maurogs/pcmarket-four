<% listing = item.listing %>
<div id="cart-item-<%= listing.id %>" class="flex gap-4 px-5 py-4 <%= "opacity-70" unless item.available? %>">
  <%= link_to listing_path(listing), class: "shrink-0" do %>
    <div class="h-24 w-24 overflow-hidden rounded-lg bg-slate-100 sm:h-28 sm:w-28 dark:bg-zinc-800">
      <% if listing.images.attached? %>
        <%= image_tag listing.ordered_images.first.variant(resize_to_limit: [ 240, 240 ], format: :webp),
                      alt: t("listings.card.image_alt", title: listing.title),
                      width: 240, height: 240, loading: "lazy",
                      class: "h-full w-full object-cover" %>
      <% else %>
        <%= image_tag "listing-placeholder.svg", alt: "", class: "h-full w-full object-cover" %>
      <% end %>
    </div>
  <% end %>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <%= link_to listing.title, listing_path(listing),
                    class: "line-clamp-2 text-sm font-semibold text-slate-950 hover:text-brand-700 dark:text-white dark:hover:text-brand-300" %>
        <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-zinc-400">
          <span class="<%= ui_badge_classes(tone: listing_condition_tone(listing), extra: "!px-2 !py-0.5") %>">
            <%= listing_condition_label(listing) %>
          </span>
          <span><%= format_price(item.unit_price_cents) %></span>
        </p>
      </div>
      <span class="shrink-0 text-sm font-semibold text-slate-950 dark:text-white">
        <%= format_price(item.subtotal_cents) %>
      </span>
    </div>

    <% if item.warning? %>
      <p class="mt-2 rounded-lg bg-amber-50 px-2.5 py-2 text-xs font-medium text-amber-800 dark:bg-amber-500/10 dark:text-amber-300">
        <span><%= t(item.warning_key) %></span>
      </p>
    <% end %>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <% if item.available? && item.quantity.positive? && listing.quantity.to_i > 1 %>
        <div class="inline-flex items-center gap-1 rounded-full border border-slate-300 px-1 py-1 dark:border-zinc-700">
          <%= button_to "−", cart_item_path(item.cart_item, quantity: item.quantity - 1),
                        method: :patch, form: { data: { turbo_stream: true } },
                        disabled: item.quantity <= 1,
                        class: "inline-flex size-7 items-center justify-center rounded-full text-base font-semibold text-slate-700 transition hover:bg-slate-100 disabled:opacity-40 dark:text-zinc-200 dark:hover:bg-zinc-800",
                        aria: { label: t("cart.decrease") } %>
          <span class="min-w-7 text-center text-sm font-semibold text-slate-950 dark:text-white" aria-live="polite">
            <%= item.quantity %>
          </span>
          <%= button_to "+", cart_item_path(item.cart_item, quantity: item.quantity + 1),
                        method: :patch, form: { data: { turbo_stream: true } },
                        disabled: item.quantity >= listing.quantity.to_i,
                        class: "inline-flex size-7 items-center justify-center rounded-full text-base font-semibold text-slate-700 transition hover:bg-slate-100 disabled:opacity-40 dark:text-zinc-200 dark:hover:bg-zinc-800",
                        aria: { label: t("cart.increase") } %>
        </div>
      <% else %>
        <span class="text-xs text-slate-500 dark:text-zinc-400">
          <%= t("cart.quantity_value", count: item.quantity) %>
        </span>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <% if user_signed_in? %>
          <%= button_to t("cart.save_to_favourites"), cart_item_favorite_path(item.cart_item),
                        method: :post, form: { data: { turbo_stream: true } },
                        class: "text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
        <% end %>
        <%= button_to t("cart.remove"), cart_item_path(item.cart_item),
                      method: :delete, form: { data: { turbo_stream: true } },
                      class: "text-xs font-semibold text-rose-600 hover:underline dark:text-rose-400" %>
      </div>
    </div>
  </div>
</div>
