<% listing = item.listing %>
<div id="cart-item-<%= listing.id %>" class="surface flex gap-4 p-4">
  <%= link_to listing_path(listing), class: "shrink-0" do %>
    <div class="h-24 w-24 overflow-hidden rounded-lg bg-slate-100 sm:h-28 sm:w-28 dark:bg-zinc-800">
      <% if listing.images.attached? %>
        <%= image_tag listing.images.first.variant(resize_to_limit: [ 240, 240 ], format: :webp),
                      alt: t("listings.card.image_alt", title: listing.title),
                      width: 240, height: 240, loading: "lazy",
                      class: "h-full w-full object-cover" %>
      <% else %>
        <%= image_tag "listing-placeholder.svg", alt: "", class: "h-full w-full object-cover" %>
      <% end %>
    </div>
  <% end %>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <%= link_to listing.title, listing_path(listing),
                    class: "line-clamp-2 text-sm font-semibold text-slate-950 hover:text-brand-700 dark:text-white dark:hover:text-brand-300" %>
        <p class="mt-1 text-xs text-slate-500 dark:text-zinc-400">
          <%= listing_seller_name(listing) %> · <%= listing_location(listing) %>
        </p>
      </div>
      <span class="shrink-0 text-sm font-semibold text-slate-950 dark:text-white">
        <%= format_price(listing.price_cents) %>
      </span>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <%= form_with url: cart_item_path(item), method: :patch, class: "flex items-center gap-2" do %>
        <label for="quantity-<%= item.id %>" class="text-xs text-slate-500 dark:text-zinc-400">
          <%= t("cart.quantity") %>
        </label>
        <%= number_field_tag :quantity, item.quantity, min: 1, max: listing.quantity,
                             id: "quantity-#{item.id}",
                             class: ui_input_classes("!min-h-9 !w-20 !rounded-full text-sm") %>
        <%= submit_tag t("cart.update"), class: ui_button_classes(variant: :outline, size: :sm) %>
      <% end %>

      <%= button_to cart_item_path(item), method: :delete,
                    form: { data: { turbo_stream: true } },
                    class: "text-xs font-semibold text-rose-600 hover:underline dark:text-rose-400" do %>
        <%= t("cart.remove") %>
      <% end %>
    </div>
  </div>
</div>
