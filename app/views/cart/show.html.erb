<% content_for :title, t("cart.title") %>

<div class="page-container py-8 sm:py-10">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-heading text-3xl font-bold tracking-tight text-slate-950 dark:text-white"><%= t("cart.title") %></h1>
      <p class="mt-1 text-sm text-slate-600 dark:text-zinc-400"><%= t("cart.subtitle") %></p>
    </div>
    <span class="<%= ui_badge_classes(tone: :brand) %>">
      <%= t("cart.item_count", count: @summary.item_count) %>
    </span>
  </div>

  <% if @summary.empty? %>
    <div class="mt-8"><%= render "cart/groups", summary: @summary %></div>
  <% else %>
    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="space-y-8">
        <%= render "cart/groups", summary: @summary %>

        <% if @recommended.any? %>
          <section aria-labelledby="cart-recommended">
            <div class="flex items-center justify-between gap-3">
              <h2 id="cart-recommended" class="font-heading text-xl font-semibold text-slate-950 dark:text-white">
                <%= t("cart.recommended.title") %>
              </h2>
              <%= link_to t("cart.recommended.view_all"), listings_path,
                          class: "text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300" %>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3">
              <% @recommended.each do |listing| %>
                <%= render "listings/card", listing: listing %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <%= render "cart/summary", summary: @summary %>
    </div>
  <% end %>
</div>
