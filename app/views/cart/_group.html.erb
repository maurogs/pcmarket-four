<% store = group.store %>
<div id="cart-group-<%= group.seller.id %>" class="surface overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-5 py-4 dark:border-zinc-800">
    <div class="flex min-w-0 items-center gap-2">
      <%= icon "store", class: "size-4 shrink-0 text-brand-600 dark:text-brand-400" %>
      <% if store.present? %>
        <%= link_to group.store_name, store_path(store),
                    class: "truncate font-heading text-base font-semibold text-slate-950 hover:text-brand-700 dark:text-white dark:hover:text-brand-300" %>
      <% else %>
        <span class="truncate font-heading text-base font-semibold text-slate-950 dark:text-white"><%= group.store_name %></span>
      <% end %>
    </div>
    <span class="<%= ui_badge_classes(tone: :neutral) %>">
      <%= t("cart.group_items", count: group.item_count) %>
    </span>
  </div>

  <div class="divide-y divide-slate-100 dark:divide-zinc-800">
    <% group.items.each do |item| %>
      <%= render "cart/item", item: item %>
    <% end %>
  </div>

  <div class="space-y-1.5 border-t border-slate-200 bg-slate-50/70 px-5 py-4 text-sm dark:border-zinc-800 dark:bg-zinc-900/40">
    <div class="flex items-center justify-between gap-4">
      <span class="text-slate-600 dark:text-zinc-400"><%= t("cart.group_shipping") %></span>
      <span class="font-medium text-slate-900 dark:text-zinc-100">
        <% if group.pickup_only %>
          <%= t("cart.local_pickup_only") %>
        <% elsif group.free_shipping? %>
          <%= t("cart.free_shipping") %>
        <% else %>
          <%= format_price(group.shipping_cents) %>
        <% end %>
      </span>
    </div>
    <div class="flex items-center justify-between gap-4">
      <span class="font-semibold text-slate-900 dark:text-zinc-100"><%= t("cart.group_subtotal") %></span>
      <span class="font-heading text-base font-bold text-slate-950 dark:text-white"><%= format_price(group.subtotal_cents) %></span>
    </div>
  </div>
</div>
